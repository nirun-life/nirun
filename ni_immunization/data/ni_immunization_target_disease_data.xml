<odoo noupdate="1">
    <data>
        <record id="disease_tb" model="ni.immunization.target.disease">
            <field name="name">Tuberculosis</field>
            <field name="abbr">TB</field>
            <field name="code">56717001</field>
            <field name="series_doses">1</field>
            <field name="definition">BCG vaccine; single dose given at birth.</field>
        </record>
        <record id="disease_hbv" model="ni.immunization.target.disease">
            <field name="name">Hepatitis B</field>
            <field name="abbr">HBV</field>
            <field name="code">66071002</field>
            <field name="series_doses">3</field>
            <field name="definition">3-dose series at 0, 1, and 6 months.</field>
        </record>
        <record id="disease_hav" model="ni.immunization.target.disease">
            <field name="name">Hepatitis A</field>
            <field name="abbr">HAV</field>
            <field name="code">40468003</field>
            <field name="series_doses">2</field>
            <field name="definition">2-dose series at 0 and 6 months.</field>
        </record>
        <record id="disease_diphtheria" model="ni.immunization.target.disease">
            <field name="name">Diphtheria</field>
            <field name="code">397430003</field>
            <field name="series_doses">5</field>
            <field name="definition">Given as DTP combination; 3 primary doses + 2 boosters.</field>
        </record>
        <record id="disease_tetanus" model="ni.immunization.target.disease">
            <field name="name">Tetanus</field>
            <field name="code">76902006</field>
            <field name="series_doses">5</field>
            <field name="definition">Given as DTP combination; 3 primary doses + 2 boosters.</field>
        </record>
        <record id="disease_pertussis" model="ni.immunization.target.disease">
            <field name="name">Pertussis</field>
            <field name="code">27836007</field>
            <field name="series_doses">5</field>
            <field name="definition">Given as DTP combination; 3 primary doses + 2 boosters.</field>
        </record>
        <record id="disease_polio" model="ni.immunization.target.disease">
            <field name="name">Poliomyelitis</field>
            <field name="abbr">Polio</field>
            <field name="code">398102009</field>
            <field name="series_doses">4</field>
            <field name="definition">4-dose OPV/IPV combined schedule (2, 4, 6 months + booster at 18 months).</field>
        </record>
        <record id="disease_measles" model="ni.immunization.target.disease">
            <field name="name">Measles</field>
            <field name="code">14189004</field>
            <field name="series_doses">2</field>
            <field name="definition">Given as MMR; 2 doses at 9 months and 18 months.</field>
        </record>
        <record id="disease_mumps" model="ni.immunization.target.disease">
            <field name="name">Mumps</field>
            <field name="code">36989005</field>
            <field name="series_doses">2</field>
            <field name="definition">Given as MMR; 2 doses at 9 months and 18 months.</field>
        </record>
        <record id="disease_rubella" model="ni.immunization.target.disease">
            <field name="name">Rubella</field>
            <field name="code">36653000</field>
            <field name="series_doses">2</field>
            <field name="definition">Given as MMR; 2 doses at 9 months and 18 months.</field>
        </record>
        <record id="disease_varicella" model="ni.immunization.target.disease">
            <field name="name">Varicella</field>
            <field name="abbr">VZV</field>
            <field name="code">38907003</field>
            <field name="series_doses">2</field>
            <field name="definition">2-dose series; some schedules use a single dose for younger children.</field>
        </record>
        <record id="disease_influenza" model="ni.immunization.target.disease">
            <field name="name">Influenza</field>
            <field name="code">6142004</field>
            <field name="series_doses">1</field>
            <field name="definition">
                Annual single dose; children under 9 receiving it for the first time require 2 doses.
            </field>
        </record>
        <record id="disease_hpv" model="ni.immunization.target.disease">
            <field name="name">Human Papillomavirus</field>
            <field name="abbr">HPV</field>
            <field name="code">240532009</field>
            <field name="series_doses">3</field>
            <field name="definition">3-dose series (0, 1–2, 6 months); 2 doses suffice for ages 9–14.</field>
        </record>
        <record id="disease_covid19" model="ni.immunization.target.disease">
            <field name="name">COVID-19</field>
            <field name="code">840539006</field>
            <field name="series_doses">2</field>
            <field name="definition">2-dose primary series; additional booster doses may be recommended.</field>
        </record>
        <record id="disease_japanese_encephalitis" model="ni.immunization.target.disease">
            <field name="name">Japanese Encephalitis</field>
            <field name="abbr">JE</field>
            <field name="code">52947006</field>
            <field name="series_doses">2</field>
            <field name="definition">
                Inactivated vaccine (e.g. Ixiaro): 2 doses. Live attenuated (IMOJEV): single dose.
            </field>
        </record>
        <record id="disease_rabies" model="ni.immunization.target.disease">
            <field name="name">Rabies</field>
            <field name="code">14168008</field>
            <field name="series_doses">3</field>
            <field name="definition">
                Pre-exposure: 3 doses (days 0, 7, 21/28). Post-exposure: 4–5 doses depending on protocol.
            </field>
        </record>
    </data>
</odoo>
