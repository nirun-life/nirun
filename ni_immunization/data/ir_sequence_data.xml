<odoo noupdate="1">
    <data>
        <record id="ir_seq_immunization" model="ir.sequence">
            <field name="name">Immunization Sequence</field>
            <field name="code">ni.immunization</field>
            <field name="prefix">IMM-%(range_year)s</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
            <field name="use_date_range" eval="True" />
        </record>
        <record id="ir_seq_immunization_evaluation" model="ir.sequence">
            <field name="name">Immunization Evaluation Sequence</field>
            <field name="code">ni.immunization.evaluation</field>
            <field name="prefix">IME-%(range_year)s</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
            <field name="use_date_range" eval="True" />
        </record>
    </data>
</odoo>
