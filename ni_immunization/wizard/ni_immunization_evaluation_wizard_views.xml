<odoo>
    <record id="ni_immunization_evaluation_wizard_view_form" model="ir.ui.view">
        <field name="name">ni.immunization.evaluation.wizard.view.form</field>
        <field name="model">ni.immunization.evaluation.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Immunization Doses">
                <field name="encounter_id" invisible="1" />
                <field name="patient_id" invisible="1" />
                <field name="immunization_id" invisible="1" />
                <field name="state" invisible="1" />
                <field name="available_disease_ids" invisible="1" />
                <group invisible="state != '1'" string="Select diseases to record dose">
                    <label for="disease_ids" />
                    <div>
                        <field
                            name="filter_status"
                            widget="radio"
                            options="{'horizontal': True}"
                        />
                        <field
                            name="disease_ids"
                            widget="many2many_checkboxes"
                            domain="[('id', 'in', available_disease_ids)]"
                        />
                    </div>
                </group>
                <separator invisible="state != '2'" string="Fill-in dose information" />
                <field name="line_ids" invisible="state != '2'">
                    <list editable="bottom" create="false" delete="false">
                        <field name="target_disease_id" readonly="1" />
                        <field name="series_doses" readonly="1" />
                        <field name="dose_number" />
                        <field
                            name="occurrence"
                            placeholder="optional"
                            column_invisible="parent.immunization_id"
                        />
                    </list>
                    <form>
                        <group>
                            <field name="target_disease_id" readonly="1" />
                            <label for="dose_number" />
                            <div class="o_row">
                                <field name="dose_number" class="o_narrow_field" />
                                <span class="small">
                                    /
                                    <field name="series_doses" readonly="1" />
                                </span>
                            </div>
                            <field name="occurrence" placeholder="optional" />
                        </group>
                    </form>
                    <kanban create="false" delete="false">
                        <templates>
                            <t t-name="card">
                                <field name="target_disease_id" class="fw-bolder" />
                                <div class="mt-1">
                                    <i class="fa fa-eyedropper me-1" title="Dose" />
                                    <field name="dose_number" />
                                    <span>/</span>
                                    <field name="series_doses" />
                                </div>
                                <div
                                    t-if="record.occurrence.value"
                                    class="mt-1 text-muted"
                                >
                                    <i class="fa fa-calendar me-1" title="Occurrence" />
                                    <field name="occurrence" />
                                </div>
                                <div t-else="" class="mt-1 text-warning">
                                    <i
                                        class="fa fa-exclamation-circle me-1"
                                        title="Date not set"
                                    />
                                    <span>Date not set</span>
                                </div>
                            </t>
                        </templates>
                    </kanban>
                </field>
                <footer>
                    <button
                        name="action_next"
                        type="object"
                        string="Next"
                        class="btn-primary"
                        invisible="state != '1'"
                    />
                    <button
                        name="action_apply"
                        type="object"
                        string="Save"
                        class="btn-primary"
                        invisible="state != '2'"
                    />
                    <button
                        name="action_back"
                        type="object"
                        string="Back"
                        invisible="state != '2'"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
