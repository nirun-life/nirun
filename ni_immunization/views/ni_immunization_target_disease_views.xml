<odoo>
    <record id="ni_immunization_target_disease_action" model="ir.actions.act_window">
        <field name="name">Target Diseases</field>
        <field name="res_model">ni.immunization.target.disease</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="ni_immunization_target_disease_view_tree" model="ir.ui.view">
        <field name="name">ni.immunization.target.disease.view.tree</field>
        <field name="model">ni.immunization.target.disease</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="code" optional="show" />
                <field name="name" />
                <field name="abbr" optional="show" />
                <field name="vaccine_ids" widget="many2many_tags" />
                <field name="active" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="ni_immunization_target_disease_view_form" model="ir.ui.view">
        <field name="name">ni.immunization.target.disease.view.form</field>
        <field name="model">ni.immunization.target.disease</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="abbr" />
                            <field name="code" />
                        </group>
                        <group>
                            <field name="series_doses" />
                            <field name="system_id" options="{'no_open': True}" />
                        </group>
                    </group>
                    <field name="definition" placeholder="Description..." />
                    <notebook>
                        <page name="vaccine" string="Vaccine">
                            <field name="vaccine_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
