<odoo>
    <record id="ni_immunization_route_action" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">ni.immunization.route</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="ni_immunization_route_view_tree" model="ir.ui.view">
        <field name="name">ni.immunization.route.view.tree</field>
        <field name="model">ni.immunization.route</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="code" optional="show" />
                <field name="name" />
                <field name="abbr" optional="show" />
                <field name="active" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="ni_immunization_route_view_form" model="ir.ui.view">
        <field name="name">ni.immunization.route.view.form</field>
        <field name="model">ni.immunization.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="abbr" />
                            <field name="code" />
                        </group>
                        <group>
                            <field name="system_id" options="{'no_open': True}" />
                            <field name="active" />
                        </group>
                    </group>
                    <field
                        name="site_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                        placeholder="Select injection sites..."
                    />
                    <field name="definition" placeholder="Description..." />
                </sheet>
            </form>
        </field>
    </record>
</odoo>
