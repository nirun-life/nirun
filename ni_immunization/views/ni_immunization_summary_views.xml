<odoo>
    <record id="ni_immunization_summary_view_tree" model="ir.ui.view">
        <field name="name">ni.immunization.summary.view.tree</field>
        <field name="model">ni.immunization.summary</field>
        <field name="arch" type="xml">
            <tree
                decoration-success="protection_status == 'protected'"
                decoration-warning="protection_status == 'partial'"
                decoration-danger="protection_status == 'not-protected'"
                create="false"
                edit="false"
                delete="false"
            >
                <field name="target_disease_id" string="Disease" />
                <field
                    name="protection_status"
                    widget="badge"
                    decoration-success="protection_status == 'protected'"
                    decoration-warning="protection_status == 'partial'"
                    decoration-danger="protection_status == 'not-protected'"
                />
                <field name="last_occurrence" string="Last Dose" />
                <field name="dose_progress" string="Doses" />
                <button name="action_add_evaluation" type="object" string="Add Dose" icon="fa-plus" class="btn-sm" />
            </tree>
        </field>
    </record>
    <record id="ni_immunization_summary_view_kanban" model="ir.ui.view">
        <field name="name">ni.immunization.summary.view.kanban</field>
        <field name="model">ni.immunization.summary</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false">
                <field name="target_disease_id" />
                <field name="protection_status" />
                <field name="last_occurrence" />
                <field name="dose_progress" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_card oe_kanban_global_click
                                #{record.protection_status.raw_value == 'protected' ? 'border-success' : ''}
                                #{record.protection_status.raw_value == 'partial' ? 'border-warning' : ''}
                                #{record.protection_status.raw_value == 'not-protected' ? 'border-danger' : ''}"
                        >
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="target_disease_id" />
                                </strong>
                                <div class="mt-1">
                                    <field
                                        name="protection_status"
                                        widget="badge"
                                        decoration-success="protection_status == 'protected'"
                                        decoration-warning="protection_status == 'partial'"
                                        decoration-danger="protection_status == 'not-protected'"
                                    />
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left text-muted">
                                        <span t-if="record.last_occurrence.value">
                                            <i class="fa fa-calendar me-1" />
                                            <field name="last_occurrence" />
                                        </span>
                                        <span class="ms-2">
                                            <i class="fa fa-syringe me-1" />
                                            <field name="dose_progress" />
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <button
                                            name="action_add_evaluation"
                                            type="object"
                                            class="btn btn-sm btn-primary"
                                            title="Add Dose"
                                        >
                                            <i class="fa fa-plus" />
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_immunization_summary_view_search" model="ir.ui.view">
        <field name="name">ni.immunization.summary.view.search</field>
        <field name="model">ni.immunization.summary</field>
        <field name="arch" type="xml">
            <search>
                <filter name="protected" string="Protected" domain="[('protection_status', '=', 'protected')]" />
                <filter name="partial" string="Partial" domain="[('protection_status', '=', 'partial')]" />
                <filter
                    name="not_protected"
                    string="Not Protected"
                    domain="[('protection_status', '=', 'not-protected')]"
                />
            </search>
        </field>
    </record>
</odoo>
