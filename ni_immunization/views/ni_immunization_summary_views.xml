<odoo>
    <record id="ni_immunization_summary_view_tree" model="ir.ui.view">
        <field name="name">ni.immunization.summary.view.list</field>
        <field name="model">ni.immunization.summary</field>
        <field name="arch" type="xml">
            <list
                decoration-success="protection_status == 'protected'"
                decoration-warning="protection_status == 'partial'"
                decoration-danger="protection_status == 'not-protected'"
                create="false"
                edit="false"
                delete="false"
            >
                <field name="target_disease_id" string="Disease" />
                <field
                    name="protection_status"
                    widget="badge"
                    decoration-success="protection_status == 'protected'"
                    decoration-warning="protection_status == 'partial'"
                    decoration-danger="protection_status == 'not-protected'"
                />
                <field name="last_immunization" string="Last Dose" />
                <field
                    name="last_evaluation"
                    string="Last Evaluation"
                    optional="hide"
                />
                <field name="dose_progress" string="Doses" />
                <button
                    name="action_add_evaluation"
                    type="object"
                    string="Add Dose"
                    icon="fa-plus"
                    class="btn-sm"
                />
            </list>
        </field>
    </record>
    <record id="ni_immunization_summary_view_form" model="ir.ui.view">
        <field name="name">ni.immunization.summary.view.form</field>
        <field name="model">ni.immunization.summary</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header />
                <sheet>
                    <div class="oe_title mb-4">
                        <span>
                            <field class="h2 oe_inline" name="target_disease_id" />
                            <field
                                name="protection_status"
                                class="mx-3"
                                widget="badge"
                                decoration-success="protection_status == 'protected'"
                                decoration-warning="protection_status == 'partial'"
                                decoration-danger="protection_status == 'not-protected'"
                            />
                        </span>
                    </div>
                    <group>
                        <field name="dose_progress" string="Doses" />
                        <field name="last_immunization" />
                        <label for="last_evaluation" />
                        <div class="o_row">
                            <field name="last_evaluation" />
                            <button
                                name="action_add_evaluation"
                                type="object"
                                string="Add Dose"
                                class="btn-primary"
                                icon="fa-plus"
                            />
                        </div>
                    </group>
                    <notebook>
                        <page name="history" string="History" icon="fa-history">
                            <field name="evaluation_ids" readonly="1">
                                <list
                                    decoration-success="protection_status == 'protected'"
                                    decoration-warning="protection_status == 'partial'"
                                    decoration-danger="protection_status == 'not-protected'"
                                    create="false"
                                    edit="false"
                                    delete="false"
                                >
                                    <field name="immunization_date" />
                                    <field name="occurrence" optional="hide" />
                                    <field name="dose_number" string="Dose #" />
                                    <field name="series_doses" string="Required" />
                                    <field name="dose_status" optional="show" />
                                    <field
                                        name="protection_status"
                                        widget="badge"
                                        decoration-success="protection_status == 'protected'"
                                        decoration-warning="protection_status == 'partial'"
                                        decoration-danger="protection_status == 'not-protected'"
                                        optional="show"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_immunization_summary_view_kanban" model="ir.ui.view">
        <field name="name">ni.immunization.summary.view.kanban</field>
        <field name="model">ni.immunization.summary</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false">
                <field name="protection_status" />
                <field name="patient_id" />
                <templates>
                    <t t-name="card">
                        <div
                            t-attf-class="border-start border-3 ps-2 #{record.protection_status.raw_value == 'protected' ? 'border-success' : ''} #{record.protection_status.raw_value == 'partial' ? 'border-warning' : ''} #{record.protection_status.raw_value == 'not-protected' ? 'border-danger' : ''}"
                        >
                            <div class="fw-bolder">
                                <field name="target_disease_id" />
                                <i
                                    title="Protection status"
                                    t-attf-class="fa fa-shield ms-2 #{record.protection_status.raw_value == 'protected' ? 'text-success' : ''} #{record.protection_status.raw_value == 'partial' ? 'text-warning' : ''} #{record.protection_status.raw_value == 'not-protected' ? 'text-danger' : ''}"
                                />
                            </div>
                            <footer class="mt-2">
                                <div class="text-muted">
                                    <span class="me-3">
                                        <i
                                            class="fa fa-eyedropper me-1"
                                            title="Doses"
                                        />
                                        <field name="dose_progress" />
                                    </span>
                                    <span
                                        class="me-3"
                                        t-if="record.last_immunization.value"
                                    >
                                        <i
                                            class="fa fa-calendar me-1"
                                            title="Last immunization"
                                        />
                                        <field name="last_immunization" />
                                    </span>
                                </div>
                                <button
                                    name="action_add_evaluation"
                                    type="object"
                                    icon="fa-plus"
                                    title="Add Dose"
                                    class="btn btn-sm btn-secondary ms-auto"
                                />
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_immunization_summary_view_search" model="ir.ui.view">
        <field name="name">ni.immunization.summary.view.search</field>
        <field name="model">ni.immunization.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id" />
                <field name="target_disease_id" />
                <filter
                    name="protected"
                    string="Protected"
                    domain="[('protection_status', '=', 'protected')]"
                />
                <filter
                    name="partial"
                    string="Partial"
                    domain="[('protection_status', '=', 'partial')]"
                />
                <filter
                    name="not_protected"
                    string="Not Protected"
                    domain="[('protection_status', '=', 'not-protected')]"
                />
            </search>
        </field>
    </record>
</odoo>
