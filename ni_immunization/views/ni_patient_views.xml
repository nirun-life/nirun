<odoo>
    <record id="ni_patient_view_form_inherit" model="ir.ui.view">
        <field name="name">ni.patient.view.form.inherit.immunization</field>
        <field name="model">ni.patient</field>
        <field name="inherit_id" ref="ni_patient.ni_patient_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_immunization_evaluation" class="oe_stat_button" icon="fa-shield" type="object">
                    <field name="protected_disease_count" string="Protected" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
