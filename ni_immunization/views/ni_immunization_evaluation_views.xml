<odoo>
    <record id="ni_immunization_evaluation_action" model="ir.actions.act_window">
        <field name="name">Immunization Evaluation</field>
        <field name="res_model">ni.immunization.evaluation</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_by_disease': 1}</field>
    </record>
    <record id="ni_immunization_evaluation_view_search" model="ir.ui.view">
        <field name="name">ni.immunization.evaluation.view.search</field>
        <field name="model">ni.immunization.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id" />
                <field name="target_disease_id" />
                <filter name="occurrence" date="occurrence" />
                <filter name="valid" string="Valid" domain="[('dose_status', '=', 'valid')]" />
                <filter name="not_valid" string="Not Valid" domain="[('dose_status', '=', 'not-valid')]" />
                <separator />
                <filter name="protected" string="Protected" domain="[('protection_status', '=', 'protected')]" />
                <filter name="partial" string="Partial" domain="[('protection_status', '=', 'partial')]" />
                <filter
                    name="not_protected"
                    string="Not Protected"
                    domain="[('protection_status', '=', 'not-protected')]"
                />
                <separator />
                <group>
                    <filter name="group_by_disease" string="Disease" context="{'group_by': 'target_disease_id'}" />
                    <filter name="group_occurrence" context="{'group_by': 'occurrence'}" />
                    <filter name="group_by_patient" string="Patient" context="{'group_by': 'patient_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="ni_immunization_evaluation_view_quick_create" model="ir.ui.view">
        <field name="name">ni.immunization.evaluation.view.quick.create</field>
        <field name="model">ni.immunization.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <field
                    name="target_disease_id"
                    placeholder="Select disease..."
                    options="{'no_create': True, 'no_open':True}"
                />
                <label for="occurrence" />
                <field name="occurrence" placeholder="Immunization Date" />
                <label for="dose_number" />
                <div class="o_row">
                    <field name="dose_number" />
                    <span>/</span>
                    <field name="series_doses" readonly="1" force_save="1" />
                </div>
            </form>
        </field>
    </record>
    <record id="ni_immunization_evaluation_view_kanban" model="ir.ui.view">
        <field name="name">ni.immunization.evaluation.view.kanban</field>
        <field name="model">ni.immunization.evaluation</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="target_disease_id"
                quick_create_view="ni_immunization.ni_immunization_evaluation_view_quick_create"
                expand="1"
            >
                <field name="target_disease_id" />
                <field name="dose_number" />
                <field name="series_doses" />
                <field name="dose_status" />
                <field name="protection_status" />
                <field name="occurrence" />
                <field name="immunization_id" />
                <field name="patient_id" />
                <progressbar field="dose_status" colors='{"valid": "success", "not-valid": "danger"}' />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="patient_id" />
                                            <span>
                                                Dose #
                                                <field name="dose_number" />
                                            </span>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field
                                            name="protection_status"
                                            widget="label_selection"
                                            options="{
                                                'classes': {
                                                    'protected': 'success',
                                                    'partial': 'warning',
                                                    'not-protected': 'danger'
                                                }
                                            }"
                                        />
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <t t-if="record.occurrence.raw_value">
                                        <span class="text-muted">
                                            <field name="occurrence" />
                                        </span>
                                    </t>
                                    <div>
                                        Dose
                                        <field name="dose_number" class="oe_inline" />
                                        /
                                        <field name="series_doses" class="oe_inline" />
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field
                                            name="dose_status"
                                            widget="label_selection"
                                            options="{
                                                'classes': {
                                                    'valid': 'success',
                                                    'not-valid': 'danger'
                                                }
                                            }"
                                        />
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <t t-if="record.immunization_id.raw_value">
                                            <field name="immunization_id" />
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_immunization_evaluation_view_tree" model="ir.ui.view">
        <field name="name">ni.immunization.evaluation.view.tree</field>
        <field name="model">ni.immunization.evaluation</field>
        <field name="arch" type="xml">
            <tree
                decoration-success="protection_status == 'protected'"
                decoration-warning="protection_status == 'partial'"
                decoration-muted="protection_status == 'not-protected'"
            >
                <field name="patient_id" invisible="1" />
                <field name="target_disease_id" />
                <field name="date" />
                <field name="immunization_id" optional="show" />
                <field name="series" optional="hide" />
                <field name="dose_number" string="Dose" />
                <field name="series_doses" string="Required" />
                <field
                    name="dose_status"
                    widget="badge"
                    decoration-success="dose_status == 'valid'"
                    decoration-danger="dose_status == 'not-valid'"
                    optional="show"
                />
                <field
                    name="protection_status"
                    widget="badge"
                    decoration-success="protection_status == 'protected'"
                    decoration-warning="protection_status == 'partial'"
                    decoration-danger="protection_status == 'not-protected'"
                />
                <groupby name="target_disease_id">
                    <field name="abbr" />
                    <button type="object" name="action_evaluation" icon="fa-plus" title="New Evaluation" string="New" />
                </groupby>
                <control>
                    <create string="Add evaluation" />
                </control>
            </tree>
        </field>
    </record>
    <record id="ni_immunization_evaluation_view_form" model="ir.ui.view">
        <field name="name">ni.immunization.evaluation.view.form</field>
        <field name="model">ni.immunization.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field
                            name="patient_id"
                            invisible="context.get('default_patient_id')"
                            options="{'no_open': True}"
                            context="{'show_identifier': True}"
                            widget="many2one_avatar"
                            placeholder="Select patient..."
                        />
                        <field name="encounter_id" invisible="1" />
                    </group>
                    <field name="vaccine_target_disease_ids" invisible="1" />
                    <group>
                        <group>
                            <label for="target_disease_id" />
                            <div>
                                <field
                                    name="target_disease_id"
                                    placeholder="Select disease..."
                                    readonly="context.get('default_target_disease_id')"
                                    domain="vaccine_target_disease_ids and [('id', 'in', vaccine_target_disease_ids)] or []"
                                />
                                <field
                                    name="target_disease_definition"
                                    nolabel="1"
                                    readonly="1"
                                    class="text-muted fst-italic"
                                    attrs="{'invisible': [('target_disease_definition', '=', False)]}"
                                />
                            </div>
                            <field name="occurrence" />
                        </group>
                        <group>
                            <field name="dose_status" widget="radio" options="{'horizontal': True}" />
                            <field
                                name="dose_status_reason"
                                placeholder="Reason for invalid dose..."
                                attrs="{'invisible': [('dose_status', '!=', 'not-valid')]}"
                            />
                            <label for="dose_number" />
                            <div>
                                <field name="dose_number" class="oe_inline" />
                                <span class="mx-1">/</span>
                                <field name="series_doses" class="oe_inline" />
                            </div>
                            <field
                                name="protection_status"
                                widget="badge"
                                decoration-success="protection_status == 'protected'"
                                decoration-warning="protection_status == 'partial'"
                                decoration-danger="protection_status == 'not-protected'"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" icon="fa-pencil-square">
                            <field name="description" placeholder="Notes..." nolabel="1" />
                            <group>
                                <group>
                                    <field name="date" />
                                    <field name="series" placeholder="e.g. Primary Series" />
                                </group>
                                <group>
                                    <field
                                        name="immunization_id"
                                        options="{'no_open': True}"
                                        invisible="context.get('default_immunization_id')"
                                        context="{'show_identifier': True, 'default_patient_id': patient_id, 'default_encounter_id': encounter_id}"
                                        placeholder="Select immunization dose..."
                                    />
                                    <field
                                        name="create_uid"
                                        widget="many2one_avatar_user"
                                        attrs="{'invisible': [('id', '=', False)]}"
                                    />
                                </group>
                            </group>
                        </page>
                        <page string="History" icon="fa-history" attrs="{'invisible': [('history_ids', '=', [])]}">
                            <field name="history_ids" readonly="1" nolabel="1">
                                <tree
                                    decoration-success="protection_status == 'protected'"
                                    decoration-warning="protection_status == 'partial'"
                                    decoration-muted="protection_status == 'not-protected'"
                                >
                                    <field name="date" />
                                    <field name="dose_number" string="Dose" />
                                    <field name="series_doses" string="Required" />
                                    <field
                                        name="dose_status"
                                        widget="badge"
                                        decoration-success="dose_status == 'valid'"
                                    />
                                    <field
                                        name="protection_status"
                                        widget="badge"
                                        decoration-success="protection_status == 'protected'"
                                        decoration-warning="protection_status == 'partial'"
                                        decoration-danger="protection_status == 'not-protected'"
                                    />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
