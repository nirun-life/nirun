<odoo>
    <record id="ni_immunization_action" model="ir.actions.act_window">
        <field name="name">Immunization</field>
        <field name="res_model">ni.immunization</field>
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
    </record>
    <record id="ni_immunization_view_search" model="ir.ui.view">
        <field name="name">ni.immunization.view.search</field>
        <field name="model">ni.immunization</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id" />
                <field name="vaccine_id" />
                <filter
                    name="occurrence_today"
                    string="Today"
                    domain="[
                    ('occurrence', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')),
                    ('occurrence', '&lt;=', datetime.datetime.now().strftime('%Y-%m-%d 23:59:59'))
                    ]"
                />
                <filter name="occurrence" string="Occurrence" date="occurrence" />
                <separator />
                <group string="Group By">
                    <filter name="group_by_patient" string="Patient" context="{'group_by': 'patient_id'}" />
                    <filter name="group_by_encounter" string="Encounter" context="{'group_by': 'encounter_id'}" />
                    <separator />
                    <filter name="group_by_vaccine" string="Vaccine" context="{'group_by': 'vaccine_id'}" />
                    <filter name="group_by_route" string="Route" context="{'group_by': 'route_id'}" />
                </group>
                <searchpanel>
                    <field name="company_id" groups="base.group_multi_company" icon="fa-building" />
                    <field name="route_id" enable_counters="1" />
                    <field name="performer_id" enable_counters="1" icon="fa-user" />
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="ni_immunization_view_graph" model="ir.ui.view">
        <field name="name">ni.immunization.view.graph</field>
        <field name="model">ni.immunization</field>
        <field name="arch" type="xml">
            <graph stacked="False" type="bar">
                <field name="occurrence" interval="month" />
                <field name="vaccine_id" type="row" />
            </graph>
        </field>
    </record>
    <record id="ni_immunization_view_pivot" model="ir.ui.view">
        <field name="name">ni.immunization.view.pivot</field>
        <field name="model">ni.immunization</field>
        <field name="arch" type="xml">
            <pivot default_order="patient_id, occurrence DESC">
                <field name="occurrence" interval="month" type="col" />
                <field name="patient_id" type="row" />
                <field name="vaccine_id" type="row" />
            </pivot>
        </field>
    </record>
    <record id="ni_immunization_view_tree" model="ir.ui.view">
        <field name="name">ni.immunization.view.tree</field>
        <field name="model">ni.immunization</field>
        <field name="arch" type="xml">
            <tree
                decoration-info="state in ['preparation', 'suspended']"
                decoration-muted="state in ['not-done', 'abort']"
            >
                <field name="identifier" optional="hide" />
                <field name="encounter_id" invisible="1" />
                <field name="patient_id" invisible="1" />
                <field name="vaccine_id" />
                <field name="occurrence" />
                <field name="lot_number" optional="hide" />
                <field name="expiration_date" optional="hide" />
                <field name="route_id" optional="show" />
                <field name="site_id" optional="hide" />
                <field name="location_id" optional="hide" />
                <field name="performer_id" widget="many2one_avatar_employee" optional="hide" />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state in ['preparation', 'suspended']"
                    decoration-info="state=='in-progress'"
                    decoration-success="state=='completed'"
                    decoration-danger="state in ['not-done', 'abort']"
                    optional="show"
                />
                <control>
                    <create string="Add immunization" context="{'no_header': True}" />
                </control>
            </tree>
        </field>
    </record>
    <record id="ni_immunization_view_form" model="ir.ui.view">
        <field name="name">ni.immunization.view.form</field>
        <field name="model">ni.immunization</field>
        <field name="arch" type="xml">
            <form>
                <header invisible="context.get('no_header')">
                    <button
                        name="action_complete"
                        string="Complete"
                        class="oe_highlight"
                        states="preparation,in-progress"
                        type="object"
                    />
                    <button name="action_not_done" string="Not Done" states="preparation" type="object" />
                    <button name="action_abort" string="Abort" states="in-progress" type="object" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="preparation,completed"
                        invisible="context.get('default_state')"
                    />
                </header>
                <sheet>
                    <div class="oe-title mb24">
                        <div class="d-flex">
                            <label for="vaccine_id" class="flex-fill" />
                            <field
                                class="oe_inline text-muted"
                                name="identifier"
                                attrs="{'invisible': [('id', '=', False)]}"
                                readonly="True"
                            />
                        </div>
                        <h4>
                            <field
                                name="vaccine_id"
                                class="w-100"
                                placeholder="Search vaccine..."
                                options="{'no_open': True}"
                            />
                        </h4>
                    </div>
                    <group>
                        <group>
                            <field
                                name="patient_id"
                                invisible="context.get('default_patient_id')"
                                options="{'no_open': True}"
                                context="{'show_identifier': True}"
                                widget="many2one_avatar"
                            />
                            <field
                                name="encounter_id"
                                invisible="context.get('default_encounter_id')"
                                options="{'no_open': True}"
                            />
                            <field name="occurrence" />
                            <field name="lot_number" />
                            <field name="expiration_date" />
                            <field name="dose_quantity" />
                        </group>
                        <group>
                            <field name="company_id" invisible="1" options="{'no_open': True}" />
                            <field name="performer_id" widget="many2one_avatar_employee" />
                            <field name="location_id" options="{'no_open': True}" />
                            <field name="route_id" options="{'no_open': True}" />
                            <field name="site_id" options="{'no_open': True}" />
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..." />
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_immunization_view_kanban" model="ir.ui.view">
        <field name="name">ni.immunization.view.kanban</field>
        <field name="model">ni.immunization</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="performer_id" />
                <field name="occurrence" />
                <field name="state" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <div class="text-muted small">
                                        <i class="fa fa-clock-o me-1" aria-hidden="true" title="Occurrence" />
                                        <field name="occurrence" />
                                    </div>
                                </div>
                                <div class="oe_kanban_bottom_right mr4">
                                    <field name="performer_id" widget="many2one_avatar_employee" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
