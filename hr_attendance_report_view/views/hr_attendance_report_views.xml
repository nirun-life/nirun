<odoo>
    <record model="ir.actions.act_window" id="hr_attendance.hr_attendance_report_action">
        <field name="view_mode">pivot,tree,graph</field>
        <field name="context">{'group_by':['check_in:day','employee_id'],'search_default_check_in': 1}</field>
    </record>
    <record id="hr_attendance_report_view_search" model="ir.ui.view">
        <field name="name">hr.attendance.report.view.search</field>
        <field name="model">hr.attendance.report</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_report_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='check_in']" position="attributes">
                <attribute name="default_period">this_month</attribute>
            </xpath>
        </field>
    </record>
    <record id="hr_attendance_report_view_tree_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.report.view.tree.inherit</field>
        <field name="model">hr.attendance.report</field>
        <field name="arch" type="xml">
            <tree default_order="check_in desc" expand="1">
                <field name="check_in" />
                <field name="employee_id" enable_counters="1" />
                <field name="worked_hours" widget="float_time" sum="Hours Worked" />
                <field name="overtime_hours" widget="float_time" sum="Extra Hours" optional="hide" />
                <groupby name="employee_id" expand="1">
                    <button name="get_formview_action" type="object" title="Profile" icon="fa-id-badge" />
                </groupby>
            </tree>
        </field>
    </record>
    <record id="hr_attendance_report_view_pivot_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.report.view.pivot.inherit</field>
        <field name="model">hr.attendance.report</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_report_view_pivot" />
        <field name="priority" eval="200" />
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="replace">
                <pivot
                    string="Attendance"
                    js_class="attendance_report_pivot"
                    display_quantity="0"
                    default_order="check_in desc"
                >
                    <field name="check_in" type="row" />
                    <field name="employee_id" type="row" />
                    <field name="worked_hours" type="measure" widget="float_time" />
                    <field name="overtime_hours" type="measure" widget="float_time" invisible="1" />
                </pivot>
            </xpath>
        </field>
    </record>
    <record id="hr_attendance_report_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.report.view.form</field>
        <field name="model">hr.attendance.report</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar_employee" />
                            <field name="department_id" />
                        </group>
                        <group>
                            <field name="check_in" />
                            <field name="worked_hours" widget="float_time" />
                            <field name="overtime_hours" widget="float_time" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
