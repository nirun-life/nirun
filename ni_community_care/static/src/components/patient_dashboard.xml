<templates xml:space="preserve">
    <t t-name="ni_community_care.PatientDashboard" owl="1">
        <div class="o_patient_container position-sticky start-0 d-flex o_form_statusbar">
            <t t-foreach="Object.entries(state.types)" t-as="types" t-key="types[0]">
                <t t-set="name" t-value="types[0]" />
                <t t-set="data" t-value="types[1]" />
                <div
                    t-attf-class="dashboard_card o_arrow_button flex-grow-1 d-flex flex-column p-3 border-bottom text-center"
                >
                    <span t-esc="data['amount']" t-attf-class="h2 m-0 {{data['class']}}" />
                    <b class="mx-2" t-esc="data['description']" />
                </div>
                <div
                    t-if="name !== 'adl-low'"
                    t-attf-class="dashboard_card o_arrow_button flex-grow-1 d-flex flex-column p-3 border-bottom text-center"
                >
                    <i class="fa fa-angle-right fa-3x" />
                </div>
            </t>
            <div
                class="fa fa-question-circle-o flex-grow-0.5 d-flex flex-column p-3 border-bottom text-center"
                t-if="env.debug"
                data-tooltip="Numbers computed from your patient"
            />
        </div>
    </t>
</templates>
