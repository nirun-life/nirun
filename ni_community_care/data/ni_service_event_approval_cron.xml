<odoo>
    <record id="ir_cron_create_my_model" model="ir.cron">
        <field name="name">Create Monthly Approval</field>
        <field name="model_id" ref="ni_community_care.model_ni_service_event_approval" />
        <field name="state">code</field>
        <field name="code">model._cron_create_approvals(batch_limit=500, job_ids=[])</field>
        <field name="active" eval="True" />
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="ir_cron_preparing_to_pending" model="ir.cron">
        <field name="name">Transition Preparing Approvals to Pending</field>
        <field name="model_id" ref="ni_community_care.model_ni_service_event_approval" />
        <field name="state">code</field>
        <field name="code">model._cron_preparing_to_pending(batch_limit=500)</field>
        <field name="active" eval="True" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="ir_cron_create_backfill_approvals" model="ir.cron">
        <field name="name">Create Backfill Approvals</field>
        <field name="model_id" ref="ni_community_care.model_ni_service_event_approval" />
        <field name="state">code</field>
        <field name="code">model._cron_backfill_approvals(batch_limit=500, job_ids=[])</field>
        <field name="active" eval="False" />
        <field name="interval_number">0</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="ir_cron_cleanup_backfill_approvals" model="ir.cron">
        <field name="name">Clean Up Backfilled Approvals</field>
        <field name="model_id" ref="ni_community_care.model_ni_service_event_approval" />
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_backfilled_approvals(batch_limit=500, stale_months=6)</field>
        <field name="active" eval="False" />
        <field name="interval_number">0</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="ir_cron_refresh_all_approvals" model="ir.cron">
        <field name="name">Re-Compute Approvals</field>
        <field name="model_id" ref="ni_community_care.model_ni_service_event_approval" />
        <field name="state">code</field>
        <field name="code">model._cron_refresh_approvals(batch_limit=100, days_threshold=7)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="ir_cron_generate_approval_reports_batch" model="ir.cron">
        <field name="name">Generate Approval Reports (PDF)</field>
        <field name="model_id" ref="ni_community_care.model_ni_service_event_approval" />
        <field name="state">code</field>
        <field name="code">
            model._cron_generate_reports_batch(retention_months=3, batch_limit=50, cooldown=10080)
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="ir_cron_cleanup_old_approval_reports" model="ir.cron">
        <field name="name">Cleanup Old Approval Reports (PDF)</field>
        <field name="model_id" ref="ni_community_care.model_ni_service_event_approval" />
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_old_reports(retention_months=3, batch_limit=50)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
    </record>
</odoo>
