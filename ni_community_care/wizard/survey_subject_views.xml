<odoo>
    <record id="survey_subject_wizard_view_form_inherit" model="ir.ui.view">
        <field name="name">survey.subject.wizard.view.form.inherit</field>
        <field name="model">survey.subject.wizard</field>
        <field name="inherit_id" ref="survey_subject.survey_subject_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='survey']/label[1]" position="before">
                <label for="patient_type_id" />
                <div class="o_row">
                    <field name="patient_type_decoration" invisible="1" />
                    <field
                        name="patient_type_id"
                        widget="badge"
                        decoration-primary="patient_type_decoration == 'primary'"
                        decoration-success="patient_type_decoration == 'success'"
                        decoration-info="patient_type_decoration == 'info'"
                        decoration-warning="patient_type_decoration == 'warning'"
                        decoration-danger="patient_type_decoration == 'danger'"
                        decoration-muted="patient_type_decoration == 'muted'"
                        attrs="{'invisible': [('patient_type_id', '=', False)]}"
                    />
                    <span class="text-muted" attrs="{'invisible': [('patient_type_id', '!=', False)]}">
                        กรุณาทำการประเมินเพื่อระบุกลุ่มผู้สูงอายุ
                    </span>
                </div>
                <field name="category_id" widget="radio" options="{'horizontal': True}" />
            </xpath>
            <xpath expr="//field[@name='survey_id']" position="attributes">
                <attribute name="domain">['&amp;', '|', ('target_type_ids', '=', patient_type_id),
                                          ('target_type_ids', '=', False), '|', ('category_id', '=', category_id),
                                          ('category_id', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
    <record id="questionnaire_survey_subject_wizard_view_form_inherit" model="ir.ui.view">
        <field name="name">questionnaire.survey.subject.wizard.view.form.inherit</field>
        <field name="model">survey.subject.wizard</field>
        <field name="inherit_id" ref="ni_questionnaire.survey_subject_view_form_wizard_inherit" />
        <field name="priority" eval="200" />
        <field name="arch" type="xml">
            <field name="subject_ni_encounter" position="replace">
                <field name="subject_ni_encounter" invisible="1" />
                <field name="patient_type_id" invisible="1" />
            </field>
        </field>
    </record>
</odoo>
