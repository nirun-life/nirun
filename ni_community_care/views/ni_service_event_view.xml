<odoo>
    <record id="ni_service_event_action_my_tree" model="ir.actions.act_window">
        <field name="name">ผลการปฎิบัติงานของฉัน (ศผ.02)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.service.event</field>
        <field name="view_mode">tree,calendar,kanban,form</field>
        <field name="context">
            {
                'search_default_group_start_day': 1,
                'create': 0,
            }
        </field>
        <field name="domain">[('create_uid', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ไม่พบกิจกรรมการดูแลผู้สูงอายุ</p>
        </field>
    </record>
    <record id="ni_service_event_action_my_pivot" model="ir.actions.act_window">
        <field name="name">ผลการปฎิบัติงานของฉัน (ศผ.02)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.service.event</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'search_default_start': 1}</field>
        <field name="domain">[('create_uid', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ไม่พบกิจกรรมการดูแลผู้สูงอายุ</p>
        </field>
    </record>
    <record id="ni_service_event_view_search" model="ir.ui.view">
        <field name="name">ni.service.event.view.search</field>
        <field name="model">ni.service.event</field>
        <field name="inherit_id" ref="ni_service.ni_service_event_view_search" />
        <field name="arch" type="xml">
            <field position="after" name="partner_ids">
                <filter string="กิจกรรมของฉัน" name="my_service" domain="[('user_id', '=', uid)]" />
                <filter name="group_start_day" context="{'group_by': 'start:day'}" invisible="1" />
            </field>
        </field>
    </record>
    <record id="ni_service_event_action_from_patient" model="ir.actions.act_window">
        <field name="name">กิจกรรมการดูแลผู้สูงอายุ (ศผ.02)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.service.event</field>
        <field name="view_mode">kanban,calendar,tree,pivot,form</field>
        <field name="context">
            {'default_plan_patient_ids': [(6, 0, [active_id])],
             'default_patient_id': active_id}
        </field>
        <field name="domain">[('plan_patient_ids', '=', active_id)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ไม่พบกิจกรรมการดูแลผู้สูง</p>
            <p>กดปุ่ม + ที่แต่ละมิติเพื่อเริ่มบันทึก</p>
        </field>
    </record>
    <record id="ni_service_event_view_form_quick_create_inherit" model="ir.ui.view">
        <field name="name">ni.service.event.view.form.quick.create.inherit</field>
        <field name="model">ni.service.event</field>
        <field name="inherit_id" ref="ni_service.ni_service_event_view_form_quick_create" />
        <field name="arch" type="xml">
            <field name="service_ids" position="after">
                <field name="patient_type_id" invisible="1" />
                <field name="patient_id" invisible="1" />
                <field name="user_id" invisible="1" />
                <field name="employee_id" invisible="1" />
            </field>
            <xpath expr="//group/div[2]" position="after">
                <field name="outcome" />
            </xpath>
        </field>
    </record>
    <record id="ni_service_event_view_form_inherit" model="ir.ui.view">
        <field name="name">ni.service.event.view.form.inherit</field>
        <field name="model">ni.service.event</field>
        <field name="inherit_id" ref="ni_service.ni_service_event_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="Attendance" string="ผู้เข้าร่วมกิจกรรม" icon="fa-blind">
                    <field name="attend_patient_ids" mode="tree">
                        <tree>
                            <field name="display_name" />
                            <field name="display_age" />
                            <field name="phone" />
                            <field name="mobile" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="ni_service_event_view_form" model="ir.ui.view">
        <field name="name">ni.service.event.view.form</field>
        <field name="model">ni.service.event</field>
        <field name="priority" eval="0" />
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <field name="display_name" string="กิจกรรม" invisible="1" />
                    <field name="patient_id" invisible="1" />
                    <field name="patient_type_id" invisible="1" />
                    <group>
                        <field name="name" invisible="1" />
                        <field name="plan_patient_ids" widget="many2many_tags_avatar" />
                        <field
                            name="service_category_id"
                            string="กิจกรรมการดูแล"
                            invisible="context.get('default_service_category_id')"
                            widget="radio"
                            options="{'horizontal': True}"
                            attrs="{'readonly': [('id', '!=', False)]}"
                        />
                        <field name="service_id" invisible="1" />
                        <field
                            name="service_ids"
                            widget="many2many_checkboxes"
                            string=""
                            domain="[('category_id', '=', service_category_id)]"
                        />
                        <field name="user_id" invisible="1" />
                        <field name="employee_id" invisible="1" />
                        <field name="partner_id" invisible="1" />
                    </group>
                    <group>
                        <group string="เวลาที่ปฎิบัติงาน">
                            <field name="start" force_save="1" />
                            <field name="stop" force_save="1" />
                            <label for="duration" />
                            <div class="o_row">
                                <field name="duration" widget="float_time" force_save="1" class="o_narrow_field" />
                                <span class="mx-1">ชั่วโมง</span>
                            </div>
                        </group>
                        <group string="รายละเอียด">
                            <field name="location" string="สถานที่" />
                            <field name="outcome" placeholder="ผลการให้ความช่วยเหลือ..." />
                        </group>
                    </group>
                    <separator string="ภาพประกอบ" class="mt-2" />
                    <div class="o_row mt-4">
                        <field name="image_1" widget="image" class="oe_avatar" options="{'zoom': true}" />
                        <field
                            name="image_2"
                            widget="image"
                            class="oe_avatar"
                            options="{'zoom': true}"
                            attrs="{'invisible': [('image_1', '=', False)]}"
                        />
                    </div>
                    <group string="ประเมินความพึงพอใจ">
                        <field
                            name="satisfaction_level"
                            widget="radio"
                            class="satisfaction-radio"
                            options="{'horizontal': True}"
                        />
                    </group>
                    <group class="mt-4">
                        <label for="employee_id" string="ผู้บริบาล" attrs="{'invisible': [('id', '=', False)]}" />
                        <div attrs="{'invisible': [('id', '=', False)]}">
                            <field
                                name="employee_id"
                                widget="many2one_avatar_employee"
                                class="pe-1"
                                attrs="{'readonly': [('id', '!=', False)]}"
                            />
                            <field name="user_id" class="px-1" attrs="{'readonly': [('id', '!=', False)]}" />
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_service_event_view_pivot_inherit" model="ir.ui.view">
        <field name="name">ni.service.event.view.pivot.inherit</field>
        <field name="model">ni.service.event</field>
        <field name="inherit_id" ref="ni_service.ni_service_event_view_pivot" />
        <field name="arch" type="xml">
            <field name="start" position="after">
                <field name="start" type="col" interval="day" />
            </field>
        </field>
    </record>
    <record id="ni_service_event_view_tree_inherit" model="ir.ui.view">
        <field name="name">ni.service.event.view.tree.inherit</field>
        <field name="model">ni.service.event</field>
        <field name="inherit_id" ref="ni_service.ni_service_event_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">start desc</attribute>
            </xpath>
            <field name="name" position="before">
                <field name="plan_patient_ids" widget="many2many_tags_avatar" />
            </field>
            <field name="name" position="attributes">
                <attribute name="string">กิจกรรม</attribute>
            </field>
            <field name="user_id" position="before">
                <field
                    name="employee_id"
                    string="ชื่อ-นามสกุลผู้บริบาล"
                    optional="show"
                    invisible="context.get('search_default_my_service')"
                />
            </field>
            <field name="user_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="partner_ids" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>
    <record id="ni_service_event_view_tree_inherit_approval" model="ir.ui.view">
        <field name="name">ni_service_event_view_tree_inherit_approval</field>
        <field name="model">ni.service.event</field>
        <field name="inherit_id" ref="ni_service.ni_service_event_view_tree" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">start desc</attribute>
            </xpath>
            <!-- แทรก field start ก่อน field แรกเดิม -->
            <xpath expr="//tree/field[1]" position="before">
                <field name="start" string="วันที่" widget="date" />
            </xpath>
            <!-- ลบ field start เดิมออก (ถ้าเคยอยู่ในตำแหน่งอื่น) -->
            <xpath expr="//field[@name='start'][2]" position="replace" />
            <xpath expr="//field[@name='start']" position="after">
                <field name="time_range" string="เวลา" readonly="1" />
            </xpath>
            <field name="name" position="attributes">
                <attribute name="string">แผนการให้ความช่วยเหลือดูแล</attribute>
            </field>
            <field name="name" position="before">
                <field
                    name="service_category_ids"
                    string="มิติ"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
            </field>
            <field name="name" position="after">
                <field name="outcome" />
            </field>
            <field name="employee_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>
    <record id="ni_service_event_view_kanban_inherit_approval" model="ir.ui.view">
        <field name="name">ni_service_event_view_kanban_inherit_approval</field>
        <field name="model">ni.service.event</field>
        <field name="arch" type="xml">
            <kanban default_order="start desc">
                <field name="start" />
                <field name="time_range" />
                <field name="name" />
                <field name="outcome" />
                <field name="service_category_ids" />
                <field name="color" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_card oe_kanban_global_click"
                        >
                            <div class="oe_kanban_card">
                                <!-- วันที่ และ เวลา -->
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_tags">
                                        <field
                                            name="service_category_ids"
                                            widget="many2many_tags"
                                            options="{'color_field': 'color'}"
                                        />
                                    </div>
                                    <br />
                                    <strong>
                                        <i class="fa fa-clock-o" style="color:#f39c12; margin-right:4px;" />
                                        วันที่ :
                                    </strong>
                                    <t
                                        t-esc="(record.start.value and record.start.value.split(' ')[0]) + ' ' + (record.time_range.value or '-')"
                                    />
                                    <br />
                                    <strong>
                                        <i class="fa fa-user" style="color:orange; margin-right:4px;" />
                                        ผู้สูงอายุ :
                                    </strong>
                                    <field name="plan_patient_ids" />
                                    <div>
                                        <strong>
                                            <i class="fa fa-calendar" style="color:red; margin-right:4px;" />
                                            แผนการให้ความช่วยเหลือดูแล :
                                        </strong>
                                        <br />
                                        <field name="name" />
                                    </div>
                                    <!--                                    <t t-esc="record.name.value" />-->
                                    <div>
                                        <strong>
                                            <i class="fa fa-file-text-o" style="color:blue; margin-right:4px;" />
                                            ผลการให้ความช่วยเหลือดูแล :
                                        </strong>
                                        <field name="outcome" />
                                    </div>
                                    <!--<div>
                                        <t t-esc="record.outcome.value or ''" />
                                    </div>-->
                                    <!-- มิติ -->
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record model="ir.actions.act_window" id="ni_service.ni_service_event_action">
        <field name="context">{'search_default_my_service': 1}</field>
    </record>
</odoo>
