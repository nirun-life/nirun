<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">
    <record id="ni_service_event_approval_view_search" model="ir.ui.view">
        <field name="name">ni.service.event.approval.view.search</field>
        <field name="model">ni.service.event.approval</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="identifier"
                    filter_domain="['|', ('identifier', 'ilike', self), ('user_id', 'ilike', self)]"
                />
                <filter name="pending" string="รอการอนุมัติ" domain="[('state', '=', 'pending')]" />
                <filter name="approved" string="อนุมัติแล้ว" domain="[('state', '=', 'approved')]" />
                <filter name="rejected" string="ไม่ผ่านการอนุมัติ" domain="[('state', '=', 'rejected')]" />
                <filter name="group_employee" string="ผู้บริบาล" context="{'group_by':'employee_id'}" />
                <filter name="group_month" string="ช่วง" context="{'group_by':'start', 'order': 'start desc'}" />
                <searchpanel>
                    <field name="state" string="สถานะ" enable_counters="1" icon="fa-circle" />
                    <field name="state_id" string="" enable_counters="1" />
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="ni_service_event_approval_action" model="ir.actions.act_window">
        <field name="name">การอนุมัติบันทึกงานผู้บริบาล</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.service.event.approval</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{'search_default_group_month': 1, }</field>
        <field name="domain">[('user_id.my_area', '=', True)]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">ไม่พบการรายการอนุมัติบันทึกงาน</p>
        </field>
    </record>
    <record id="ni_service_event_approval_action_pending" model="ir.actions.act_window">
        <field name="name">การอนุมัติบันทึกงานผู้บริบาล</field>
        <field name="res_model">ni.service.event.approval</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{'search_default_group_month': 1, 'search_default_pending': 2, }</field>
        <field name="domain">[('user_id.my_area', '=', True)]</field>
    </record>
    <record id="ni_service_event_approval_action_approved" model="ir.actions.act_window">
        <field name="name">การอนุมัติบันทึกงานผู้บริบาล</field>
        <field name="res_model">ni.service.event.approval</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{'search_default_group_month': 1, 'search_default_approved': 2}</field>
        <field name="domain">[('user_id.my_area', '=', True)]</field>
    </record>
    <record id="ni_service_event_approval_action_rejected" model="ir.actions.act_window">
        <field name="name">การอนุมัติบันทึกงานผู้บริบาล</field>
        <field name="res_model">ni.service.event.approval</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{'search_default_group_month': 1, 'search_default_rejected': 2}</field>
        <field name="domain">[('user_id.my_area', '=', True)]</field>
    </record>
    <record id="ni_service_event_approval_action_self" model="ir.actions.act_window">
        <field name="name">การอนุมัติบันทึกงานของฉัน</field>
        <field name="res_model">ni.service.event.approval</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{}</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
    <record id="ni_service_event_approval_view_tree" model="ir.ui.view">
        <field name="name">ni.service.event.approval.view.tree</field>
        <field name="model">ni.service.event.approval</field>
        <field name="arch" type="xml">
            <tree default_order="start desc">
                <field name="identifier" string="หมายเลขอ้างอิง" />
                <field name="employee_id" />
                <field name="start" string="ตั้งแต่" optional="show" />
                <field name="stop" string="จนถึง" optional="hide" />
                <field name="patient_count" string="ผศ.01" optional="hide" />
                <field
                    name="state"
                    string="สถานะ"
                    widget="badge"
                    decoration-warning="state == 'pending'"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'rejected'"
                />
                <field name="due_date" states="approved" optional="hide" />
                <field name="write_date" optional="hide" />
                <!-- ให้เห็นเฉพาะกลุ่ม developer -->
                <field name="has_pdf" groups="base.group_no_one" widget="boolean_toggle" optional="hide" />
                <field name="last_pdf_date" groups="base.group_no_one" optional="hide" />
                <field name="last_pdf_error" groups="base.group_no_one" invisible="True" optional="hide" />
                <field name="write_uid" groups="base.group_no_one" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="ni_service_event_approval_view_kanban" model="ir.ui.view">
        <field name="name">ni.service.event.approval.view.kanban</field>
        <field name="model">ni.service.event.approval</field>
        <field name="arch" type="xml">
            <kanban default_order="start desc">
                <field name="identifier" />
                <field name="employee_id" />
                <field name="start" />
                <field name="stop" />
                <field name="event_count" />
                <field name="state" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_card">
                            <div class="oe_kanban_details">
                                <div name="kanban_top" class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <span class="o_kanban_record_title fs-2">
                                            <field name="identifier" />
                                        </span>
                                    </div>
                                </div>
                                <ul>
                                    <li>
                                        <label for="employee_id" class="small text-muted me-2">ผู้บริบาล:</label>
                                        <field name="employee_id" />
                                    </li>
                                    <li>
                                        <label for="start" class="small text-muted me-2">ตั้งแต่:</label>
                                        <field name="start" />
                                    </li>
                                    <li>
                                        <label for="stop" class="small text-muted me-2">จนถึง:</label>
                                        <field name="stop" />
                                    </li>
                                    <li>
                                        <label for="event_count" class="small text-muted me-2">จำนวนกิจกรรม:</label>
                                        <field name="event_count" />
                                    </li>
                                </ul>
                                <div class="oe_module_action d-flex flex-wrap justify-content-between">
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-warning="state == 'pending'"
                                        decoration-success="state == 'approved'"
                                        decoration-danger="state == 'rejected'"
                                    />
                                    <button
                                        name="action_approved_event"
                                        type="object"
                                        string="อนุมัติ"
                                        icon="fa-check-circle"
                                        class="btn-info btn-sm"
                                        attrs="{'invisible': [('state', 'in', ['approved'])]}"
                                        groups="ni_patient.group_manager"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_service_event_approval_view_form" model="ir.ui.view">
        <field name="name">ni.service.event.approval.view.form</field>
        <field name="model">ni.service.event.approval</field>
        <field name="arch" type="xml">
            <form string="Event Approval" readonly="1">
                <field name="patient_ids" invisible="1" />
                <field name="patient_count" invisible="1" />
                <field name="all_patient_ids" invisible="1" />
                <field name="all_patient_count" invisible="1" />
                <field name="event_patient_ids" invisible="1" />
                <field name="event_count" invisible="1" />
                <header>
                    <button
                        name="action_refresh_computed_fields"
                        string="อัปเดตข้อมูลบันทึกงาน"
                        type="object"
                        class="btn"
                        groups="ni_patient.group_admin"
                    />
                    <button
                        name="action_regenerate_report"
                        string="อัปเดตรายงาน PDF"
                        type="object"
                        class="btn"
                        groups="ni_patient.group_admin"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <field name="identifier" class="text-muted" />
                        <h1>
                            <field name="employee_id" widget="many2one_avatar_user" readonly="1" />
                        </h1>
                        <div class="mb-4">
                            <span class="text-muted">
                                ในวันที่ 1 ของทุกเดือน
                                ระบบจะสร้างบันทึกงานผู้บริบาลของเดือนก่อนหน้าโดยอัตโนมัติ
                            </span>
                            <br />
                        </div>
                    </div>
                    <group>
                        <group>
                            <!-- ด้านซ้าย -->
                            <field name="start" string="ตั้งแต่" readonly="1" />
                            <field name="stop" string="จนถึง" readonly="1" />
                            <field name="due_date" states="approved" />
                            <label for="write_date" />
                            <div>
                                <field name="write_date" string="อัปเดตเมื่อ" />
                                <p class="text-muted">
                                    <i class="fa fa-info-circle me-2" title="คำเตือน" />
                                    <span>อัปเดตข้อมูลอัตโนมัติทุกสุดสัปดาห์จนกว่าจะอนุมัติ</span>
                                </p>
                            </div>
                        </group>
                        <group>
                            <field
                                name="state"
                                string="สถานะ"
                                readonly="1"
                                decoration-warning="state == 'pending'"
                                decoration-success="state == 'approved'"
                                decoration-danger="state == 'rejected'"
                                widget="badge"
                            />
                            <label
                                for="state_by"
                                string="โดย"
                                attrs="{'invisible':[('state','in',['pending','archived'])]}"
                            />
                            <div class="o_row" attrs="{'invisible':[('state','in',['pending','archived'])]}">
                                <field name="state_by" />
                                <label for="state_date" string="เมื่อ" />
                                <field name="state_date" />
                            </div>
                            <field name="city_ids" string="พื้นที่รับผิดชอบ" widget="many2many_tags" readonly="1" />
                            <field name="state_id" string="จังหวัด" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="patient_ids" string="ผู้สูงอายุ (ศผ.01)" icon="fa-address-book">
                            <div class="text-end">
                                <button
                                    name="%(service_event_approval_01_elder_action_report)d"
                                    string="พิมพ์ข้อมูลพื้นฐานของผู้สูงอายุ ศผ.01"
                                    type="action"
                                    class="btn-outline-primary"
                                    icon="fa-print"
                                />
                            </div>
                            <field name="patient_filter" class="ms-2" widget="radio" options="{'horizontal':True}" />
                            <!-- มีข้อมูล -->
                            <div class="mt-2 py-3" attrs="{'invisible':[('all_patient_count','=',0)]}">
                                <div class="stat-summary mt-2">
                                    <!-- ติดสังคม -->
                                    <div class="stat-item">
                                        <i class="fa fa-comments text-success" />
                                        <!-- NEW -->
                                        <field
                                            name="adl_high_count"
                                            attrs="{'invisible':[('patient_filter','!=','new')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <!-- EVENT -->
                                        <field
                                            name="event_adl_high_count"
                                            attrs="{'invisible':[('patient_filter','!=','event')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <!-- ALL -->
                                        <field
                                            name="all_adl_high_count"
                                            attrs="{'invisible':[('patient_filter','!=','all')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <span class="stat-label">ติดสังคม</span>
                                    </div>
                                    <!-- ติดบ้าน -->
                                    <div class="stat-item">
                                        <i class="fa fa-home text-odoo" />
                                        <field
                                            name="adl_mid_count"
                                            attrs="{'invisible':[('patient_filter','!=','new')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <field
                                            name="event_adl_mid_count"
                                            attrs="{'invisible':[('patient_filter','!=','event')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <field
                                            name="all_adl_mid_count"
                                            attrs="{'invisible':[('patient_filter','!=','all')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <span class="stat-label">ติดบ้าน</span>
                                    </div>
                                    <!-- ติดเตียง -->
                                    <div class="stat-item">
                                        <i class="fa fa-bed text-danger" />
                                        <field
                                            name="adl_low_count"
                                            attrs="{'invisible':[('patient_filter','!=','new')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <field
                                            name="event_adl_low_count"
                                            attrs="{'invisible':[('patient_filter','!=','event')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <field
                                            name="all_adl_low_count"
                                            attrs="{'invisible':[('patient_filter','!=','all')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <span class="stat-label">ติดเตียง</span>
                                    </div>
                                    <!-- unknown -->
                                    <div
                                        class="stat-item"
                                        attrs="{'invisible':[('patient_filter','=','new'),('adl_unknown_count','=',0)]}"
                                    >
                                        <i class="fa fa-question-circle-o text-muted" />
                                        <field
                                            name="adl_unknown_count"
                                            attrs="{'invisible':[('patient_filter','!=','new')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <field
                                            name="event_adl_unknown_count"
                                            attrs="{'invisible':[('patient_filter','!=','event')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <field
                                            name="all_adl_unknown_count"
                                            attrs="{'invisible':[('patient_filter','!=','all')]}"
                                            readonly="1"
                                            class="stat-value"
                                        />
                                        <span class="stat-label">รอการประเมิน</span>
                                    </div>
                                </div>
                            </div>
                            <!-- ไม่มีข้อมูล -->
                            <div class="mt-2 py-3 text-center" attrs="{'invisible':[('all_patient_count','!=',0)]}">
                                <span class="text-muted" style="font-style: italic;">ไม่มีข้อมูล</span>
                            </div>
                            <!-- แสดงรายการผู้สูงอายุ (เฉพาะตอนเลือก all) -->
                            <field
                                name="all_patient_ids"
                                mode="kanban"
                                readonly="1"
                                attrs="{'invisible':[('patient_filter','!=','all')]}"
                                context="{
                                    'kanban_view_ref': 'ni_community_care.ni_patient_view_kanban_simp',
                                    'form_view_ref': 'ni_community_care.ni_patient_view_form_simp'
                                }"
                                options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                            />
                            <field
                                name="patient_ids"
                                mode="kanban"
                                readonly="1"
                                attrs="{'invisible':[('patient_filter','!=','new')]}"
                                context="{
                                    'kanban_view_ref': 'ni_community_care.ni_patient_view_kanban_simp',
                                    'form_view_ref': 'ni_community_care.ni_patient_view_form_simp'
                                }"
                                options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                            />
                            <field
                                name="event_patient_ids"
                                mode="kanban"
                                readonly="1"
                                attrs="{'invisible':[('patient_filter','!=','event')]}"
                                context="{
                                    'kanban_view_ref': 'ni_community_care.ni_patient_view_kanban_simp',
                                    'form_view_ref': 'ni_community_care.ni_patient_view_form_simp'
                                }"
                                options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                            />
                        </page>
                        <page name="event_ids" string="กิจกรรมการดูแลผู้สูงอายุ (ศผ.02)" icon="fa-life-ring">
                            <div class="text-end mb-4">
                                <button
                                    name="%(service_event_approval_02_category_action_report)d"
                                    string="พิมพ์ผลการปฏิบัติงาน ศผ.02"
                                    type="action"
                                    class="btn-outline-primary mb-2"
                                    icon="fa-print"
                                />
                                <field name="has_pdf" invisible="1" />
                                <div class="text-muted" groups="ni_patient.group_admin">
                                    <label for="last_pdf_date" string="อัปเดตรายงานเมื่อ" />
                                    <field name="last_pdf_date" />
                                    <button name="action_regenerate_report" type="object" icon="fa-refresh" />
                                </div>
                            </div>
                            <div class="mb-2">
                                <strong>สรุปผลกิจกรรมการดูแลผู้สูงอายุ</strong>
                            </div>
                            <!-- By Category -->
                            <field
                                name="category_ids"
                                mode="kanban"
                                context="{'approval_id': active_id, 'kanban_view_ref': 'ni_community_care.ni_service_category_view_kanban_inherit_service_category'}"
                            />
                            <!-- Empty -->
                            <div attrs="{'invisible': [('event_count', '!=', 0)]}" class="text-center mt-3">
                                <span class="text-muted" style="font-style: italic;">ไม่มีข้อมูล</span>
                            </div>
                            <div class="mt-5 mb-2">
                                <strong>ประวัติกิจกรรมการดูแลผู้สูงอายุ</strong>
                            </div>
                            <field
                                name="event_ids"
                                mode="tree,kanban"
                                readonly="1"
                                context="{'tree_view_ref': 'ni_community_care.ni_service_event_view_tree_inherit_approval',
                                'kanban_view_ref': 'ni_community_care.ni_service_event_view_kanban_inherit_approval'
                                }"
                            />
                        </page>
                        <page name="service_ids" string="กิจกรรมพัฒนาคุณภาพชีวิตผู้สูงอายุ (ศผ.03)" icon="fa-heart">
                            <div class="text-end mb-4">
                                <button
                                    name="%(service_event_approval_03_service_action_report)d"
                                    string="พิมพ์กิจกรรมพัฒนาคุณภาพชีวิตผู้สูงอายุ ศผ.03"
                                    type="action"
                                    class="btn-outline-primary"
                                    icon="fa-print"
                                />
                            </div>
                            <field
                                name="service_ids"
                                mode="tree"
                                readonly="1"
                                context="{'tree_view_ref': 'ni_community_care.ni_service_view_tree_inherit_approval'}"
                            />
                            <field name="service_count" invisible="1" />
                        </page>
                        <page
                            name="careplan"
                            string="แผนการให้ความช่วยเหลือดูแลผู้สูงอายุ (ศผ.04)"
                            icon="fa-tasks"
                            badge="careplan_count"
                        >
                            <div class="text-end mb-4">
                                <button
                                    name="%(service_event_approval_04_careplan_action_report)d"
                                    string="แผนการให้ความช่วยเหลือดูแลผู้สูงอายุ ศผ.04"
                                    type="action"
                                    class="btn-outline-primary"
                                    icon="fa-print"
                                />
                            </div>
                            <field name="careplan_count" invisible="1" />
                            <field name="careplan_ids">

                            </field>
                        </page>
                        <page string="Debug" icon="fa-bug" groups="base.group_no_one">
                            <group string="ข้อมูลที่แก้ไขได้" groups="base.group_no_one">
                                <field name="user_id" widget="many2one_avatar_user" readonly="0" />
                                <field name="employee_id" widget="many2one_avatar_user" readonly="1" />
                                <field name="start" string="ตั้งแต่" readonly="0" />
                                <field name="stop" string="จนถึง" readonly="0" />
                                <field
                                    name="state"
                                    string="สถานะ"
                                    decoration-warning="state == 'pending'"
                                    decoration-success="state == 'approved'"
                                    decoration-danger="state == 'rejected'"
                                />
                            </group>
                            <group string="Last Update" groups="base.group_no_one">
                                <field name="write_date" />
                                <field name="write_uid" />
                            </group>
                        </page>
                    </notebook>
                    <group>
                        <field name="due_date" states="pending" />
                    </group>
                    <div class="text-end">
                        <button
                            name="action_approved_event"
                            type="object"
                            string="อนุมัติบันทึกงาน"
                            icon="fa-check"
                            states="pending"
                            class="btn-success me-4"
                            groups="ni_patient.group_manager"
                        />
                    </div>
                </sheet>
                <div name="chatter" class="oe_chatter">
                    <field
                        name="message_follower_ids"
                        groups="base.group_user"
                        options="{'post_refresh': 'recipients'}"
                    />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>
