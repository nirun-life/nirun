<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_employee_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='public']/div" position="after">
                <group string="พื้นที่รับผิดชอบ" class="mt-4">
                    <field name="state_id" invisible="1" />
                    <field name="country_id" invisible="1" />
                    <field name="state_ids" widget="many2many_tags" />
                    <field name="state_id" groups="base.group_no_one" />
                    <field name="sub_district_code" groups="base.group_no_one" />
                </group>
                <div>
                    <label for="city_ids" />
                    <span class="text-muted">ระบบจำกัดการเข้าถึงข้อมูลของผู้บริบาลด้วยข้อมูลนี้</span>
                    <button
                        name="action_add_response_state_cities"
                        type="object"
                        class="float-end"
                        string=" ทั้งจังหวัด"
                        attrs="{'invisible': [('state_ids', '=', False)]}"
                        confirm="พื้นที่รับผิดชอบที่คุณเลือกไว้จะเขียนทับ"
                        icon="fa-map"
                    />
                </div>
                <field name="city_ids" />
            </xpath>
            <field name="department_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="coach_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath
                expr="//page[@name='hr_settings']/group/group[@name='active_group']/field[@name='user_id']"
                position="attributes"
            >
                <attribute name="context">
                    {
                        'form_view_ref': 'base.view_users_form',
                        'allow_create_employee': False,
                        'default_create_employee': False,
                    }
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
