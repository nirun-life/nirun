<odoo>
    <record id="ni_service_action_my" model="ir.actions.act_window">
        <field name="name">กิจกรรมของฉัน ศผ.03</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.service</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('my_service', '=', True)]</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">My Service not found. Let's create one!</p>
        </field>
    </record>
    <record id="ni_service_action_all" model="ir.actions.act_window">
        <field name="name">กิจกรรมทั้งหมด</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.service</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ไม่พบกิจกรรม</p>
        </field>
    </record>
    <record id="ni_service_readonly_view_tree" model="ir.ui.view">
        <field name="name">ni.service.view.tree.readonly</field>
        <field name="model">ni.service</field>
        <field name="inherit_id" ref="ni_service.ni_service_view_tree" />
        <field name="mode">primary</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>
    <record id="ni_service_readonly_view_form" model="ir.ui.view">
        <field name="name">ni.service.view.form.readonly</field>
        <field name="model">ni.service</field>
        <field name="inherit_id" ref="ni_service.ni_service_view_form" />
        <field name="mode">primary</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>
    <record id="ni_service_action_community" model="ir.actions.act_window">
        <field name="name">กิจกรรมส่วนกลาง</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.service</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_service': 1, 'no_create_event': 0}</field>
        <field name="domain">[('user_id', '=', False)]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('ni_community_care.ni_service_readonly_view_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('ni_community_care.ni_service_readonly_view_form')}),
            ]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ไม่พบกิจกรรมส่วนกลาง</p>
        </field>
    </record>
    <record id="ni_service_view_form_inherit" model="ir.ui.view">
        <field name="name">ni.service.view.form.inherit</field>
        <field name="model">ni.service</field>
        <field name="inherit_id" ref="ni_service.ni_service_view_form" />
        <field name="arch" type="xml">
            <field position="after" name="type_id">
                <field name="timing_id" />
            </field>
            <xpath position="inside" expr="//sheet/group/group[2]">
                <field name="user_id" widget="many2one_avatar_user" invisible="context.get('default_user_id')" />
                <field
                    name="target_type_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color', 'no_create': True, }"
                />
                <label for="target" />
                <div class="o_row">
                    <field name="target" />
                    <div>คน</div>
                </div>
            </xpath>
            <xpath expr="//page[@name='description']" position="before">
                <page name="objective" string="วัตถุประสงค์" icon="fa-bullseye">
                    <field name="objective" placeholder="วัตถุประสงค์..." />
                </page>
                <page name="procedure" string="วิธีการ/ขั้นตอนการทำงาน" icon="fa-th-list">
                    <field name="procedure" placeholder="วิธีการ/ขั้นตอนการทำงาน..." />
                </page>
                <page name="benefit" string="ผลประโยชน์" icon="fa-gift">
                    <field name="benefit" placeholder="ผลประโยชน์..." />
                </page>
            </xpath>
            <xpath expr="//page[@name='employee']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='calendar']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='description']" position="attributes">
                <attribute name="string">หมายเหตุ</attribute>
            </xpath>
        </field>
    </record>
    <record id="ni_service_view_tree_inherit" model="ir.ui.view">
        <field name="name">ni.service.view.tree.inherit</field>
        <field name="model">ni.service</field>
        <field name="inherit_id" ref="ni_service.ni_service_view_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="timing_id" />
            </field>
            <field name="type_id" position="after">
                <field name="target_type_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                <field name="target" />
            </field>
        </field>
    </record>
    <record id="ni_service_view_tree_inherit_approval" model="ir.ui.view">
        <field name="name">ni.service.view.tree.inherit.approval</field>
        <field name="model">ni.service</field>
        <field name="inherit_id" ref="ni_service.ni_service_view_tree" />
        <field name="mode">primary</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='timing_id']" position="replace" />
            <xpath expr="//tree/field[@name='duration']" position="replace" />
            <xpath expr="//tree/field[@name='attendance_ids']" position="replace" />
            <xpath expr="//tree/field[@name='employee_id']" position="replace" />
            <xpath expr="//tree/field[@name='next_date']" position="replace" />
            <xpath expr="//tree/field[@name='type_id']" position="replace" />
            <xpath expr="//field[@name='category_id']" position="replace" />
            <xpath expr="//tree/field[@name='name']" position="after">
                <field name="category_id" widget="badge" readonly="1" />
            </xpath>
            <xpath expr="//tree/field[@name='category_id']" position="attributes">
                <attribute name="string">มิติ</attribute>
            </xpath>
            <xpath expr="//tree/field[@name='category_id']" position="after">
                <field name="objective" />
                <field name="procedure" />
            </xpath>
            <xpath expr="//tree/field[@name='target']" position="after">
                <field name="benefit" />
            </xpath>
        </field>
    </record>
</odoo>
