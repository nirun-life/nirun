<odoo>
    <record id="ni_living_with_action" model="ir.actions.act_window">
        <field name="name">ผู้สูงอายุอาศัยอยู่กับ</field>
        <field name="res_model">ni.living.with</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="ni_living_with_view_tree" model="ir.ui.view">
        <field name="name">ni.living.with.view.tree</field>
        <field name="model">ni.living.with</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" optional="show" />
                <field name="active" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="ni_living_with_view_form" model="ir.ui.view">
        <field name="name">ni.living.with.view.form</field>
        <field name="model">ni.living.with</field>
        <field name="arch" type="xml">
            <form>
                <field name="id" invisible="True" />
                <field name="active" invisible="True" />
                <sheet>
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('active', '=', True)]}"
                        bg_color="bg-danger"
                        title="Archived"
                    />
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="sequence" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
