<odoo>
    <record id="ni_living_with_action" model="ir.actions.act_window">
        <field name="name">ผู้สูงอายุอาศัยอยู่กับ</field>
        <field name="res_model">ni.living.with</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="view_living_with_tree" model="ir.ui.view">
        <field name="name">ni.living.with.tree</field>
        <field name="model">ni.living.with</field>
        <field name="arch" type="xml">
            <tree string="ผู้สูงอายุอาศัยอยู่กับ">
                <field name="name" />
            </tree>
        </field>
    </record>
    <!-- Form view -->
    <record id="view_living_with_form" model="ir.ui.view">
        <field name="name">ni.living.with.form</field>
        <field name="model">ni.living.with</field>
        <field name="arch" type="xml">
            <form string="ผู้สูงอายุอาศัยอยู่กับ">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
