<odoo>
    <record id="ni_patient_view_search" model="ir.ui.view">
        <field name="name">ni.patient.view.search</field>
        <field name="model">ni.patient</field>
        <field name="inherit_id" ref="ni_patient.ni_patient_view_search" />
        <field name="priority" eval="200" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="replace">
                <search>
                    <field
                        name="name"
                        filter_domain="['|','|' ,('name', 'ilike', self), ('identifier', 'ilike', self),('identification_id', 'ilike', self)]"
                    />
                    <filter name="my_patient" string="ที่ฉันขึ้นทะเบียน ศผ.01" domain="[('create_uid', '=', uid)]" />
                    <filter name="my_activity" string="ที่ฉันดูแล ศผ.02" domain="[('activity_user_id', '=', uid)]" />
                    <separator />
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
                    <filter name="group_zip_id" string="พื้นที่" context="{'group_by': 'zip_id'}" />
                    <filter
                        name="group_create_date"
                        context="{'group_by': 'create_date:month'}"
                        string="วันที่บันทึก"
                    />
                    <searchpanel>
                        <field name="type_id" enable_counters="1" />
                        <field name="age_range_id" enable_counters="1" icon="fa-birthday-cake" />
                        <field name="family_relation" enable_counters="1" icon="fa-heart" />
                    </searchpanel>
                </search>
            </xpath>
        </field>
    </record>
    <record id="ni_patient_view_form_inherit" model="ir.ui.view">
        <field name="name">ni.patient.view.form.inherit</field>
        <field name="model">ni.patient</field>
        <field name="inherit_id" ref="ni_patient.ni_patient_view_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="type_id" widget="radio" />
            </field>
            <field name="father_name" position="before">
                <field name="family_count" />
                <field name="family_relation" />
            </field>
        </field>
    </record>
    <record id="ni_patient_view_tree_inherit" model="ir.ui.view">
        <field name="name">ni.patient.view.tree.inherit</field>
        <field name="model">ni.patient</field>
        <field name="inherit_id" ref="ni_patient.ni_patient_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="js_class">patient_dashboard_tree</attribute>
            </xpath>
        </field>
    </record>
    <record id="ni_patient_view_kanban_simp" model="ir.ui.view">
        <field name="name">ni.patient.view.kanban.simp</field>
        <field name="model">ni.patient</field>
        <field name="arch" type="xml">
            <kanban
                class="o_res_partner_kanban"
                default_order="create_date desc"
                js_class="patient_dashboard_kanban"
                limit="16"
            >
                <field name="id" />
                <field name="name" />
                <field name="create_date" />
                <field name="identifier" />
                <field name="age" />
                <field name="gender" />
                <field name="active" />
                <field name="deceased" />
                <field name="deceased_date" />
                <field name="partner_id" />
                <field name="presence_state" />
                <field name="encounter_id" />
                <field name="is_encountering" />
                <field name="location_id" />
                <field name="image_128" />
                <field name="type_decoration" />
                <field name="identification_id" />
                <field name="type_id" />
                <field name="type_name" />
                <field name="heal_progress" />
                <field name="soci_progress" />
                <field name="econ_progress" />
                <field name="envi_progress" />
                <field name="tech_progress" />
                <progressbar
                    field="type_name"
                    colors='{"ติดสังคม": "success", "ติดบ้าน": "warning", "ติดเตียง": "danger"}'
                />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban kanban_ribbon_card"
                        >
                            <widget
                                name="web_ribbon"
                                attrs="{'invisible': [('deceased', '=', False)]}"
                                bg_color="bg-dark"
                                title="เสียชีวิต"
                            />
                            <widget
                                name="web_ribbon"
                                attrs="{'invisible': ['|', ('active', '=', True), ('deceased', '=', True)]}"
                                bg_color="bg-danger"
                                title="ลบชั่วคราว"
                            />
                            <field
                                name="image_256"
                                class="o_kanban_image_fill_left d-block"
                                preview_image="image_128"
                                widget="background_image"
                                options="{'zoom': true, 'zoom_delay': 1000}"
                                loading="lazy"
                            />
                            <div class="oe_kanban_details">
                                <div name="kanban_top" class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <span class="o_kanban_record_title fs-2">
                                            <field name="name" placeholder="Patient's Name" />
                                        </span>
                                    </div>
                                </div>
                                <field
                                    name="type_id"
                                    widget="badge"
                                    decoration-primary="type_decoration == 'primary'"
                                    decoration-success="type_decoration == 'success'"
                                    decoration-info="type_decoration == 'info'"
                                    decoration-warning="type_decoration == 'warning'"
                                    decoration-danger="type_decoration == 'danger'"
                                    decoration-muted="type_decoration == 'muted'"
                                />
                                <field
                                    name="condition_ids"
                                    widget="many2many_tags"
                                    options="{'color_field': 'color'}"
                                />
                                <ul class="mt-2">
                                    <li
                                        t-if="record.gender.value or record.age.value &gt; 0 or record.gender.raw_value"
                                    >
                                        <field name="function" class="me-1" />
                                        <field name="gender" />
                                        <t t-if="record.age.value &gt; 0">
                                            <t t-if="record.gender.value">,</t>
                                            <field name="age" class="me-1" />
                                            <span>ปี</span>
                                        </t>
                                        <t t-if="record.deceased_date.value">
                                            <span class="ms-1">
                                                (เสียชีวิตเมื่อ
                                                <field name="deceased_date" />
                                                )
                                            </span>
                                        </t>
                                    </li>
                                    <li t-if="context.show_deceased and record.deceased_date.value">
                                        <span>Deceased:</span>
                                        <field name="deceased_date" />
                                    </li>
                                    <li>
                                        <span class="fw-bold small">สถานะบริบาลคุ้มครอง 5 มิติ</span>
                                    </li>
                                    <li>
                                        <div class="progress" style="height: 1.5rem">
                                            <div
                                                class="progress-bar bg-primary"
                                                role="progressbar"
                                                t-attf-style="width: {{ (record.heal_progress.raw_value) ? '17%' : '0%'}}"
                                                aria-valuenow="15"
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                            >
                                                สุขภาพ
                                            </div>
                                            <div
                                                class="progress-bar bg-danger"
                                                role="progressbar"
                                                t-attf-style="width: {{ (record.soci_progress.raw_value == true) ? '15%' : '0%'}}"
                                                aria-valuenow="15"
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                            >
                                                สังคม
                                            </div>
                                            <div
                                                class="progress-bar bg-warning"
                                                role="progressbar"
                                                t-attf-style="width: {{ (record.econ_progress.raw_value == true) ? '20%' : '0%'}}"
                                                aria-valuenow="30"
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                            >
                                                เศรษฐกิจ
                                            </div>
                                            <div
                                                class="progress-bar bg-success"
                                                role="progressbar"
                                                t-attf-style="width: {{ (record.envi_progress.raw_value == true) ? '25%' : '0%'}}"
                                                aria-valuenow="20"
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                            >
                                                สิ่งแวดล้อม
                                            </div>
                                            <div
                                                class="progress-bar bg-info"
                                                role="progressbar"
                                                t-attf-style="width: {{ (record.tech_progress.raw_value == true) ? '23%' : '0%'}}"
                                                aria-valuenow="20"
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                            >
                                                เทคโนโลยี
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_patient_view_form_simp" model="ir.ui.view">
        <field name="name">ni.patient.view.form.simp</field>
        <field name="model">ni.patient</field>
        <field name="priority" eval="30" />
        <field name="arch" type="xml">
            <form duplicate="0" create="0" js_class="ni_patient_form">
                <field name="id" invisible="1" />
                <field name="deceased" invisible="1" />
                <field name="deceased_date" invisible="1" />
                <field name="is_encountering" invisible="1" />
                <field name="active" invisible="1" />
                <field name="presence_state" invisible="1" />
                <field name="identifier" invisible="1" />
                <header class="oe_read_only" />
                <sheet>
                    <div name="button_box" attrs="{'invisible': [('id', '=', False)]}" class="oe_button_box" />
                    <field name="image_1920" class="oe_avatar" options='{"preview_image":"image_128"}' widget='image' />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('deceased', '=', False)]}"
                        bg_color="bg-dark"
                        title="เสียชีวิต"
                    />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': ['|', ('active', '=', True), ('deceased', '=', True)]}"
                        bg_color="bg-danger"
                        title="ลบชั่วคราว"
                    />
                    <div class="oe_title">
                        <label for="identification_id" />
                        <h1>
                            <field name="identification_id" placeholder="X-XXXX-XXXX-XX-X" class="oe_edit_only" />
                            <field
                                name="display_identification_id"
                                class="oe_read_only"
                                placeholder="ไม่ระบุเลขประจำตัวประชาชน"
                            />
                        </h1>
                        <group>
                            <field
                                name="title"
                                options="{'no_open': True, 'no_create': True}"
                                placeholder="นาย, นาง, น.ส."
                            />
                            <field name="name" placeholder="Patient's Name" required="True" string="ชื่อ-นามสกุล" />
                        </group>
                        <field
                            name="type_id"
                            widget="badge"
                            decoration-primary="type_decoration == 'primary'"
                            decoration-success="type_decoration == 'success'"
                            decoration-info="type_decoration == 'info'"
                            decoration-warning="type_decoration == 'warning'"
                            decoration-danger="type_decoration == 'danger'"
                            decoration-muted="type_decoration == 'muted'"
                        />
                        <field name="type_decoration" invisible="1" />
                        <label for="register_date" />
                        <div class="col-12 col-xl-6">
                            <separator string="การยินยอมรับบริการ" colspan="2" />
                            <div class="o_row">
                                <field name="is_accept_service" />
                                <p>ยินยอมรับบริการจากผู้บริบาลคุ้มครองสิทธิผู้สูงอายุ</p>
                            </div>
                            <div class="o_row">
                                <field name="is_allow_photo" attrs="{'readonly': [('is_accept_service','=',False)]}" />
                                <p>ยินยอมให้ถ่ายภาพระหว่างให้บริการ</p>
                            </div>
                        </div>
                        <field name="register_date_editable" invisible="1" />
                        <group
                            class="mt-4"
                            attrs="{'invisible': ['|', ('register_date_editable', '=', False),('is_accept_service', '=', False)]}"
                        >
                            <field
                                name="register_date"
                                attrs="{
                                   'readonly': [('register_date_change', '=', False)],
                                   'required': [('register_date_change', '=', True)]
                                   }"
                            />
                            <field name="register_date_change" />
                        </group>
                    </div>
                    <notebook attrs="{'invisible': [('is_accept_service','=',False)]}">
                        <page name="personal" string="ข้อมูลส่วนบุคคล" icon="fa-address-book-o">
                            <group>
                                <group name="personal" string="ข้อมูลส่วนบคคล">
                                    <field name="gender" widget="radio" options="{'horizontal': True}" />
                                    <field name="birthdate" />
                                    <field name="deceased" invisible="1" />
                                    <field name="deceased_date" attrs="{'invisible': [('deceased', '=', False)]}" />
                                    <label for="age" string="อายุ" />
                                    <div class="o_row">
                                        <field name="age" class="o_narrow_field" />
                                        <span class="mx-2">ปี</span>
                                        <field name="age_range_id" groups="base.group_no_one" />
                                    </div>
                                    <field
                                        name="nationality_id"
                                        options="{'no_create': True, 'no_open':True}"
                                        invisible="1"
                                    />
                                    <field
                                        name="nationality_id"
                                        options="{'no_create': True, 'no_open':True}"
                                        groups="base.group_no_one"
                                    />
                                    <field name="religion_id" options="{'no_create': True, 'no_open':True}" />
                                    <field name="function" string="อาชีพ" />
                                </group>
                                <group name="partner" string="การติดต่อ">
                                    <field name="phone" widget="phone" />
                                    <field name="mobile" widget="phone" />
                                    <field name="email" widget="email" />
                                    <field name="line" />
                                </group>
                                <group string="ที่อยู่ปัจจุบัน">
                                    <label name="address_name" for="street" string="ที่อยู่ปัจจุบัน" />
                                    <div class="o_address_format">
                                        <field
                                            name="street"
                                            class="o_address_street"
                                            placeholder="บ้านเลขที่ หมู่ ซอย ถนน..."
                                        />
                                        <field
                                            name="zip_id"
                                            options="{'create_name_field': 'city', 'no_open': True, 'no_create': True}"
                                            domain="[('city_id', 'in', user_city_ids)]"
                                            placeholder="ค้นหาด้วย รหัสไปษญีย์หรือชื่อตำบล/อำเภอ/จังหวัด..."
                                            string="ตำบล/อำเภอ/จังหวัด"
                                            required="1"
                                        />
                                        <span
                                            class="text-danger"
                                            attrs="{'invisible': [('user_city_ids', '!=', False)]}"
                                        >
                                            บัญชีผู้ใช้งานของท่านยังไม่มีข้อมูลพื้นที่รับผิดชอบ กรุณาติดต่อผู้ดูแลระบบ
                                        </span>
                                        <field name="city" invisible="1" />
                                        <field name="state_id" invisible="1" />
                                        <field name="zip" invisible="1" />
                                        <field name="country_id" invisible="1" />
                                        <field name="user_city_ids" invisible="1" />
                                    </div>
                                    <field name="sub_district_code" groups="base.group_no_one" />
                                    <!--                                    <field-->
                                    <!--                                        name="other_address_id"-->
                                    <!--                                        placeholder="เช่น ที่อยู่ปัจจุบัน, ที่อยู่บุตรหลาน"-->
                                    <!--                                        options="{'always_reload':True, 'no_quick_create': True}"-->
                                    <!--                                        context="{'form_view_ref': 'base.res_partner_view_form_private', 'default_type': 'private', 'default_name': 'Home Address', 'show_address': True, 'show_name': False, 'no_bank':True, 'default_ref': identifier}"-->
                                    <!--                                    />-->
                                </group>
                                <group name="family" string="ครอบครัว">
                                    <field name="marital_status" />
                                    <field
                                        name="spouse_name"
                                        attrs="{'invisible':[('marital_status', '=', 'single')]}"
                                    />
                                    <field name="family_count" />
                                    <field name="family_relation" widget="radio" />
                                </group>
                                <group string="ปัจจุบันผู้สูงอายุอาศัยอยู่กับ">
                                    <field
                                        name="living_with_ids"
                                        widget="many2many_checkboxes"
                                        nolabel="1"
                                        colspan="2"
                                    />
                                    <field name="living_with_other" placeholder="อื่นๆ..." nolabel="1" colspan="2" />
                                </group>
                                <group name="related_person" string="ผู้ดูแลหลัก">
                                    <field name="related_person_ids" mode="kanban" string="ผู้ดูแลหลัก" />
                                </group>
                                <group name="encounter" invisible="1">
                                    <field
                                        name="partner_id"
                                        attrs="{'readonly':[('id', '!=', False)], 'invisible': [('id', '!=', False)]}"
                                        options='{"always_reload": True, "no_create": True}'
                                        required="False"
                                        placeholder="from Contacts..."
                                    />
                                    <field
                                        name="partner_id"
                                        groups="base.group_no_one"
                                        attrs="{'invisible': [('id', '=', False)]}"
                                        options='{"always_reload": True, "no_create": True}'
                                        readonly="True"
                                        required="False"
                                    />
                                    <field name="company_id" invisible="1" />
                                    <field
                                        name="company_id"
                                        groups="base.group_multi_company"
                                        options="{'no_create': True, 'no_open':True}"
                                    />
                                    <field
                                        name="encounter_id"
                                        attrs="{'invisible': [('is_encountering', '=', False)]}"
                                        context="{'show_state': True, 'show_location': True}"
                                        options='{"always_reload": True}'
                                    />
                                </group>
                                <group
                                    name="archive_state"
                                    string="สถานะเมื่อสิ้นสุดการดูแล"
                                    attrs="{'invisible': [('active', '=', True)]}"
                                >
                                    <field
                                        name="state_reason_id"
                                        options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                                    />
                                    <field name="state_note" />
                                    <field name="state_date" />
                                </group>
                            </group>
                        </page>
                        <page name="health" string="ข้อมูลสุขภาพ" icon="fa-thermometer-half">
                            <group>
                                <group string="ข้อมูลสุขภาพ">
                                    <field
                                        name="type_id"
                                        widget="radio"
                                        options="{'horizontal': True}"
                                        groups="base.group_no_one"
                                    />
                                    <label for="blood_abo" string="หมู่เลือด" />
                                    <div class="o_row">
                                        <field
                                            name="blood_abo"
                                            class="abo_field"
                                            placeholder="ABO"
                                            options="{'no_open': True, 'no_create': True, }"
                                        />
                                        <field
                                            name="blood_rh"
                                            class="abo_field"
                                            placeholder="RH"
                                            context="{'only_abbr':True}"
                                            options="{'no_open': True,  'no_create': True, 'always_reload':True}"
                                        />
                                    </div>
                                    <label for="allergy_code_ids" string="แพ้ยา/อาหาร" />
                                    <div>
                                        <field name="allergy_code_ids" widget="many2many_checkboxes" class="mt-3" />
                                        <field name="allergy_other" placeholder="แพ้ยาอาหารอื่นๆ..." />
                                    </div>
                                    <field name="chronic_disease" widget="radio" options="{'horizontal': True}" />
                                    <field
                                        name="chronic_disease_detail"
                                        attrs="{'invisible':[('chronic_disease','!=','has')]}"
                                    />
                                </group>
                                <group string="ปัญหา">
                                    <label for="condition_code_ids" string="ปัญหา" />
                                    <div>
                                        <field
                                            name="condition_categ_id"
                                            widget="radio"
                                            options="{'horizontal': True}"
                                        />
                                        <field
                                            name="condition_code_ids"
                                            widget="many2many_checkboxes"
                                            class="mt-3"
                                            domain="[('category_id', '=', condition_categ_id)]"
                                        />
                                    </div>
                                    <field name="condition_other" placeholder="ปัญหาอื่นๆ..." />
                                    <field name="plan" />
                                </group>
                            </group>
                        </page>
                        <page name="benefit" string="สิทธิผู้สูงอายุ &amp; ความต้องการผู้สูงอายุ" icon="fa-shield">
                            <div class="row">
                                <div class="col-12 col-xl-6">
                                    <separator string="สิทธิผู้สูงอายุ" />
                                    <field name="benefit_ids" widget="many2many_checkboxes" />
                                    <field name="benefit_count" invisible="1" />
                                </div>
                                <div class="col-12 col-xl-6">
                                    <separator string="สิทธิของบุคคลในครอบครัว" />
                                    <field name="relative_benefit_ids" widget="many2many_checkboxes" />
                                    <field name="relative_benefit_count" invisible="1" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-xl-6">
                                    <separator string="สิทธิการรักษาพยาบาล" />
                                    <field name="coverage_type_id" widget="radio" />
                                </div>
                                <div class="col-12 col-xl-6">
                                    <separator string="ความต้องการของผู้สูงอายุ" />
                                    <field name="need_ids" widget="many2many_checkboxes" />
                                    <field name="need_count" invisible="1" />
                                    <field name="need_other" placeholder="ความต้องการอื่นๆ..." />
                                    <br />
                                    <button
                                        name="action_patient_need"
                                        type="object"
                                        string="View need"
                                        groups="base.group_no_one"
                                    />
                                </div>
                            </div>
                        </page>
                        <page name="observation" string="ผลการประเมินผล" icon="fa-stethoscope">
                            <div class="row">
                                <div class="col-12 col-lg-9">
                                    <field
                                        name="observation_category_id"
                                        class="mt-2"
                                        widget="radio"
                                        options="{'horizontal': True}"
                                    />
                                </div>
                            </div>
                            <field name="filtered_patient_observation_ids" />
                            <button
                                name="action_survey_subject"
                                type="object"
                                string="ทำแบบประเมิน"
                                class="btn-primary"
                                icon="fa-stethoscope"
                                context="{'default_patient_id': id, 'default_category_id': observation_category_id}"
                            />
                        </page>
                        <page name="plan" string="แผนการให้ความช่วยเหลือ" badge="careplan_count" icon="fa-tasks">
                            <field name="careplan_count" invisible="1" />
                            <field name="careplan_ids" context="{'default_patient_id': id}" />
                        </page>
                        <page
                            name="service"
                            string="กิจกรรมการดูแลผู้สูงอายุ"
                            icon="fa-life-ring"
                            badge="service_event_count"
                        >
                            <div>
                                <button
                                    name="action_view_service_event"
                                    type="object"
                                    class="btn-primary my-2"
                                    string=" กิจกรรมการดูแลผู้สูงอายุ +"
                                    icon="fa-tasks"
                                    attrs="{'invisible': ['|', ('deceased', '=', True), ('type_id', '=', False)]}"
                                />
                                <p class="text-muted" attrs="{'invisible': [('type_id', '!=', False)]}">
                                    กรุณาทำการประเมิน ADL ก่อนทำการบันทึกกิจกรรมการดูแลผู้สูงอายุ
                                </p>
                            </div>
                            <label
                                for="service_event_ids"
                                string="ประวัติการทำกิจกรรม"
                                class="mt-4 text-black fw-bold"
                            />
                            <field name="service_event_count" invisible="1" />
                            <field name="service_event_ids">
                                <tree>
                                    <field name="start" string="วันที่" widget="remaining_days" class="text-body" />
                                    <field
                                        name="service_category_ids"
                                        string="มิติ"
                                        optional="show"
                                        widget="many2many_tags"
                                        options="{'color_field': 'color'}"
                                    />
                                    <field name="name" string="กิจกรรม" />
                                    <field name="user_name" string="ชื่อ-นามสกุลผู้บริบาล" optional="show" />
                                    <field
                                        name="user_id"
                                        string="บัญชีผู้บริบาล"
                                        widget="many2one_avatar_user"
                                        optional="hide"
                                    />
                                    <field name="satisfaction_level" optional="hide" />
                                </tree>
                                <kanban>
                                    <field name="name" />
                                    <field name="service_category_id" />
                                    <field name="start" />
                                    <field name="color" />
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div
                                                t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_card oe_kanban_global_click"
                                            >
                                                <div class="oe_kanban_content">
                                                    <div class="o_kanban_record_top">
                                                        <div class="o_kanban_record_headings">
                                                            <div>
                                                                <field
                                                                    name="service_category_ids"
                                                                    widget="many2many_tags"
                                                                    options="{'color_field': 'color'}"
                                                                />
                                                            </div>
                                                        </div>
                                                        <div
                                                            class="o_dropdown_kanban dropdown"
                                                            t-if="!selection_mode"
                                                            groups="base.group_user"
                                                        >
                                                            <a
                                                                role="button"
                                                                class="dropdown-toggle o-no-caret btn"
                                                                data-bs-toggle="dropdown"
                                                                data-bs-display="static"
                                                                href="#"
                                                                aria-label="Dropdown menu"
                                                                title="Dropdown menu"
                                                            >
                                                                <span class="fa fa-ellipsis-v" />
                                                            </a>
                                                            <div class="dropdown-menu" role="menu">
                                                                <a
                                                                    t-if="widget.editable"
                                                                    role="menuitem"
                                                                    type="edit"
                                                                    class="dropdown-item"
                                                                >
                                                                    Edit
                                                                </a>
                                                                <div role="separator" class="dropdown-divider" />
                                                                <ul class="oe_kanban_colorpicker" data-field="color" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <field name="name" />
                                                    <div class="o_kanban_record_body mt-2">
                                                        <div class="small text-muted">
                                                            <i
                                                                class="fa fa-clock-o me-1"
                                                                aria-hidden="true"
                                                                title="start"
                                                            />
                                                            <field name="start" widget="remaining_days" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <group>
                                            <field
                                                name="service_category_ids"
                                                string="มิติ"
                                                optional="show"
                                                widget="many2many_tags"
                                                options="{'color_field': 'color'}"
                                            />
                                        </group>
                                        <group>
                                            <field name="start" />
                                        </group>
                                    </group>
                                    <group>
                                        <field name="name" string="กิจกรรม" />
                                        <field name="plan_patient_count" invisible="1" />
                                        <field
                                            name="plan_patient_ids"
                                            widget="many2many_tags_avatar"
                                            attrs="{'invisible': [('plan_patient_count', '&lt;', 2)]}"
                                        />
                                        <field name="user_id" string="ผู้บริบาล" widget="many2one_avatar_user" />
                                    </group>
                                    <group>
                                        <field
                                            name="satisfaction_level"
                                            widget="radio"
                                            class="satisfaction-radio"
                                            options="{'horizontal': True}"
                                            attrs="{'invisible': [('satisfaction_level', '=', False)]}"
                                        />
                                    </group>
                                    <div class="row mt-4">
                                        <div class="col-12 col-lg-6">
                                            <field
                                                name="image_1"
                                                widget="image"
                                                attrs="{'invisible': [('image_1', '=', False)]}"
                                            />
                                        </div>
                                        <div class="col-12 col-lg-6">
                                            <field
                                                name="image_2"
                                                widget="image"
                                                attrs="{'invisible': [('image_2', '=', False)]}"
                                            />
                                        </div>
                                    </div>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_patient_action" model="ir.actions.act_window">
        <field name="name">ทะเบียนผู้สูงอายุ ผศ.01</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.patient</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_create_date': 1}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
               (0, 0, {'view_mode': 'kanban', 'view_id': ref('ni_patient_view_kanban_simp')}),
               (0, 0, {'view_mode': 'tree', 'view_id': ref('ni_patient.ni_patient_view_tree')}),
               (0, 0, {'view_mode': 'form', 'view_id': ref('ni_patient_view_form_simp')}),
               ]"
        />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">ไม่พบผู้สูงอายุ</p>
            <p>

            </p>
        </field>
    </record>
</odoo>
