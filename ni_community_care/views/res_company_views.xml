<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_view_form_inherit" model="ir.ui.view">
        <field name="name">res.view.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="service_event" string="การบันทึกกิจกรรมของผู้บริบาล">
                    <group string="การบันทึกกิจกรรมย้อนกรรมย้อนหลัง">
                        <field name="system_start_date" widget="datetime" />
                        <field name="backdate_limit_days" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
