<odoo>
    <!-- ============================================================
         Report Action
         ============================================================ -->
    <record id="service_event_approval_03_service_action_report" model="ir.actions.report">
        <field name="name">กิจกรรมพัฒนาคุณภาพชีวิตผู้สูงอายุ (รายกิจกรรม/โครงการ) ศผ.03</field>
        <field name="model">ni.service.event.approval</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ni_community_care.service_event_approval_service_report_template</field>
        <field name="report_file">ni_community_care.service_event_approval_service_report_template</field>
        <field name="print_report_name">
            ("%s_report_กิจกรรมพัฒนาคุณภาพชีวิตผู้สูงอายุ (รายกิจกรรม/โครงการ) ศผ.03" % (object.name))
        </field>
        <field name="binding_model_id" ref="model_ni_service_event_approval" />
        <field name="binding_type">report</field>
        <field name="binding_view_types">form</field>
        <field name="paperformat_id" ref="report_paperformat_a4_landscape" />
    </record>
    <!-- ============================================================
         Main Report Template
         ============================================================ -->
    <template id="service_event_approval_service_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="d">
                <t t-set="lang_id" t-value="request.env['res.lang'].search([('code', '=', user.lang)], limit=1)" />
                <t t-set="services" t-value="d.service_ids" />
                <t t-if="d.service_count > 0">
                    <!-- หน้า 1: ตารางสรุปกิจกรรมทั้งหมด -->
                    <t t-call="web.external_layout">
                        <div class="page">
                            <t t-call="ni_community_care.service_event_approval_title_template">
                                <t
                                    t-set="report_title"
                                    t-value="'กิจกรรมพัฒนาคุณภาพชีวิตผู้สูงอายุ (รายกิจกรรม/โครงการ)'"
                                />
                                <t t-set="report_form_code" t-value="'แบบ ศผ.03'" />
                            </t>
                            <t t-call="ni_community_care.service_event_approval_service_summary_table_template">
                                <t t-set="service_list" t-value="services" />
                            </t>
                        </div>
                        <p style="page-break-after: always;" />
                    </t>
                    <!-- หน้าถัดไป: รายละเอียดแต่ละกิจกรรม + รายชื่อผู้สูงอายุ -->
                    <t t-foreach="services" t-as="s">
                        <t t-call="web.external_layout">
                            <div class="page">
                                <t t-call="ni_community_care.service_event_approval_title_template">
                                    <t
                                        t-set="report_title"
                                        t-value="'กิจกรรมพัฒนาคุณภาพชีวิตผู้สูงอายุ (รายกิจกรรม/โครงการ)'"
                                    />
                                    <t t-set="report_form_code" t-value="'แบบ ศผ.03'" />
                                </t>
                                <t t-call="ni_community_care.service_event_approval_service_summary_table_template">
                                    <t t-set="service_list" t-value="s" />
                                </t>
                                <!-- รายชื่อผู้สูงอายุที่ร่วมกิจกรรม -->
                                <t t-if="s.event_ids">
                                    <div class="mt-3">
                                        <strong>รายชื่อผู้สูงอายุร่วมกิจกรรมพัฒนาคุณภาพชีวิตผู้สูงอายุ</strong>
                                    </div>
                                    <table class="table table-condensed mt-2">
                                        <thead>
                                            <tr>
                                                <th>วันที่</th>
                                                <th>ลำดับ</th>
                                                <th>ชื่อ/นามสกุลผู้สูงอายุ</th>
                                                <th>อายุ</th>
                                                <th class="text-start">เบอร์โทรศัพท์</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="s.event_ids" t-as="e" t-if="e.user_id.id == user.id">
                                                <t t-set="i" t-value="1" />
                                                <t t-foreach="e.plan_patient_ids" t-as="p">
                                                    <tr>
                                                        <td t-att-rowspan="len(e.plan_patient_ids)" t-if="p_first">
                                                            <span
                                                                t-esc="context_timestamp(e.start).strftime(lang_id.date_format)"
                                                            />
                                                        </td>
                                                        <td>
                                                            <span t-esc="i" />
                                                        </td>
                                                        <td>
                                                            <span t-esc="p.display_name" />
                                                        </td>
                                                        <td>
                                                            <span t-esc="p.age" />
                                                        </td>
                                                        <td>
                                                            <span t-field="p.mobile" t-if="p.mobile" />
                                                            <span t-field="p.phone" t-else="" />
                                                        </td>
                                                        <t t-set="i" t-value="i + 1" />
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                            <p style="page-break-after: always;" />
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <!-- ไม่มีข้อมูลกิจกรรม -->
                    <t t-call="web.external_layout">
                        <t t-call="ni_community_care.service_event_approval_title_template">
                            <t
                                t-set="report_title"
                                t-value="'กิจกรรมพัฒนาคุณภาพชีวิตผู้สูงอายุ (รายกิจกรรม/โครงการ)'"
                            />
                            <t t-set="report_form_code" t-value="'แบบ ศผ.03'" />
                        </t>
                        <t t-call="ni_community_care.service_event_approval_no_data_template" />
                    </t>
                </t>
            </t>
        </t>
    </template>
    <!-- ============================================================
         Service Summary Table Template
         ตารางกิจกรรมพัฒนาคุณภาพชีวิต ใช้ซ้ำในหน้าสรุปและหน้ารายละเอียด

         ตัวแปรที่ต้อง set ก่อนเรียก:
           - service_list  (recordset หรือ record เดี่ยว)  รายการกิจกรรม
         ============================================================ -->
    <template id="service_event_approval_service_summary_table_template">
        <div class="mt-4">
            <strong>กิจกรรมพัฒนาคุณภาพชีวิตผู้สูงอายุ</strong>
            <span>(มิติด้านสังคม สุขภาพ เศรษฐกิจ สภาพแวดล้อม เทคโนโลยี)</span>
        </div>
        <table class="table table-condensed mt-2">
            <thead>
                <tr>
                    <th class="text-start">ชื่อโครงการ/กิจกรรม</th>
                    <th class="text-start">มิติ</th>
                    <th class="text-start">วัตถุประสงค์</th>
                    <th class="text-start">วิธีการ/ขั้นตอนการดำเนินงาน</th>
                    <th class="text-start" colspan="2">กลุ่มเป้าหมาย (ประเภท/จำนวน)</th>
                    <th class="text-start">ประโยชน์ที่ได้รับ</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="service_list" t-as="s">
                    <tr>
                        <td>
                            <span t-esc="s.name or '-'" />
                        </td>
                        <td>
                            <span t-esc="s.category_id.name if s.category_id else '-'" />
                        </td>
                        <td>
                            <span t-esc="s.objective or '-'" />
                        </td>
                        <td>
                            <span t-esc="s.procedure or '-'" />
                        </td>
                        <td>
                            <span
                                t-esc="', '.join([t.name for t in s.target_type_ids if t]) if s.target_type_ids else '-'"
                            />
                        </td>
                        <td>
                            <span t-esc="s.target or '-'" />
                        </td>
                        <td>
                            <span t-esc="s.benefit or '-'" />
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>
</odoo>
