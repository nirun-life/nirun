<odoo>
    <!-- ============================================================
         Report Actions
         ============================================================ -->
    <record id="service_event_approval_02_category_action_report" model="ir.actions.report">
        <field name="name">ผลการปฏิบัติงานดูแลผู้สูงอายุ ศผ.02</field>
        <field name="model">ni.service.event.approval</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ni_community_care.approval_category_report_template_ui</field>
        <field name="report_file">ni_community_care.approval_category_report_template</field>
        <field name="print_report_name">("%s_ผลการปฏิบัติงานดูแลผู้สูงอายุ ศผ.02" % (object.name))</field>
        <field name="binding_model_id" ref="ni_community_care.model_ni_service_event_approval" />
        <field name="binding_type">report</field>
        <field name="binding_view_types">form</field>
        <field name="paperformat_id" ref="report_paperformat_a4_landscape" />
        <field name="attachment">(object.name or 'report') + '.pdf'</field>
        <field name="attachment_use">true</field>
    </record>
    <record id="service_event_approval_02_category_action_report_batch" model="ir.actions.report">
        <field name="name">ผลการปฏิบัติงาน ศผ.02 (Batch)</field>
        <field name="model">ni.service.event.approval</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ni_community_care.approval_category_report_template</field>
        <field name="report_file">ni_community_care.approval_category_report_template</field>
        <field name="attachment_use">False</field>
        <field name="paperformat_id" ref="report_paperformat_a4_landscape" />
    </record>
    <!-- ============================================================
         Main Report Template
         ============================================================ -->
    <template id="approval_category_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-set="patient_list"
                    t-value="(data or {}).get('custom_patient_data', []) or o.get_sorted_events()"
                />
                <t t-if="patient_list">
                    <t t-foreach="patient_list" t-as="patient_events">
                        <t t-call="web.external_layout">
                            <t
                                t-set="lang_id"
                                t-value="env['res.lang'].search([('code', '=', env.user.lang)], limit=1)"
                            />
                            <!-- ส่วนหัว -->
                            <t t-call="ni_community_care.service_event_approval_title_template">
                                <t t-set="report_title" t-value="'รายงานผลการปฏิบัติงานการดูแลผู้สูงอายุ (รายบุคคล)'" />
                                <t t-set="report_form_code" t-value="'แบบ ศผ.02'" />
                            </t>
                            <!-- ข้อมูลผู้สูงอายุ -->
                            <t t-set="p" t-value="patient_events[0]" />
                            <t t-call="ni_community_care.service_event_approval_patient_info_template" />
                            <!-- ตารางกิจกรรม -->
                            <table
                                class="table table-condensed mt-4"
                                style="font-size: 14px; table-layout: fixed; width: 100%;"
                            >
                                <thead>
                                    <tr>
                                        <th class="text-start" style="width:10%">วันที่</th>
                                        <th class="text-start" style="width:8%">มิติ</th>
                                        <th class="text-start" style="width:30%">
                                            วิธีการหรือบริการให้ความช่วยเหลือดูแล
                                        </th>
                                        <th class="text-start" style="width:7%">
                                            เวลา
                                            <br />
                                            เริ่ม
                                        </th>
                                        <th class="text-start" style="width:7%">
                                            เวลา
                                            <br />
                                            เลิก
                                        </th>
                                        <th class="text-start" style="width:6%">
                                            รวม
                                            <br />
                                            (ชั่วโมง)
                                        </th>
                                        <th class="text-start" style="width:32%">ผลการให้ความช่วยเหลือ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="patient_events[1]" t-as="d">
                                        <tr>
                                            <td style="word-wrap: break-word">
                                                <span
                                                    t-esc="context_timestamp(d.start).strftime(lang_id.date_format)"
                                                />
                                            </td>
                                            <td style="word-wrap: break-word">
                                                <span t-esc="d.service_category_id.name" />
                                            </td>
                                            <td style="word-wrap: break-word">
                                                <span t-esc="d.name" />
                                            </td>
                                            <td>
                                                <span
                                                    t-esc="context_timestamp(d.start).strftime(lang_id.time_format)"
                                                />
                                            </td>
                                            <td>
                                                <span t-esc="context_timestamp(d.stop).strftime(lang_id.time_format)" />
                                            </td>
                                            <td>
                                                <span t-esc="'%.2f' % d.duration" />
                                            </td>
                                            <td style="word-wrap: break-word">
                                                <span t-out="d.outcome" />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <p style="page-break-after: always;" />
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <t t-call="web.external_layout">
                        <t t-call="ni_community_care.service_event_approval_title_template">
                            <t t-set="report_title" t-value="'รายงานผลการปฏิบัติงานการดูแลผู้สูงอายุ (รายบุคคล)'" />
                            <t t-set="report_form_code" t-value="'แบบ ศผ.02'" />
                        </t>
                        <t t-call="ni_community_care.service_event_approval_no_data_template" />
                    </t>
                </t>
            </t>
        </t>
    </template>
    <template id="approval_category_report_template_ui" inherit_id="approval_category_report_template" />
</odoo>
