<!--
  ================================================================
  SHARED TEMPLATES — ใช้ร่วมกันได้ทุก report
  ================================================================

  1. service_event_approval_title_template
     ส่วนหัวรายงาน (ชื่อ + รหัสแบบฟอร์ม + ผู้บริบาล + พื้นที่ + ระยะเวลา)

     ตัวแปรที่ต้อง set ก่อนเรียก:
       - report_title     (str)  ชื่อรายงาน เช่น "แผนการให้ความช่วยเหลือดูแลผู้สูงอายุ"
       - report_form_code (str)  รหัสแบบฟอร์ม เช่น "แบบ ศผ.04"

     ตัวอย่าง:
       <t t-call="ni_community_care.service_event_approval_title_template">
           <t t-set="report_title"     t-value="'ชื่อรายงาน'" />
           <t t-set="report_form_code" t-value="'แบบ ศผ.0X'" />
       </t>

  ================================================================

  2. service_event_approval_patient_info_template
     แถบข้อมูลผู้สูงอายุ (ชื่อ อายุ เพศ ที่อยู่ เบอร์ สถานะสุขภาพ)

     ตัวแปรที่ต้อง set ก่อนเรียก:
       - p  (record)  record ของผู้สูงอายุ (ni.patient หรือ compatible)

     ตัวอย่าง:
       <t t-set="p" t-value="patient_record" />
       <t t-call="ni_community_care.service_event_approval_patient_info_template" />

  ================================================================

  3. service_event_approval_no_data_template
     หน้าว่าง "ไม่มีข้อมูลสำหรับพิมพ์" กึ่งกลางหน้า

     ไม่มีตัวแปรเพิ่มเติม เรียกใช้ตรงได้เลย:
       <t t-call="ni_community_care.service_event_approval_no_data_template" />

  ================================================================
-->
<odoo>
    <!-- ============================================================
         [SHARED] Title Template
         ส่วนหัวรายงาน: ชื่อ + รหัสแบบฟอร์ม + ผู้บริบาล + พื้นที่ + ระยะเวลา
         ============================================================ -->
    <template id="service_event_approval_title_template">
        <div class="oe_structure" />
        <h2 name="title">
            <span>
                <t t-esc="report_title or '-'" />
                -
                <t t-esc="docs.start_month_name" />
                <t t-esc="docs.start_year_thai" />
            </span>
            <small class="text-muted mx-2 border p-1 float-end">
                <t t-esc="report_form_code or '-'" />
            </small>
        </h2>
        <div class="row" id="caregiver_info">
            <div class="col-5">
                <strong>ชื่อ-สกุลผู้บริบาลคุ้มครองสิทธิผู้สูงอายุ:</strong>
                <p class="m-0" t-esc="docs.employee_id.name" />
            </div>
            <div class="col-4">
                <strong>พื้นที่:</strong>
                <p class="m-0" t-esc="', '.join(docs.user_id.city_ids.mapped('display_name'))" />
            </div>
        </div>
        <div class="row" id="period_info">
            <div class="col-5">
                <strong>ระยะเวลา:</strong>
                <p class="m-0">
                    <t t-esc="docs.start.day" />
                    <t t-esc="docs.start_month_name" />
                    <t t-esc="docs.start_year_thai" />
                    -
                    <t t-esc="docs.stop.day" />
                    <t t-esc="docs.stop_month_name" />
                    <t t-esc="docs.stop_year_thai" />
                </p>
            </div>
        </div>
    </template>
    <!-- ============================================================
         [SHARED] Patient Info Template
         แถบข้อมูลผู้สูงอายุ: ชื่อ อายุ เพศ ที่อยู่ เบอร์ สถานะสุขภาพ
         ต้อง set ตัวแปร `p` เป็น record ผู้สูงอายุก่อนเรียก
         ============================================================ -->
    <template id="service_event_approval_patient_info_template">
        <div class="row mt-3 border border-dark border-1 py-2" id="patient_info">
            <div class="col-3">
                <strong>ชื่อ-สกุลผู้สูงอายุ:</strong>
                <p class="m-0" t-field="p.display_name" />
            </div>
            <div class="col-2">
                <strong>อายุ:</strong>
                <p class="m-0">
                    <span t-field="p.age" />
                    <span class="mx-1">ปี</span>
                    <t t-if="p.gender">
                        <strong>เพศ:</strong>
                        <span t-field="p.gender" />
                    </t>
                </p>
            </div>
            <div class="col-4">
                <strong>ที่อยู่:</strong>
                <p class="m-0">
                    <span t-esc="p.partner_id._display_address(True)" />
                </p>
            </div>
            <div class="col-2">
                <strong>เบอร์โทรศัพท์:</strong>
                <p class="m-0">
                    <span t-field="p.mobile" t-if="p.mobile" />
                    <span t-field="p.phone" t-else="" />
                </p>
            </div>
            <div class="col-1">
                <strong>สถานะสุขภาพ:</strong>
                <p class="m-0">
                    <span t-field="p.type_id" />
                </p>
            </div>
        </div>
    </template>
    <!-- ============================================================
         [SHARED] No-Data Template
         แสดงข้อความ "ไม่มีข้อมูลสำหรับพิมพ์" กึ่งกลางหน้า
         ============================================================ -->
    <template id="service_event_approval_no_data_template">
        <div style="margin-top: 200px; text-align: center;">
            <p style="color: #888; font-style: italic; font-weight: 600; margin: 0;">ไม่มีข้อมูลสำหรับพิมพ์</p>
        </div>
    </template>
</odoo>
