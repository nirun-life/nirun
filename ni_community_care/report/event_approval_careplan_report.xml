<odoo>
    <!-- ============================================================
         Report Action
         ============================================================ -->
    <record id="service_event_approval_04_careplan_action_report" model="ir.actions.report">
        <field name="name">แผนการให้ความช่วยเหลือดูแลผู้สูงอายุ ศผ.04</field>
        <field name="model">ni.service.event.approval</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ni_community_care.service_event_approval_careplan_report_template</field>
        <field name="report_file">ni_community_care.service_event_approval_careplan_report_template</field>
        <field name="print_report_name">("%s_report_แผนการให้ความช่วยเหลือดูแลผู้สูงอายุ ศผ.04" % (object.name))</field>
        <field name="binding_model_id" ref="ni_community_care.model_ni_service_event_approval" />
        <field name="binding_type">report</field>
        <field name="binding_view_types">form</field>
        <field name="paperformat_id" ref="report_paperformat_a4_landscape" />
    </record>
    <!-- ============================================================
         Main Report Template
         ============================================================ -->
    <template id="service_event_approval_careplan_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="careplans" t-value="o.get_sorted_careplans()" />
                <t t-if="careplans">
                    <t t-foreach="careplans" t-as="patient_careplans">
                        <t t-call="web.external_layout">
                            <!-- ส่วนหัว -->
                            <t t-call="ni_community_care.service_event_approval_title_04_template" />
                            <!-- ข้อมูลผู้สูงอายุ -->
                            <t t-set="p" t-value="patient_careplans[0]" />
                            <t t-call="ni_community_care.service_event_approval_patient_info_template" />
                            <!-- ตาราง Careplan -->
                            <table class="table table-condensed mt-3">
                                <thead>
                                    <tr>
                                        <th class="text-start">มิติ</th>
                                        <th class="text-start">ประเด็นปัญหา/ความต้องการ</th>
                                        <th class="text-start">เป้าหมาย</th>
                                        <th class="text-start">แผนการให้ความช่วยเหลือ</th>
                                        <th class="text-start">ผลการให้ความช่วยเหลือ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="patient_careplans[1]" t-as="cp">
                                        <tr>
                                            <td t-esc="cp.condition_category_id.name" />
                                            <td>
                                                <span t-esc="cp.problem_text" />
                                            </td>
                                            <td>
                                                <span t-esc="cp.goal_text" />
                                            </td>
                                            <td>
                                                <span t-esc="cp.action_text" />
                                            </td>
                                            <td>
                                                <span t-esc="cp.outcome" />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <p style="page-break-after: always;" />
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <t t-call="web.external_layout">
                        <t t-call="ni_community_care.service_event_approval_title_04_template" />
                        <t t-call="ni_community_care.service_event_approval_no_data_template" />
                    </t>
                </t>
            </t>
        </t>
    </template>
    <!-- ============================================================
         Title Template (ศผ.04) — wrapper สำหรับ shared title template
         ============================================================ -->
    <template id="service_event_approval_title_04_template">
        <t t-call="ni_community_care.service_event_approval_title_template">
            <t t-set="report_title" t-value="'แผนการให้ความช่วยเหลือดูแลผู้สูงอายุ'" />
            <t t-set="report_form_code" t-value="'แบบ ศผ.04'" />
        </t>
    </template>
</odoo>
