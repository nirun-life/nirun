<odoo>
    <record id="ni_cc_report_monthly_company_rule" model="ir.rule">
        <field name="name">Monthly Report: multi-company</field>
        <field name="model_id" ref="model_ni_cc_report_monthly" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ni_serive_user_specify_rule" model="ir.rule">
        <field name="name">Service: User access public or own services</field>
        <field ref="model_ni_service" name="model_id" />
        <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('ni_patient.group_user'))]" />
    </record>
    <record id="ni_serive_admin_rule" model="ir.rule">
        <field name="name">Service: User access public or own services</field>
        <field ref="model_ni_service" name="model_id" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ni_patient.group_admin'))]" />
    </record>
    <record id="ni_service_event_user_rule" model="ir.rule">
        <field name="name">Service Event: User can edit/delete only own</field>
        <field ref="model_ni_service_event" name="model_id" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read">0</field>
        <field name="perm_create">0</field>
        <field name="perm_write">1</field>
        <field name="perm_unlink">1</field>
        <field name="groups" eval="[(4, ref('ni_patient.group_user'))]" />
    </record>
    <record id="ni_service_event_admin_rule" model="ir.rule">
        <field name="name">Service Event: Admin edit all</field>
        <field ref="model_ni_service_event" name="model_id" />
        <field name="domain_force">[(1, '=',1)]</field>
        <field name="perm_read">0</field>
        <field name="perm_create">0</field>
        <field name="perm_write">1</field>
        <field name="perm_unlink">1</field>
        <field name="groups" eval="[(4, ref('ni_patient.group_admin'))]" />
    </record>
    <record id="patient_user_area_rule" model="ir.rule">
        <field name="name">Patient: user see only patient in area</field>
        <field ref="model_ni_patient" name="model_id" />
        <field name="domain_force">[('city_id', 'in', city_ids)]</field>
        <field name="groups" eval="[(4, ref('ni_patient.group_user'))]" />
    </record>
    <record id="patient_admin_area_rule" model="ir.rule">
        <field name="name">Patient: Admin can access all patient</field>
        <field ref="model_ni_patient" name="model_id" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ni_patient.group_admin'))]" />
    </record>
    <record id="patient_area_manager_rule" model="ir.rule">
        <field name="name">Patient: Area Manager can patient is their state</field>
        <field ref="model_ni_patient" name="model_id" />
        <field name="domain_force">[('state_id', 'in', state_ids)]</field>
        <field name="groups" eval="[(4, ref('ni_patient.group_manager'))]" />
    </record>
    <record model="res.groups" id="group_observer">
        <field name="name">Central Observer</field>
        <field name="implied_ids" eval="[(4, ref('ni_patient.group_viewer'))]" />
    </record>
    <record id="patient_observer_area_rule" model="ir.rule">
        <field name="name">Patient: Observer can access all patient</field>
        <field ref="model_ni_patient" name="model_id" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_create">0</field>
        <field name="perm_write">0</field>
        <field name="perm_unlink">0</field>
        <field name="groups" eval="[(4, ref('group_observer'))]" />
    </record>
</odoo>
