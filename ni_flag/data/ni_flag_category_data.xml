<odoo noupdate="1">
    <record id="category_clinical" model="ni.flag.category">
        <field name="name">Clinical</field>
        <field name="code">CL</field>
        <field name="abbr">CL</field>
        <field name="system_id" ref="ni_coding.system_hl7_fhir" />
        <field name="definition">Flags related to the patient's clinical condition or care</field>
        <field name="color">1</field>
    </record>
    <record id="category_administrative" model="ni.flag.category">
        <field name="name">Administrative</field>
        <field name="code">AD</field>
        <field name="abbr">AD</field>
        <field name="system_id" ref="ni_coding.system_hl7_fhir" />
        <field name="definition">Flags related to administrative processes such as billing or consent</field>
        <field name="color">3</field>
    </record>
    <record id="category_behavioral" model="ni.flag.category">
        <field name="name">Behavioral</field>
        <field name="code">BH</field>
        <field name="abbr">BH</field>
        <field name="system_id" ref="ni_coding.system_hl7_fhir" />
        <field name="definition">Flags related to patient behavior or safety concerns</field>
        <field name="color">2</field>
    </record>
    <record id="category_research" model="ni.flag.category">
        <field name="name">Research</field>
        <field name="code">RS</field>
        <field name="abbr">RS</field>
        <field name="system_id" ref="ni_coding.system_hl7_fhir" />
        <field name="definition">Flags related to research studies or clinical trials</field>
        <field name="color">5</field>
    </record>
</odoo>
