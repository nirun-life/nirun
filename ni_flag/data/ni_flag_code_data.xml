<odoo noupdate="1">
    <record id="code_dnr" model="ni.flag.code">
        <field name="name">Do Not Resuscitate</field>
        <field name="code">DNR</field>
        <field name="abbr">DNR</field>
        <field name="system_id" ref="ni_coding.system_internal" />
        <field name="color">1</field>
    </record>
    <record id="code_latex" model="ni.flag.code">
        <field name="name">Latex Allergy</field>
        <field name="code">LATEX</field>
        <field name="abbr">LATEX</field>
        <field name="system_id" ref="ni_coding.system_internal" />
        <field name="color">2</field>
    </record>
    <record id="code_fall" model="ni.flag.code">
        <field name="name">Fall Risk</field>
        <field name="code">FALL</field>
        <field name="abbr">FALL</field>
        <field name="system_id" ref="ni_coding.system_internal" />
        <field name="color">3</field>
    </record>
    <record id="code_interpreter" model="ni.flag.code">
        <field name="name">Interpreter Required</field>
        <field name="code">INTRP</field>
        <field name="abbr">INTRP</field>
        <field name="system_id" ref="ni_coding.system_internal" />
        <field name="color">4</field>
    </record>
    <record id="code_isolation" model="ni.flag.code">
        <field name="name">Isolation Precautions</field>
        <field name="code">ISOL</field>
        <field name="abbr">ISOL</field>
        <field name="system_id" ref="ni_coding.system_internal" />
        <field name="color">6</field>
    </record>
</odoo>
