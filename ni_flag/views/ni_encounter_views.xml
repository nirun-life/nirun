<odoo>
    <record id="ni_encounter_view_form_inherit" model="ir.ui.view">
        <field name="name">ni.encounter.view.form.flag</field>
        <field name="model">ni.encounter</field>
        <field name="inherit_id" ref="ni_patient.ni_encounter_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group attrs="{'invisible': [('id', '=', False)]}">
                    <group string="Patient Flags">
                        <field
                            name="patient_flag_code_ids"
                            widget="many2many_tags"
                            options="{'color_field': 'color', 'no_create': False, 'no_open': True}"
                            nolabel="1"
                        />
                    </group>
                    <group string="Encounter Flags">
                        <field
                            name="encounter_flag_code_ids"
                            widget="many2many_tags"
                            options="{'color_field': 'color', 'no_create': False, 'no_open': True}"
                            nolabel="1"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
