<odoo>
    <!-- Patient form: stat button + inline active flags -->
    <record id="ni_patient_view_form_inherit" model="ir.ui.view">
        <field name="name">ni.patient.view.form.flag</field>
        <field name="model">ni.patient</field>
        <field name="inherit_id" ref="ni_patient.ni_patient_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='presence_state'][@invisible='1']" position="after">
                <field name="flag_count" invisible="1" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_flag"
                    attrs="{'invisible': [('flag_count', '=', 0)]}"
                    class="oe_stat_button"
                    icon="fa-flag"
                    type="object"
                    groups="ni_patient.group_user"
                >
                    <field name="flag_count" string="Flags" widget="statinfo" />
                </button>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <field
                    name="active_flag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color', 'no_edit': True, 'no_open': True}"
                    attrs="{'invisible': [('flag_count', '=', 0)]}"
                    readonly="1"
                    class="mb-2"
                />
            </xpath>
            <xpath expr="//notebook/page[@name='history']" position="inside">
                <separator string="Flags" />
                <field name="flag_ids" mode="tree" context="{'default_patient_id': id}">
                    <tree decoration-muted="status != 'active'" editable="bottom">
                        <field name="code_id" options="{'no_create': True}" />
                        <field
                            name="category_ids"
                            widget="many2many_tags"
                            options="{'color_field': 'color', 'no_create': True}"
                        />
                        <field
                            name="status"
                            widget="badge"
                            decoration-success="status == 'active'"
                            decoration-warning="status == 'inactive'"
                            decoration-danger="status == 'entered-in-error'"
                        />
                        <field name="period_start" string="Valid From" optional="show" />
                        <field name="period_end" string="Valid Until" optional="show" />
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
    <!-- Patient kanban: show active flag tags inline on card -->
    <record id="ni_patient_view_kanban_inherit" model="ir.ui.view">
        <field name="name">ni.patient.view.kanban.flag</field>
        <field name="model">ni.patient</field>
        <field name="inherit_id" ref="ni_patient.ni_patient_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban/templates" position="before">
                <field name="flag_count" />
                <field name="active_flag_ids" />
            </xpath>
            <xpath expr="//ul" position="after">
                <div class="mt-1" t-if="record.flag_count.raw_value &gt; 0">
                    <field name="active_flag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                </div>
            </xpath>
        </field>
    </record>
    <!-- Patient list/kanban: search and filter by flag -->
    <record id="ni_patient_view_search_inherit" model="ir.ui.view">
        <field name="name">ni.patient.view.search.flag</field>
        <field name="model">ni.patient</field>
        <field name="inherit_id" ref="ni_patient.ni_patient_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//search/field[last()]" position="after">
                <field name="flag_ids" string="Flag" filter_domain="[('flag_ids.code_id', 'ilike', self)]" />
            </xpath>
            <xpath expr="//search/separator[last()]" position="after">
                <separator />
                <filter name="has_active_flag" string="Has Active Flag" domain="[('flag_ids.status', '=', 'active')]" />
            </xpath>
        </field>
    </record>
</odoo>
