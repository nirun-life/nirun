<odoo>
    <record id="module_category_medical_observation" model="ir.module.category">
        <field name="name">Observation</field>
        <field name="sequence">84</field>
        <field name="parent_id" ref="ni_patient.module_category_medical" />
    </record>
    <record id="res_groups_privilege_observation" model="res.groups.privilege">
        <field name="name">Observation</field>
        <field name="sequence">84</field>
        <field name="category_id" ref="module_category_medical_observation" />
    </record>
    <record id="group_viewer" model="res.groups">
        <field name="sequence">10</field>
        <field name="name">Viewer</field>
        <field name="implied_ids" eval="[(4, ref('ni_patient.group_viewer'))]" />
        <field name="privilege_id" ref="res_groups_privilege_observation" />
    </record>
    <record id="group_user" model="res.groups">
        <field name="sequence">20</field>
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('group_viewer'))]" />
        <field name="privilege_id" ref="res_groups_privilege_observation" />
    </record>
    <record id="group_manager" model="res.groups">
        <field name="sequence">30</field>
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field name="privilege_id" ref="res_groups_privilege_observation" />
    </record>
</odoo>
