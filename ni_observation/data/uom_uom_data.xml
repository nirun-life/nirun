<odoo noupdate="1">
    <record id="uom_categ_fraction" model="uom.category">
        <field name="name">Fraction</field>
    </record>
    <record id="uom_%" model="uom.uom">
        <field name="name">%</field>
        <field name="alias">Percentage</field>
        <field name="category_id" ref="uom_categ_fraction" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_categ_density" model="uom.category">
        <field name="name">Density</field>
    </record>
    <record id="uom_kg_m3" model="uom.uom">
        <field name="name">kg/m³</field>
        <field name="category_id" ref="uom_categ_density" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_mg_dl" model="uom.uom">
        <field name="name">mg/dl</field>
        <field name="category_id" ref="uom_categ_density" />
        <field name="factor">100</field>
        <field name="uom_type">smaller</field>
    </record>
    <record id="uom_categ_pressure" model="uom.category">
        <field name="name">Pressure</field>
    </record>
    <record id="uom_kg_m2" model="uom.uom">
        <field name="name">kg/m²</field>
        <field name="category_id" ref="uom_categ_pressure" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_categ_temperature" model="uom.category">
        <field name="name">Temperature</field>
    </record>
    <record id="uom_degree_cel" model="uom.uom">
        <field name="name">°C</field>
        <field name="alias">Celsius</field>
        <field name="category_id" ref="uom_categ_temperature" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_categ_blood_pressure" model="uom.category">
        <field name="name">Blood Pressure</field>
    </record>
    <record id="uom_mmHg" model="uom.uom">
        <field name="name">mmHg</field>
        <field name="category_id" ref="uom_categ_blood_pressure" />
        <field name="factor" eval="1" />
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_categ_frequency" model="uom.category">
        <field name="name">Frequency</field>
    </record>
    <record id="uom_per_min" model="uom.uom">
        <field name="name">/min</field>
        <field name="category_id" ref="uom_categ_frequency" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_per_sec" model="uom.uom">
        <field name="name">/sec</field>
        <field name="category_id" ref="uom_categ_frequency" />
        <field name="factor" eval="60" />
        <field name="uom_type">smaller</field>
    </record>
    <record id="uom_per_hour" model="uom.uom">
        <field name="name">/hour</field>
        <field name="category_id" ref="uom_categ_frequency" />
        <field name="factor_inv" eval="60" />
        <field name="uom_type">bigger</field>
    </record>
    <record id="uom_categ_mass_concentration" model="uom.category">
        <field name="name">Mass Concentration</field>
    </record>
    <record id="uom_g_dl" model="uom.uom">
        <field name="name">g/dL</field>
        <field name="alias">Gram per deciliter</field>
        <field name="category_id" ref="uom_categ_mass_concentration" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_categ_cell_count" model="uom.category">
        <field name="name">Cell Count</field>
    </record>
    <record id="uom_k_ul" model="uom.uom">
        <field name="name">×10³/µL</field>
        <field name="alias">Thousand per microliter</field>
        <field name="category_id" ref="uom_categ_cell_count" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_m_ul" model="uom.uom">
        <field name="name">×10⁶/µL</field>
        <field name="alias">Million per microliter</field>
        <field name="category_id" ref="uom_categ_cell_count" />
        <field name="factor_inv" eval="1000" />
        <field name="uom_type">bigger</field>
    </record>
    <record id="uom_categ_enzymatic_activity" model="uom.category">
        <field name="name">Enzymatic Activity</field>
    </record>
    <record id="uom_u_l" model="uom.uom">
        <field name="name">U/L</field>
        <field name="alias">Units per liter</field>
        <field name="category_id" ref="uom_categ_enzymatic_activity" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_categ_electrolyte" model="uom.category">
        <field name="name">Electrolyte</field>
    </record>
    <record id="uom_meq_l" model="uom.uom">
        <field name="name">mEq/L</field>
        <field name="alias">Milliequivalent per liter</field>
        <field name="category_id" ref="uom_categ_electrolyte" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
    <record id="uom_categ_filtration_rate" model="uom.category">
        <field name="name">Filtration Rate</field>
    </record>
    <record id="uom_ml_min_bsa" model="uom.uom">
        <field name="name">mL/min/1.73m²</field>
        <field name="alias">Milliliter per minute per BSA</field>
        <field name="category_id" ref="uom_categ_filtration_rate" />
        <field name="factor">1</field>
        <field name="uom_type">reference</field>
    </record>
</odoo>
