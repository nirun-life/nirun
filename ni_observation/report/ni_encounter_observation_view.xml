<odoo>
    <record id="ni_encounter_ob_line_action" model="ir.actions.act_window">
        <field name="name">Observation Detail</field>
        <field name="res_model">ni.encounter.observation</field>
        <field name="view_mode">list</field>
    </record>
    <record id="ni_encounter_ob_line_view_search" model="ir.ui.view">
        <field name="name">ni.encounter.ob.line.view.search</field>
        <field name="model">ni.encounter.observation</field>
        <field name="arch" type="xml">
            <search>
                <field name="sheet_id" />
                <field name="patient_id" />
                <field name="type_id" />
                <field name="interpretation_id" operator="child_of" />
                <filter
                    name="effective_today"
                    string="Today"
                    domain="[                     ('occurrence', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')),                     ('occurrence', '&lt;=',datetime.datetime.now().strftime('%Y-%m-%d 23:23:59'))                     ]"
                />
                <filter
                    name="effective_yesterday"
                    string="Yesterday"
                    domain="[                     ('occurrence', '&gt;=', (datetime.datetime.now()-datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')),                     ('occurrence', '&lt;=',(datetime.datetime.now()-datetime.timedelta(days=1)).strftime('%Y-%m-%d 23:23:59'))                     ]"
                />
                <filter name="effective_date" string="Period" date="occurrence" />
                <separator />
                <group>
                    <filter name="Patient" context="{'group_by': 'patient_id'}" />
                    <filter name="Encounter" context="{'group_by': 'encounter_id'}" />
                    <separator />
                    <filter name="Task" context="{'group_by': 'sheet_id'}" />
                    <filter name="Type" context="{'group_by': 'type_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="ni_encounter_ob_line_view_tree" model="ir.ui.view">
        <field name="name">ni.encounter.ob.line.view.list</field>
        <field name="model">ni.encounter.observation</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence,type_id">
                <field name="sequence" widget="handle" />
                <field name="category_id" optional="hide" />
                <field name="type_id" optional="show" />
                <field name="value_type" column_invisible="1" />
                <field name="value" decoration-bf="1" />
                <field name="unit_id" decoration-muted="1" />
                <field
                    name="interpretation_id"
                    widget="badge"
                    decoration-danger="display_class == 'danger'"
                    decoration-info="display_class == 'info'"
                    decoration-muted="display_class == 'muted'"
                    decoration-primary="display_class == 'primary'"
                    decoration-success="display_class == 'success'"
                    decoration-warning="display_class == 'warning'"
                />
                <field name="display_class" column_invisible="1" />
                <field
                    name="compare_interpret"
                    decoration-success="compare_interpret == 'better'"
                    decoration-danger="compare_interpret == 'worsen'"
                />
                <field name="occurrence" widget="remaining_days" optional="show" />
                <button
                    name="action_graph_view"
                    icon="fa-bar-chart"
                    title="View graph"
                    type="object"
                    invisible="value_type not in ['int', 'float']"
                />
            </list>
        </field>
    </record>
    <record id="ni_encounter_ob_line_view_form" model="ir.ui.view">
        <field name="name">ni.encounter.ob.line.view.form</field>
        <field name="model">ni.encounter.observation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="patient_id" invisible="1" />
                    <field name="encounter_id" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <group>
                        <group>
                            <field name="type_id" />
                            <field name="category_id" />
                            <field name="occurrence" />
                        </group>
                        <group>
                            <field name="value_type" invisible="1" />
                            <label for="value" />
                            <div class="o_row">
                                <field name="value" />
                                <field
                                    name="unit_id"
                                    options="{'no_open': True}"
                                    invisible="value_type not in ['int', 'float']"
                                />
                            </div>
                            <field
                                name="interpretation_id"
                                widget="badge"
                                decoration-danger="display_class == 'danger'"
                                decoration-info="display_class == 'info'"
                                decoration-muted="display_class == 'muted'"
                                decoration-primary="display_class == 'primary'"
                                decoration-success="display_class == 'success'"
                                decoration-warning="display_class == 'warning'"
                            />
                            <field name="display_class" invisible="1" />
                            <field name="create_uid" widget="many2one_avatar_user" />
                        </group>
                    </group>
                    <label for="history_ids" />
                    <field name="history_ids">
                        <list limit="10">
                            <field name="occurrence" />
                            <field name="value" />
                            <field name="unit_id" optional="show" />
                            <field
                                name="interpretation_id"
                                optional="show"
                                widget="badge"
                                decoration-danger="display_class == 'danger'"
                                decoration-info="display_class == 'info'"
                                decoration-muted="display_class == 'muted'"
                                decoration-primary="display_class == 'primary'"
                                decoration-success="display_class == 'success'"
                                decoration-warning="display_class == 'warning'"
                            />
                            <field name="display_class" column_invisible="1" />
                            <field
                                name="create_uid"
                                widget="many2one_avatar_user"
                                optional="hide"
                            />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_encounter_ob_line_view_kanban" model="ir.ui.view">
        <field name="name">ni.encounter.ob.line.view.kanban</field>
        <field name="model">ni.encounter.observation</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color">
                <field name="display_class" />
                <field name="compare_interpret" />
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <field name="type_id" class="fw-bold" />
                            <field name="value" class="text-body fs-2 me-1" />
                        </div>
                        <div class="mb-1">
                            <t t-if="record.compare_interpret.raw_value">
                                <i
                                    class="fa fa-line-chart small me-1 text-muted"
                                    aria-hidden="true"
                                    title="Trend"
                                />
                                <span
                                    t-esc="record.compare_interpret.value"
                                    t-attf-class="text-{{(record.compare_interpret.raw_value == 'better')? 'success' : ((record.compare_interpret.raw_value == 'worsen')? 'danger' : 'body')}}"
                                />
                            </t>
                            <field
                                name="interpretation_id"
                                class="ms-3"
                                widget="badge"
                                decoration-danger="display_class == 'danger'"
                                decoration-info="display_class == 'info'"
                                decoration-muted="display_class == 'muted'"
                                decoration-primary="display_class == 'primary'"
                                decoration-success="display_class == 'success'"
                                decoration-warning="display_class == 'warning'"
                            />
                        </div>
                        <footer class="text-muted small">
                            <div>
                                <i
                                    class="fa fa-clock-o me-1"
                                    aria-hidden="true"
                                    title="Occurence"
                                />
                                <field name="occurrence" />
                            </div>
                            <field name="unit_id" class="ms-auto me-1" />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
