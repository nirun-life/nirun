<odoo>
    <record id="res_users_role_action" model="ir.actions.act_window">
        <field name="name">Role</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.users.role</field>
        <field name="view_mode">kanban,form</field>
    </record>
    <record id="res_users_in_role_action" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('role_line_ids.role_id', '=', active_id)]</field>
    </record>
    <record id="res_users_role_view_form_inherit" model="ir.ui.view">
        <field name="name">res.users.role.view.form.inherit</field>
        <field name="model">res.users.role</field>
        <field name="inherit_id" ref="base_user_role.view_res_users_role_form" />
        <field name="arch" type="xml">
            <field name="group_id" position="after">
                <field name="employee_category_ids" widget="many2many_tags" />
                <button
                    name="action_generate_access_token"
                    type="object"
                    string="Create Invitation Link"
                    class="btn-secondary"
                    colspan="2"
                    invisible="not id or access_token"
                />
                <field
                    name="register_location"
                    widget="CopyClipboardURL"
                    invisible="not access_token"
                />
                <field
                    name="register_qr_code"
                    widget="image"
                    invisible="not access_token"
                />
            </field>
        </field>
    </record>
    <record id="res_users_role_view_kanban" model="ir.ui.view">
        <field name="name">res.users.role.view.kanban</field>
        <field name="model">res.users.role</field>
        <field name="arch" type="xml">
            <kanban
                highlight_color="color"
                class="o_hr_department_kanban o_kanban_small_column"
                create="0"
            >
                <templates>
                    <t t-name="menu" t-if="!selection_mode" groups="base.group_system">
                        <a
                            t-if="widget.editable"
                            role="menuitem"
                            class="dropdown-item"
                            type="open"
                        >Settings</a>
                        <field
                            t-if="widget.editable"
                            name="color"
                            widget="kanban_color_picker"
                        />
                    </t>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-4 ms-2" />
                        <field name="comment" class="small text-muted ms-2" />
                        <div class="row g-0 mt-auto pt-3" t-if="!selection_mode">
                            <div class="col-6 px-2">
                                <button
                                    class="btn btn-primary w-100"
                                    name="action_user_in_role"
                                    type="object"
                                >
                                    <i
                                    class="fa fa-users me-2"
                                    aria-hidden="true"
                                    title="Users"
                                />
                                    <field name="user_count" />
                                    Users
                                    <span
                                    t-if="record.user_to_verify_count.raw_value > 0"
                                    class="ms-1 badge text-bg-danger"
                                >
                                    <field name="user_to_verify_count" />
                                </span>
                                </button>
                            </div>
                            <div class="col-6 px-2">
                                <button
                                    class="btn btn-outline-primary w-100"
                                    name="action_download_qrcode"
                                    type="object"
                                >
                                    <i
                                    class="fa fa-qrcode me-2"
                                    aria-hidden="true"
                                    title="QR code"
                                />
                                    Download
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <menuitem
        id="menu_res_user_role"
        action="res_users_role_action"
        groups="base.group_erp_manager"
        web_icon="ni_practitioner_role,static/description/icon.png"
    />
    <data noupdate="1">
        <record id="base.menu_users" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('base.group_system'))]" />
        </record>
        <record id="base.menu_management" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('base.group_system'))]" />
        </record>
    </data>
</odoo>
