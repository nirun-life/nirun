<odoo>
    <record id="res_users_view_tree_inherit" model="ir.ui.view">
        <field name="name">res.users.view.list.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree" />
        <field name="arch" type="xml">
            <field name="role" position="after">
                <field name="active" widget="boolean_toggle" />
                <field name="verified" />
                <button
                    name="action_verify"
                    type="object"
                    string="Verify"
                    icon="fa-check"
                    class="text-success"
                    invisible="verified"
                />
                <button
                    name="action_create_employee"
                    type="object"
                    string="Employee"
                    icon="fa-id-badge"
                    invisible="employee_id"
                />
            </field>
        </field>
    </record>
    <record id="res_users_view_form_inherit" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form" />
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <button
                        string="Create employee"
                        type="object"
                        name="action_create_employee"
                        invisible="not id or share or employee_id"
                    />
                    <!-- share is not correctly recomputed because it depends on fields of reified view => invisible before saving (id=False) -->
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="new,active"
                    />
                </header>
            </sheet>
        </field>
    </record>
</odoo>
