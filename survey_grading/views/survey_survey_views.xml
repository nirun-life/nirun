<odoo>
    <record id="survey_view_form_inherit" model="ir.ui.view">
        <field name="name">survey.view.form.inherit</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']/group" position="inside">
                <separator
                    name="grading"
                    string="Grading"
                    invisible="scoring_type == 'no_scoring'"
                />
                <field
                    name="grading_basis"
                    widget="radio"
                    options="{'horizontal': True}"
                    invisible="scoring_type == 'no_scoring'"
                />
                <field name="grade_ids" invisible="scoring_type == 'no_scoring'">
                    <list>
                        <field name="survey_id" column_invisible="1" />
                        <field name="name" />
                        <field
                            name="low"
                            decoration-primary="color_class == 'primary'"
                            decoration-success="color_class == 'success'"
                            decoration-danger="color_class == 'danger'"
                            decoration-warning="color_class == 'warning'"
                            decoration-muted="color_class == 'muted'"
                            decoration-info="color_class == 'info'"
                        />
                        <field
                            name="high"
                            decoration-primary="color_class == 'primary'"
                            decoration-success="color_class == 'success'"
                            decoration-danger="color_class == 'danger'"
                            decoration-warning="color_class == 'warning'"
                            decoration-muted="color_class == 'muted'"
                            decoration-info="color_class == 'info'"
                        />
                        <field name="triggering_answer_ids" column_invisible="1" />
                        <button
                            disabled="disabled"
                            icon="fa-code-fork"
                            title="This grade only applies when its triggering answers are selected."
                            class="icon_rotates"
                            invisible="not triggering_answer_ids"
                        />
                        <field name="color_class" column_invisible="1" />
                        <field name="passing_grade" column_invisible="1" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
