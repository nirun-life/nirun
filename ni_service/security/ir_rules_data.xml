<odoo>
    <record id="ni_service_company_rule" model="ir.rule">
        <field name="name">Service: multi-company</field>
        <field name="model_id" ref="model_ni_service" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ni_service_category_read_rule" model="ir.rule">
        <field name="name">Service Category: visible companies</field>
        <field name="model_id" ref="model_ni_service_category" />
        <field name="global" eval="True" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ni_service_category_user_rule" model="ir.rule">
        <field name="name">Service Category: private edit</field>
        <field name="model_id" ref="model_ni_service_category" />
        <field name="groups" eval="[(4, ref('ni_patient.group_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[('company_id', '!=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ni_service_category_admin_rule" model="ir.rule">
        <field name="name">Service Category: admin all</field>
        <field name="model_id" ref="model_ni_service_category" />
        <field name="groups" eval="[(4, ref('ni_patient.group_admin'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="ni_service_type_read_rule" model="ir.rule">
        <field name="name">Service Type: visible companies</field>
        <field name="model_id" ref="model_ni_service_type" />
        <field name="global" eval="True" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ni_service_type_user_rule" model="ir.rule">
        <field name="name">Service Type: private edit</field>
        <field name="model_id" ref="model_ni_service_type" />
        <field name="groups" eval="[(4, ref('ni_patient.group_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[('company_id', '!=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ni_service_type_admin_rule" model="ir.rule">
        <field name="name">Service Type: admin all</field>
        <field name="model_id" ref="model_ni_service_type" />
        <field name="groups" eval="[(4, ref('ni_patient.group_admin'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="ni_service_event_company_rule" model="ir.rule">
        <field name="name">Service Calendar: multi-company</field>
        <field name="model_id" ref="model_ni_service_event" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
