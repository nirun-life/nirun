<odoo noupdate="0">
    <record id="ir_cron_backfill_category_ids" model="ir.cron">
        <field name="name">Backfill Service Category Membership</field>
        <field name="model_id" ref="model_ni_service" />
        <field name="state">code</field>
        <field name="code">model._cron_backfill_category_ids()</field>
        <field name="active" eval="False" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=3)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="numbercall">1</field>
        <field name="doall" eval="False" />
    </record>
</odoo>
