<odoo>
    <record id="ni_encounter_service_attendance_view_tree" model="ir.ui.view">
        <field name="name">ni.encounter.service.attendance.view.tree</field>
        <field name="model">ni.encounter.service.attendance</field>
        <field name="arch" type="xml">
            <tree decoration-muted="editable == False" decoration-info="editable == True" default_order="sequence">
                <field name="sequence" invisible="1" />
                <field name="editable" invisible="1" />
                <field name="encounter_id" invisible="1" />
                <field name="encounter_date" invisible="1" />
                <field name="resource_calendar_id" invisible="1" />
                <field name="service_id" invisible="1" />
                <field name="service_ids" invisible="1" />
                <field
                    name="attendance_id"
                    attrs="{'readonly': [('editable', '=', False)]}"
                    options="{'no_open': True}"
                />
                <field name="name" />
                <field name="partner_ids" widget="many2many_tags_avatar" optional="hide" />
                <field name="note" widget="char" optional="show" />
                <control>
                    <create string="Add Service" context="{}" />
                </control>
            </tree>
        </field>
    </record>
    <record id="ni_encounter_service_attendance_view_kanban" model="ir.ui.view">
        <field name="name">ni.encounter.service.attendance.view.kanban</field>
        <field name="model">ni.encounter.service.attendance</field>
        <field name="arch" type="xml">
            <kanban default_order="sequence">
                <field name="attendance_id" />
                <field name="hour_from" />
                <field name="hour_to" />
                <field name="name" />
                <field name="editable" />
                <field name="note" />
                <field name="sequence" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="fw-bold">
                                        <field name="hour_from" widget="float_time" />
                                        <span class="mx-1">-</span>
                                        <field name="hour_to" widget="float_time" />
                                    </div>
                                    <div class="text-muted">
                                        <span t-if="record.editable.raw_value" class="me-2" title="Editable">
                                            <i class="fa fa-pencil text-info" />
                                        </span>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <field name="name" />
                                    <span class="mx-3" t-if="record.note.raw_value" title="Has note">
                                        <i class="fa fa-sticky-note text-warning" />
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_encounter_service_attendance_view_form" model="ir.ui.view">
        <field name="name">ni.encounter.service.attendance.view.form</field>
        <field name="model">ni.encounter.service.attendance</field>
        <field name="arch" type="xml">
            <form string="">
                <field name="encounter_id" invisible="1" required="False" />
                <field name="patient_id" invisible="1" />
                <field name="name" invisible="1" />
                <field name="editable" invisible="1" />
                <field name="encounter_date" invisible="1" />
                <field name="resource_calendar_id" invisible="1" />
                <field name="dayofweek" invisible="1" />
                <field name="request_id" invisible="1" />
                <field name="service_event_id" invisible="1" />
                <field name="service_id" invisible="1" />
                <sheet>
                    <group>
                        <field name="display_calendar_id" />
                        <field
                            name="attendance_id"
                            options="{'no_create': True, 'no_open':True}"
                            domain="[('calendar_id', '=', resource_calendar_id),('dayofweek', '=', dayofweek)]"
                            attrs="{'readonly': [('editable', '=', False)]}"
                        />
                        <label for="service_ids" />
                        <div>
                            <field
                                name="service_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create': True, 'no_open':True}"
                                attrs="{'readonly': [('editable', '=', False)]}"
                                required="True"
                            />
                            <div class="o_row" attrs="{'invisible': [('request_id', '=', False)]}">
                                <label for="display_request_id" />
                                <field name="display_request_id" />
                            </div>
                        </div>
                    </group>
                    <field name="note" placeholder="Additional note..." />
                    <group string="For Developer" groups="base.group_no_one">
                        <field name="service_event_id" placeholder="Event..." />
                        <field
                            name="request_id"
                            placeholder="Request..."
                            domain="[('patient_id', '=', patient_id), ('service_ids', 'in', service_ids)]"
                            context="{'show_identifier': True, 'show_period': True, 'show_state': True}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
