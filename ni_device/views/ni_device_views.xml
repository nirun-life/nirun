<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ni_device_action" model="ir.actions.act_window">
        <field name="name">ทะเบียนอุปกรณ์ทั้งหมด</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <record id="ni_device_available_action" model="ir.actions.act_window">
        <field name="name">ทะเบียนอุปกรณ์ที่ว่างอยู่</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('state', '=', 'available')]</field>
    </record>
    <record id="ni_device_my_action" model="ir.actions.act_window">
        <field name="name">อุปกรณ์ของฉัน</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('is_holder', '=', True)]</field>
    </record>
    <record id="ni_device_view_search" model="ir.ui.view">
        <field name="name">ni.device.view.search</field>
        <field name="model">ni.device</field>
        <field name="arch" type="xml">
            <search>
                <searchpanel>
                    <field name="state" string="สถานะ" enable_counters="1" icon="fa-circle" />
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="ni_device_view_tree" model="ir.ui.view">
        <field name="name">ni.device.view.tree</field>
        <field name="model">ni.device</field>
        <field name="arch" type="xml">
            <tree>
                <field name="identifier" />
                <field name="name" />
                <field name="type_ids" widget="many2many_tags" string="ประเภทอุปกรณ์" />
                <field
                    name="availability_status"
                    widget="badge"
                    string="สถานะความพร้อมใช้งาน"
                    decoration-success="availability_status == 'available'"
                    decoration-danger="availability_status == 'damaged'"
                    optional="hide"
                />
                <field
                    name="state"
                    widget="badge"
                    string="สถานะการถือครอง"
                    decoration-success="state == 'available'"
                    decoration-warning="state == 'pending'"
                    decoration-info="state == 'in_use'"
                />
                <field name="holder_id" string="ผู้ถือครองอุปกรณ์ปัจจุบัน" />
                <field name="create_date" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="ni_device_view_form" model="ir.ui.view">
        <field name="name">ni.device.view.form</field>
        <field name="model">ni.device</field>
        <field name="arch" type="xml">
            <form string="อุปกรณ์ตรวจสุขภาพ">
                <field name="is_holder" invisible="1" />
                <header>
                    <!-- ไม่มีผู้ถือครอง: ต้องอยู่ในสถานะว่าง  -->
                    <field name="is_holder" invisible="1" />
                    <field name="is_manager" invisible="1" />
                    <button
                        name="action_request_hold"
                        type="object"
                        string="ขอถือครอง"
                        class="btn-primary oe_highlight"
                        attrs="{'invisible': ['|', ('availability_status', '!=', 'available'), ('state', '!=', 'available')]}"
                    />
                    <!-- ========== มีผู้ถือครอง: ผู้ถือครอง และ manager เท่านั้นที่กดได้ ========== -->
                    <button
                        name="action_request_return"
                        type="object"
                        string="ขอคืนอุปกรณ์"
                        class="oe_highlight"
                        attrs="{'invisible': ['|',('state','!=','in_use'),'&amp;',('is_holder','=',False),('is_manager','=',False)]}"
                    />
                    <button
                        name="action_request_transfer"
                        type="object"
                        string="ขอเปลี่ยนผู้ถือครอง"
                        attrs="{'invisible': ['|',('state','!=','in_use'),'&amp;',('is_holder','=',False),('is_manager','=',False)]}"
                    />
                    <button
                        name="action_request_dispose"
                        type="object"
                        string="ขอจำหน่ายอุปกรณ์"
                        attrs="{'invisible': ['|',('state','!=','in_use'),'&amp;',('is_holder','=',False),('is_manager','=',False)]}"
                    />
                    <!-- ปุ่มแจ้งซ่อม -->
                    <button
                        name="action_repair"
                        type="object"
                        string="แจ้งซ่อม"
                        attrs="{'invisible': ['|',('state','!=','in_use'),'&amp;',('is_holder','=',False),('is_manager','=',False)]}"
                    />
                </header>
                <sheet>
                    <!--                    <div name="button_box_holder" attrs="{'invisible': [('id', '=', False)]}" class="oe_button_box"-->
                    <!--                         groups="ni_patient.group_user">-->
                    <!--                        <button name="action" attrs="{'invisible': [('encounter_count', '=', 0)]}"-->
                    <!--                                class="oe_stat_button" icon="fa-hospital-o" type="object">-->
                    <!--                            <field name="encounter_count" string="Encounter(s)" widget="statinfo" />-->
                    <!--                        </button>-->
                    <!--                    </div>-->
                    <field
                        name="image_1920"
                        class="oe_avatar"
                        options="{'preview_image': 'image_128'}"
                        widget="image"
                    />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('availability_status', '!=', 'damaged' )]}"
                        bg_color="bg-danger"
                        title="ชำรุด"
                    />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('availability_status', '!=', 'lost' )]}"
                        bg_color="bg-dark"
                        title="สูญหาย"
                    />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('state', '!=', 'disposed' )]}"
                        bg_color="bg-dark"
                        title="จำหน่ายแล้ว"
                    />
                    <div class="oe_title">
                        <!-- ========== TITLE (ชื่ออุปกรณ์) ========== -->
                        <field name="identifier" />
                        <h1>
                            <field name="name" />
                        </h1>
                        <br />
                        <group>
                            <group>
                                <field name="type_ids" widget="many2many_tags" string="ประเภทอุปกรณ์" />
                                <field name="metric_ids" widget="many2many_tags" string="ประเภทข้อมูลตรวจวัด" />
                                <field
                                    name="manufacturer_id"
                                    domain="[('is_company', '=', True)]"
                                    context="{'default_is_company': True}"
                                />
                                <field name="serial_number" />
                                <field name="model_number" />
                                <field name="manufacture_date" />
                                <field name="price" />
                            </group>
                            <group>
                                <field
                                    name="availability_status"
                                    widget="badge"
                                    string="สถานะความพร้อมใช้งาน"
                                    decoration-success="availability_status == 'available'"
                                    decoration-danger="availability_status == 'damaged'"
                                />
                                <field
                                    name="state"
                                    widget="badge"
                                    string="สถานะการถือครอง"
                                    decoration-success="state == 'available'"
                                    decoration-warning="state == 'pending'"
                                    decoration-info="state == 'in_use'"
                                />
                                <field name="holder_id" string="ผู้ถือครองอุปกรณ์ปัจจุบัน" readonly="1" />
                            </group>
                        </group>
                    </div>
                    <group string="ข้อมูลที่แก้ไขได้" groups="base.group_no_one">
                        <field name="holder_id" string="ผู้ถือครองอุปกรณ์ปัจจุบัน" />
                        <field name="holder_history_ids" readonly="1" />
                        <field name="request_ids" />
                        <field name="repair_ids" readonly="1" />
                        <field name="state" />
                        <field name="availability_status" />
                        <field name="is_holder" />
                        <field name="is_manager" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_device_view_kanban" model="ir.ui.view">
        <field name="name">ni.device.view.kanban</field>
        <field name="model">ni.device</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_details">
                                <strong>
                                    <field name="name" />
                                </strong>
                            </div>
                            <div>
                                <field name="identifier" />
                            </div>
                            <!-- ประเภทอุปกรณ์ -->
                            <div class="mt8">
                                <span class="text-muted">ประเภท:</span>
                                <field name="type_ids" widget="many2many_tags" />
                            </div>
                            <!-- สถานะความพร้อมใช้งาน -->
                            <div class="mt8">
                                <span class="text-muted">ความพร้อมใช้งาน:</span>
                                <field
                                    name="availability_status"
                                    widget="badge"
                                    decoration-success="availability_status == 'available'"
                                    decoration-danger="availability_status == 'damaged'"
                                />
                            </div>
                            <!-- สถานะการถือครอง -->
                            <div class="mt8">
                                <span class="text-muted">ถือครอง:</span>
                                <field
                                    name="state"
                                    widget="badge"
                                    decoration-success="state == 'available'"
                                    decoration-warning="state == 'pending'"
                                    decoration-info="state == 'in_use'"
                                />
                            </div>
                            <!-- ผู้ถือครองปัจจุบัน -->
                            <div class="mt8">
                                <span class="text-muted">ผู้ถือครอง:</span>
                                <field name="holder_id" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
