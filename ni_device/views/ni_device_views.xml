<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ni_device_action" model="ir.actions.act_window">
        <field name="name">ทะเบียนอุปกรณ์ทั้งหมด</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">

            </p>
            <p>

            </p>
        </field>
    </record>
    <record id="ni_device_view_form" model="ir.ui.view">
        <field name="name">ni.device.view.form</field>
        <field name="model">ni.device</field>
        <field name="arch" type="xml">
            <field name="is_holder" invisible="1" />
            <form string="อุปกรณ์ตรวจสุขภาพ">
                <header>
                    <!-- ไม่มีผู้ถือครอง: ต้องอยู่ในสถานะว่าง  -->
                    <field name="is_holder" invisible="1" />
                    <field name="is_manager" invisible="1" />
                    <button
                        name="action_request_hold"
                        type="object"
                        string="ขอถือครอง"
                        class="btn-primary oe_highlight"
                        attrs="{'invisible': ['|', ('availability_status', '!=', 'available'), ('state', '!=', 'available')]}"
                    />
                    <!-- ========== มีผู้ถือครอง: ผู้ถือครอง และ manager เท่านั้นที่กดได้ ========== -->
                    <button
                        name="action_request_return"
                        type="object"
                        string="ขอคืนอุปกรณ์"
                        class="oe_highlight"
                        attrs="{ 'invisible': [('|'),('state','!=','in_use'),('is_holder','=',False),('is_manager','=',False)]}"
                    />
                    <button
                        name="action_request_transfer"
                        type="object"
                        string="ขอเปลี่ยนผู้ถือครอง"
                        attrs="{ 'invisible': [('|'),('state','!=','in_use'),('is_holder','=',False),('is_manager','=',False)]}"
                    />
                    <button
                        name="action_request_dispose"
                        type="object"
                        string="ขอจำหน่ายอุปกรณ์"
                        attrs="{ 'invisible': [('|'),('state','!=','in_use'),('is_holder','=',False),('is_manager','=',False)]}"
                    />
                    <!-- ปุ่มแจ้งซ่อม -->
                    <button
                        name="action_repair"
                        type="object"
                        string="แจ้งซ่อม"
                        attrs="{ 'invisible': [('|'),('state','!=','in_use'),('is_holder','=',False),('is_manager','=',False)]}"
                    />
                </header>
                <sheet>
                    <field
                        name="image_1920"
                        class="oe_avatar"
                        options="{&quot;preview_image&quot;:&quot;image_128&quot;}"
                        widget="image"
                    />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('availability_status', '!=', 'damaged' )]}"
                        bg_color="bg-danger"
                        title="ชำรุด"
                    />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('availability_status', '!=', 'lost' )]}"
                        bg_color="bg-dark"
                        title="สูญหาย"
                    />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('state', '!=', 'disposed' )]}"
                        bg_color="bg-dark"
                        title="จำหน่ายแล้ว"
                    />
                    <!-- ========== TITLE (ชื่ออุปกรณ์) ========== -->
                    <field name="identifier" />
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="type_ids" widget="many2many_tags" string="ประเภทอุปกรณ์" />
                            <field name="metric_ids" widget="many2many_tags" string="ประเภทข้อมูลตรวจวัด" />
                            <field name="manufacturer" />
                            <field name="serial_number" />
                            <field name="model_number" />
                            <field name="manufacture_date" />
                            <field name="price" />
                        </group>
                        <group>
                            <field name="availability_status" widget="badge" string="สถานะความพร้อมใช้งาน" />
                            <field name="state" widget="badge" string="สถานะการถือครอง" />
                            <field name="holder_id" string="ผู้ถือครองอุปกรณ์ปัจจุบัน" readonly="1" />
                        </group>
                    </group>
                    <group string="ข้อมูลที่แก้ไขได้" groups="base.group_no_one">
                        <field name="holder_id" string="ผู้ถือครองอุปกรณ์ปัจจุบัน" />
                        <!--                        <field name="holder_ids" />-->
                        <field name="holding_request_ids" />
                        <field name="state" />
                        <field name="availability_status" />
                        <field name="is_holder" />
                        <field name="is_manager" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
