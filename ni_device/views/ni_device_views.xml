<odoo>
    <record id="ni_device_view_search" model="ir.ui.view">
        <field name="name">ni.device.view.search</field>
        <field name="model">ni.device</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Name"
                    filter_domain="['|','|','|',('name', 'ilike', self), ('identifier', 'ilike', self),('holder_partner_id', 'ilike', self),('definition_id', 'ilike', self)]"
                />
                <filter
                    name="available_device"
                    string="Available"
                    domain="[('state','=','available'),('availability_status','=','available')]"
                />
                <filter name="my_device" string="My device" domain="[('is_holder','=',True)]" />
                <filter
                    name="group_device_definition"
                    string="Device Definition"
                    context="{'group_by': 'definition_id'}"
                />
                <searchpanel>
                    <field name="state" enable_counters="1" icon="fa-circle" />
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="ni_device_action" model="ir.actions.act_window">
        <field name="name">All Device Registry</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <record id="ni_device_available_action" model="ir.actions.act_window">
        <field name="name">Available Device Registry</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">
            {
                'search_default_available_device': 1
            }
        </field>
    </record>
    <record id="ni_device_action_my_device" model="ir.actions.act_window">
        <field name="name">My Device</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">
            {
                'search_default_my_device': 1
            }
        </field>
    </record>
    <record id="ni_device_repair_action_this" model="ir.actions.act_window">
        <field name="name">Device Repair History</field>
        <field name="res_model">ni.device.repair</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('device_id', '=', active_id)]</field>
    </record>
    <record id="ni_device_holder_action_this" model="ir.actions.act_window">
        <field name="name">Device Holding History</field>
        <field name="res_model">ni.device.holder</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('device_id', '=', active_id)]</field>
    </record>
    <record id="ni_device_request_action_this" model="ir.actions.act_window">
        <field name="name">Device Holding Request</field>
        <field name="res_model">ni.device.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('device_id', '=', active_id)]</field>
    </record>
    <record id="ni_device_view_tree" model="ir.ui.view">
        <field name="name">ni.device.view.tree</field>
        <field name="model">ni.device</field>
        <field name="arch" type="xml">
            <tree default_order="name asc, create_date desc">
                <field name="identifier" />
                <field name="name" />
                <field name="definition_id" optional="hide" />
                <field name="type_ids" widget="many2many_tags" string="Device Type" />
                <field
                    name="availability_status"
                    widget="badge"
                    string="Availability Status"
                    decoration-success="availability_status == 'available'"
                    decoration-danger="availability_status == 'damaged'"
                    optional="hide"
                />
                <field
                    name="state"
                    widget="badge"
                    string="Holding Status"
                    decoration-success="state == 'available'"
                    decoration-warning="state == 'pending'"
                    decoration-info="state == 'in_use'"
                />
                <field name="holder_name" string="Current Holder" />
                <field name="create_date" optional="hide" widget="date" />
            </tree>
        </field>
    </record>
    <record id="ni_device_view_form" model="ir.ui.view">
        <field name="name">ni.device.view.form</field>
        <field name="model">ni.device</field>
        <field name="arch" type="xml">
            <form string="Medical Devices">
                <field name="company_id" invisible="1" />
                <field name="request_count" invisible="1" />
                <field name="repair_count" invisible="1" />
                <field name="is_holder" invisible="1" />
                <field name="is_manager" invisible="1" />
                <field name="holder_employee_id" invisible="1" />
                <field name="can_request_as_holder" invisible="1" />
                <field name="not_repairable" invisible="1" />
                <field name="barcode" invisible="1" />
                <header attrs="{'invisible':[('id','=',False)]}">
                    <!-- ไม่มีผู้ถือครอง: ต้องอยู่ในสถานะว่าง  -->
                    <button
                        name="action_request_hold"
                        type="object"
                        string="Request Holding"
                        class="btn-primary oe_highlight"
                        attrs="{'invisible': ['|', ('availability_status', '!=', 'available'), ('state', '!=', 'available')]}"
                    />
                    <!-- ========== มีผู้ถือครอง: ผู้ถือครอง และ manager เท่านั้นที่กดได้ ========== -->
                    <button
                        name="action_request_return"
                        type="object"
                        string="Return Device"
                        class="oe_highlight"
                        attrs="{'invisible': [('can_request_as_holder','=',False)]}"
                    />
                    <button
                        name="action_request_transfer"
                        type="object"
                        string="Transfer Holder"
                        attrs="{'invisible': [('can_request_as_holder','=',False)]}"
                    />
                    <button
                        name="action_request_dispose"
                        type="object"
                        string="Device Disposal"
                        attrs="{'invisible': [('can_request_as_holder','=',False),('not_repairable','=',False)]}"
                    />
                    <button
                        name="action_request_dispose"
                        type="object"
                        string="Device Disposal"
                        attrs="{'invisible': [('availability_status','!=','lost')]}"
                    />
                    <!-- ปุ่มแจ้งซ่อม -->
                    <button
                        name="action_repair"
                        type="object"
                        string="Report Repair"
                        attrs="{'invisible': [('can_request_as_holder','=',False)]}"
                    />
                    <!-- แจ้งพบอุปกรณ์ -->
                    <button
                        name="action_report_found"
                        string="Report Found Device"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('availability_status', '!=', 'lost')]}"
                    />
                    <button
                        name="action_print_device_label"
                        type="object"
                        string="Print Device Label"
                        attrs="{'invisible': [('barcode', '=',False )]}"
                    />
                    <button
                        name="action_create_observation_sheet"
                        type="object"
                        string="Create Observation"
                        groups="ni_patient.group_user"
                        attrs="{'invisible': [('observation_type_ids', '=', [])]}"
                    />
                </header>
                <sheet>
                    <div
                        name="button_box"
                        attrs="{'invisible': [('id', '=', False)]}"
                        class="oe_button_box"
                        groups="ni_patient.group_user"
                    >
                        <button
                            name="ni_device.ni_device_usage_action_patient_by_device"
                            attrs="{'invisible': [('patient_count', '=', 0)]}"
                            class="oe_stat_button"
                            icon="fa-user"
                            type="action"
                        >
                            <field name="patient_count" string="ผู้สูงอายุ" widget="statinfo" />
                        </button>
                        <button
                            name="ni_device.ni_device_usage_action_by_device"
                            attrs="{'invisible': [('usage_count', '=', 0)]}"
                            class="oe_stat_button"
                            icon="fa-list-alt"
                            type="action"
                        >
                            <field name="usage_count" string="Usage" widget="statinfo" />
                        </button>
                        <button
                            name="ni_device.ni_device_repair_action_this"
                            attrs="{'invisible': [('repair_count', '=', 0)]}"
                            class="oe_stat_button"
                            icon="fa-wrench"
                            type="action"
                        >
                            <field name="repair_count" string="Repair" widget="statinfo" />
                        </button>
                        <button
                            name="ni_device.ni_device_holder_action_this"
                            attrs="{'invisible': [('holder_history_count', '=', 0)]}"
                            class="oe_stat_button"
                            icon="fa-address-card"
                            type="action"
                        >
                            <field name="holder_history_count" string="Device Holding" widget="statinfo" />
                        </button>
                        <button
                            name="ni_device.ni_device_request_action_this"
                            attrs="{'invisible': [('request_count', '=', 0)]}"
                            class="oe_stat_button"
                            icon="fa-check-square-o"
                            type="action"
                            groups="ni_patient.group_manager"
                        >
                            <field name="request_count" string="Approval Request" widget="statinfo" />
                        </button>
                    </div>
                    <field name="image_1920" class="oe_avatar" options="{'zoom': true}" widget="image" />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('availability_status', '!=', 'damaged' )]}"
                        bg_color="bg-danger"
                        title="Damaged"
                    />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('availability_status', '!=', 'lost' )]}"
                        bg_color="bg-dark"
                        title="Lost"
                    />
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('state', '!=', 'disposed' )]}"
                        bg_color="bg-dark"
                        title="Disposed"
                    />
                    <div class="oe_title mb24">
                        <field name="identifier" attrs="{'invisible':[('id','=',False)]}" />
                        <h1>
                            <field name="name" placeholder="Device Name" />
                        </h1>
                        <div class="o_field_widget w-100">
                            <field
                                name="definition_id"
                                string="Device template"
                                placeholder="Select device template..."
                                options="{'no_create': True}"
                                class="w-100"
                                attrs="{'readonly': [('request_count', '>', 0)]}"
                            />
                            <small
                                class="text-warning fst-italic"
                                attrs="{'invisible': ['|', ('id', '=', False), ('request_count', '>', 0)]}"
                                groups="ni_device.access_ni_device_admin,base.group_no_one"
                            >
                                <i class="fa fa-exclamation-triangle me-1" />
                                Changing the template will overwrite the current data with information from the
                                template.
                            </small>
                            <small class="text-muted fst-italic" attrs="{'invisible': [('request_count', '=', 0)]}">
                                <i class="fa fa-lock me-1" />
                                Device template is locked because a device request already exists for this device.
                            </small>
                        </div>
                    </div>
                    <group>

                    </group>
                    <group class="mt-2">
                        <group string="Device information">
                            <field
                                name="type_ids"
                                string="Device Type"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                            <field name="observation_type_ids" string="Observation Type" widget="many2many_tags" />
                            <field
                                name="manufacturer_id"
                                domain="[('is_company', '=', True)]"
                                context="{'default_is_company': True}"
                            />
                            <field name="model_number" />
                            <separator string="Device Registry" />
                            <field name="serial_number" />
                            <field name="manufacture_date" />
                            <field name="received_date" />
                            <field name="display_age" />
                            <field name="price" />
                            <field name="repair_cost" />
                            <field name="currency_id" invisible="1" />
                        </group>
                        <group string="Device Status" attrs="{'invisible': [('id', '=', False)]}">
                            <field
                                name="availability_status"
                                widget="badge"
                                string="Availability Status"
                                decoration-success="availability_status == 'available'"
                                decoration-danger="availability_status == 'damaged'"
                                attrs="{'invisible': [('id', '=', False)]}"
                            />
                            <field
                                name="state"
                                widget="badge"
                                string="Holding Status"
                                decoration-success="state == 'available'"
                                decoration-warning="state == 'pending'"
                                decoration-info="state == 'in_use'"
                                attrs="{'invisible': [('id', '=', False)]}"
                            />
                            <field
                                name="disposed_date"
                                string="Disposal Date"
                                attrs="{'invisible':[('state','!=','disposed')]}"
                            />
                            <field
                                name="lost_date"
                                string="Lost Date"
                                attrs="{'invisible':[('availability_status','!=','lost')]}"
                            />
                            <field
                                name="pending_request_id"
                                string="Pending Request"
                                attrs="{'invisible':[('pending_request_id','=',False)]}"
                            />
                            <label for="active_repair_id" attrs="{'invisible':[('active_repair_id','=',False)]}" />
                            <div class="o_row" attrs="{'invisible':[('active_repair_id','=',False)]}">
                                <field name="active_repair_id" string="Device Repair Tracking" />
                                <field
                                    name="active_repair_state"
                                    widget="badge"
                                    decoration-success="active_repair_state == 'completed'"
                                    decoration-danger="active_repair_state == 'damaged'"
                                    decoration-warning="active_repair_state == 'repairing'"
                                    decoration-muted="active_repair_state == 'not_repairable'"
                                />
                            </div>
                            <field
                                name="holder_employee_id"
                                string="Current Holder"
                                readonly="1"
                                widget="many2one_avatar"
                                attrs="{'invisible':[('holder_employee_id','=',False)]}"
                            />
                            <field
                                name="holder_partner_id"
                                string="Current Holder"
                                readonly="1"
                                widget="many2one_avatar"
                                attrs="{'invisible':['|',('holder_employee_id','!=',False),('holder_partner_id','=',False)]}"
                            />
                            <field name="company_id" string="Company" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <group string="Debug" groups="base.group_no_one">
                        <field name="barcode" />
                        <field name="holder_employee_id" />
                        <field name="holder_partner_id" />
                        <field name="state" />
                        <field name="availability_status" />
                        <field name="holder_history_ids" readonly="1" invisible="True" />
                        <field name="request_ids" readonly="1" invisible="True" />
                        <field name="repair_ids" readonly="1" invisible="True" />
                        <field name="is_holder" invisible="True" />
                        <field name="is_manager" invisible="True" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
    <record id="ni_device_view_kanban" model="ir.ui.view">
        <field name="name">ni.device.view.kanban</field>
        <field name="model">ni.device</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="image_128" />
                <field name="holder_name" />
                <field name="availability_status" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_global_click o_kanban_card #{record.availability_status.raw_value === 'lost' ? 'opacity-50' : ''}"
                        >
                            <div class="o_kanban_image me-1">
                                <field
                                    name="image_128"
                                    class="oe_avatar o_image_64_contain"
                                    options="{'zoom': true}"
                                    widget="image"
                                    style="width:100%; height:100%; object-fit:cover;"
                                />
                            </div>
                            <div class="oe_kanban_details">
                                <div class="d-flex align-items-start justify-content-between gap-2 mb-0">
                                    <div style="min-width:0;">
                                        <strong
                                            class="o_kanban_record_title d-block"
                                            style="-webkit-line-clamp:2; display:-webkit-box !important; -webkit-box-orient:vertical; overflow:hidden;"
                                        >
                                            <field name="name" />
                                        </strong>
                                        <div class="text-muted small text-truncate">
                                            <field name="identifier" />
                                        </div>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <field
                                            name="state"
                                            widget="badge"
                                            decoration-success="state == 'available'"
                                            decoration-warning="state == 'pending'"
                                            decoration-info="state == 'in_use'"
                                        />
                                    </div>
                                </div>
                                <div class="o_kanban_tags_section mt-1">
                                    <field name="type_ids" widget="many2many_tags" />
                                </div>
                                <div
                                    t-attf-class="small mt-1 #{record.availability_status.raw_value === 'damaged' ? 'fw-bold text-danger' : 'text-muted'}"
                                >
                                    <field name="availability_status" />
                                </div>
                                <t t-if="record.holder_name.raw_value">
                                    <div class="d-flex align-items-center mt-2 pt-1 border-top">
                                        <field
                                            name="holder_employee_id"
                                            readonly="1"
                                            widget="many2one_avatar"
                                            attrs="{'invisible':[('holder_employee_id','=',False)]}"
                                        />
                                        <field
                                            name="holder_partner_id"
                                            readonly="1"
                                            widget="many2one_avatar"
                                            attrs="{'invisible':['|',('holder_employee_id','!=',False),('holder_partner_id','=',False)]}"
                                        />
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_device_report_lost" model="ir.actions.server">
        <field name="name">Report Lost</field>
        <field name="model_id" ref="model_ni_device" />
        <field name="binding_model_id" ref="model_ni_device" />
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_report_lost()</field>
    </record>
</odoo>
