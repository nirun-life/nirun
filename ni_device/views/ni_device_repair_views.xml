<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ni_device_repair_action" model="ir.actions.act_window">
        <field name="name">ประวัติการซ่อมแซมอุปกรณ์</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device.repair</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <record id="ni_device_repair_view_tree" model="ir.ui.view">
        <field name="name">ni.device.repair.view.tree</field>
        <field name="model">ni.device.repair</field>
        <field name="arch" type="xml">
            <tree>
                <field name="device_id" string="ชื่ออุปกรณ์" />
                <field name="damage_date" string="วันที่เกิดการชำรุด" widget="date" />
                <field name="repair_duration" string="ระยะเวลาซ่อมแซม" />
                <field name="repair_cost" string="ค่าใช้จ่าย(บาท)" />
            </tree>
        </field>
    </record>
    <record id="ni_device_repair_view_form" model="ir.ui.view">
        <field name="name">ni.device.repair.view.form</field>
        <field name="model">ni.device.repair</field>
        <field name="arch" type="xml">
            <form string="">
                <field name="is_holder" invisible="1" />
                <field name="is_manager" invisible="1" />
                <header>
                    <button
                        name="action_confirm_repair"
                        type="object"
                        string="ยืนยันผลการซ่อม"
                        attrs="{'invisible': [('|'),('&amp;'),('state', '!=','repairing'),('is_holder', '=',False),('is_manager', '=',False)]}"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="device_id" readonly="1" />
                            <field
                                name="device_holder_emp_id"
                                readonly="1"
                                widget="many2one_avatar"
                                attrs="{'invisible': [('device_holder_emp_id','=',False)]}"
                            />
                            <field
                                name="device_holder_id"
                                readonly="1"
                                widget="many2one_avatar"
                                attrs="{'invisible':[('device_holder_emp_id','!=',False)]}"
                            />
                            <field name="damage_date" string="วันที่เกิดการชำรุด" widget="date" />
                            <field name="repair_duration" string="ระยะเวลาที่ใช้ซ่อม (วัน)" />
                            <field name="note" string="หมายเหตุ" />
                            <field
                                name="image_1920"
                                string="ภาพประกอบ"
                                style="float: left; margin-right: 10px;"
                                class="oe_avatar"
                                options="{'zoom': true}"
                                widget="image"
                            />
                        </group>
                        <group>
                            <field name="state" readonly="1" />
                            <field name="create_uid" string="ผู้แจ้งซ่อม" />
                            <field name="repair_cost" string="ค่าใช้จ่าย (บาท)" />
                        </group>
                    </group>
                    <group string="Debug" groups="base.group_no_one">
                        <field name="is_holder" readonly="1" />
                        <field name="is_manager" readonly="1" />
                        <field name="state" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_device_repair_view_kanban" model="ir.ui.view">
        <field name="name">ni.device.repair.view.kanban</field>
        <field name="model">ni.device.repair</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_details">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="device_id" />
                                </strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <i class="fa fa-calendar" aria-label="Period" role="img" title="Period" />
                                <field name="damage_date" widget="date" />
                            </div>
                            <div>
                                <label for="repair_duration" class="text-muted me-2">ระยะเวลา:</label>
                                <field name="repair_duration" />
                            </div>
                            <div>
                                <label for="repair_cost" class="text-muted me-2">ค่าใช้จ่าย:</label>
                                <field name="repair_cost" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
