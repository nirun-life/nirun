<odoo>
    <record id="ni_device_repair_action" model="ir.actions.act_window">
        <field name="name">Device Repair History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device.repair</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <record id="ni_device_repair_view_tree" model="ir.ui.view">
        <field name="name">ni.device.repair.view.tree</field>
        <field name="model">ni.device.repair</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="company_id" groups="base.group_multi_company" />
                <field name="device_id" string="Device Name" />
                <field name="create_uid" widget="many2one_avatar" />
                <field name="damage_date" widget="date" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'completed'"
                    decoration-danger="state == 'damaged'"
                    decoration-warning="state == 'repairing'"
                    decoration-muted="state == 'not_repairable'"
                />
                <field name="repair_duration" />
                <field name="repair_cost" />
            </tree>
        </field>
    </record>
    <record id="ni_device_repair_view_form" model="ir.ui.view">
        <field name="name">ni.device.repair.view.form</field>
        <field name="model">ni.device.repair</field>
        <field name="arch" type="xml">
            <form create="0">
                <field name="company_id" invisible="1" />
                <field name="is_holder" invisible="1" />
                <field name="is_manager" invisible="1" />
                <field name="can_action_as_holder" invisible="1" />
                <header>
                    <button
                        name="action_begin_repair"
                        string="Perform Repair"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible':['|',('state','!=','damaged'),('can_action_as_holder','=',False)]}"
                    />
                    <button
                        name="action_repair_result"
                        string="Confirm Repair Result"
                        type="object"
                        attrs="{'invisible':['|',('state','!=','damaged'),('can_action_as_holder','=',False)]}"
                    />
                    <button
                        name="action_repair_result"
                        string="Confirm Repair Result"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible':['|',('state','!=','repairing'),('can_action_as_holder','=',False)]}"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="device_id" readonly="1" />
                            <field
                                name="device_holder_emp_id"
                                readonly="1"
                                widget="many2one_avatar"
                                attrs="{'invisible': [('device_holder_emp_id','=',False)]}"
                            />
                            <field
                                name="device_holder_partner_id"
                                readonly="1"
                                widget="many2one_avatar"
                                attrs="{'invisible':[('device_holder_emp_id','!=',False)]}"
                            />
                            <field name="damage_date" readonly="1" widget="date" />
                            <field name="note" readonly="1" />
                            <field
                                name="image_1920"
                                string="Image"
                                readonly="1"
                                style="float: left; margin-right: 10px;"
                                class="oe_avatar"
                                options="{'zoom': true}"
                                widget="image"
                            />
                        </group>
                        <group>
                            <field
                                name="state"
                                widget="badge"
                                decoration-success="state == 'completed'"
                                decoration-danger="state == 'damaged'"
                                decoration-warning="state == 'repairing'"
                                decoration-muted="state == 'not_repairable'"
                                readonly="1"
                            />
                            <field name="create_uid" string="Repair Requester" readonly="1" />
                        </group>
                    </group>
                    <notebook attrs="{'invisible': [('state', 'not in', ['completed', 'repairing','not_repairable'])]}">
                        <page string="Duration and Cost" icon="fa-clock-o">
                            <group>
                                <group string="Repair Estimation">
                                    <field name="estimated_duration" readonly="1" />
                                    <field name="estimated_cost" readonly="1" />
                                    <field name="technician_id" readonly="1" />
                                </group>
                                <group
                                    string="Repair Confirmation"
                                    readonly="1"
                                    attrs="{'invisible': [('state', 'not in', ['completed','not_repairable'])]}"
                                >
                                    <field name="repair_duration" readonly="1" />
                                    <field name="repair_cost" readonly="1" />
                                </group>
                            </group>
                            <br />
                            <group attrs="{'invisible': [('state', 'not in', ['completed','not_repairable'])]}">
                                <field name="repairing_note" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                    <group string="Debug" groups="base.group_no_one">
                        <field name="is_holder" readonly="1" />
                        <field name="is_manager" readonly="1" />
                        <field name="state" />
                        <field name="repair_duration" />
                        <field name="repair_cost" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_device_repair_view_form_wizard_create" model="ir.ui.view">
        <field name="name">ni.device.repair.view.form.wizard.create</field>
        <field name="model">ni.device.repair</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="device_id" readonly="1" />
                        <field
                            name="device_holder_emp_id"
                            readonly="1"
                            widget="many2one_avatar"
                            attrs="{'invisible': [('device_holder_emp_id','=',False)]}"
                        />
                        <field
                            name="device_holder_partner_id"
                            readonly="1"
                            widget="many2one_avatar"
                            attrs="{'invisible':[('device_holder_emp_id','!=',False)]}"
                        />
                        <field name="damage_date" widget="date" />
                        <field name="note" />
                        <field
                            name="image_1920"
                            style="float: left; margin-right: 10px;"
                            class="oe_avatar"
                            options="{'zoom': true}"
                            widget="image"
                        />
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="ni_device_repair_view_form_wizard_confirm" model="ir.ui.view">
        <field name="name">ni.device.repair.view.form.wizard.confirm</field>
        <field name="model">ni.device.repair</field>
        <field name="arch" type="xml">
            <form string="Confirm Repair Result" edit="1" create="0" delete="0">
                <sheet>
                    <group string="Repair Estimation">
                        <field name="technician_id" />
                        <field name="estimated_cost" />
                        <field name="estimated_duration" />
                    </group>
                    <group invisible="context.get('state_action') != 'repair_result'" string="Repair Confirmation">
                        <field name="repair_cost" />
                        <field name="repair_duration" />
                        <field name="repair_result" widget="radio" />
                        <field
                            name="repairing_note"
                            attrs="{'required': [('repair_result', 'not in', ['repaired'])]}"
                        />
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="ni_device_repair_view_kanban" model="ir.ui.view">
        <field name="name">ni.device.repair.view.kanban</field>
        <field name="model">ni.device.repair</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click d-flex flex-column" style="height:100%;">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="device_id" />
                                </strong>
                            </div>
                            <div>
                                <field name="create_uid" widget="many2one_avatar" />
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <i
                                    class="fa fa-exclamation-triangle text-primary"
                                    aria-label="Period"
                                    role="img"
                                    title="Period"
                                />
                                <field name="damage_date" widget="date" />
                            </div>
                            <div>
                                <label for="repair_duration" class="text-muted me-2">Repair Duration:</label>
                                <field name="repair_duration" />
                            </div>
                            <div>
                                <label for="repair_cost" class="text-muted me-2">Repair Cost:</label>
                                <field name="repair_cost" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
