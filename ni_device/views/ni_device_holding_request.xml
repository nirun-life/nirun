<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ni_device_holding_request_action" model="ir.actions.act_window">
        <field name="name">การถือครองอุปกรณ์</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device.holding.request</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">

            </p>
            <p>

            </p>
        </field>
    </record>
    <record id="ni_device_holding_request_view_tree" model="ir.ui.view">
        <field name="name">ni.device.holding.request.view.tree</field>
        <field name="model">ni.device.holding.request</field>
        <field name="arch" type="xml">
            <tree string="ประวัติผู้ถือครองอุปกรณ์">
                <field name="device_id" />
                <field name="holder_id" />
                <field name="request_type" />
                <field name="state" />
                <field name="write_date" />
                <button
                    name="action_approve"
                    type="object"
                    string="Approve"
                    attrs="{'invisible': [('state', '=', 'approved' )]}"
                />
            </tree>
        </field>
    </record>
    <record id="ni_device_holding_request_view_form" model="ir.ui.view">
        <field name="name">ni.device.holding.request.view.form</field>
        <field name="model">ni.device.holding.request</field>
        <field name="arch" type="xml">
            <form string="ขออนุมัติการถือครองอุปกรณ์" create="false" edit="true">
                <group>
                    <field name="device_id" readonly="1" />
                    <field name="request_type" readonly="1" />
                    <field name="holder_id" />
                    <field name="new_holder_id" invisible="not context.get('show_new_holder')" />
                    <field name="request_reason" />
                </group>
                <footer>
                    <button name="action_submit" type="object" string="ส่งคำขอ" class="btn-primary" />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
