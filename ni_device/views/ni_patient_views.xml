<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ni_view_form_inherit" model="ir.ui.view">
        <field name="name">ni.view.form.inherit</field>
        <field name="model">ni.patient</field>
        <field name="inherit_id" ref="ni_patient.ni_patient_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="ni_device.ni_device_usage_action_by_patient"
                    attrs="{'invisible': [('device_usage_count', '=', 0)]}"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    type="action"
                >
                    <field name="device_usage_count" string="Device Usage" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
