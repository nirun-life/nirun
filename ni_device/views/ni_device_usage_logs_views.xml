<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ───────────────────────────────────────────────
         ACTION  (เปิดจาก Menu หลัก — group by device)
    ─────────────────────────────────────────────────── -->
    <record id="ni_device_usage_log_action" model="ir.actions.act_window">
        <field name="name">ประวัติการใช้งานอุปกรณ์ทั้งหมด</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device.usage.log</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_device': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ไม่มีประวัติการใช้งานอุปกรณ์</p>
        </field>
    </record>
    <!-- ACTION เปิดจากหน้า Device — group by month, filter device นั้น -->
    <record id="ni_device_usage_log_action_this" model="ir.actions.act_window">
        <field name="name">ประวัติการใช้งานอุปกรณ์</field>
        <field name="res_model">ni.device.usage.log</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('device_id', '=', active_id)]</field>
        <field name="context">
            {
            'search_default_group_month': 1,
            'default_device_id': active_id
        }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีการบันทึกการใช้งาน</p>
            <p>เริ่มบันทึกผลการตรวจวัดจากอุปกรณ์นี้</p>
        </field>
    </record>
    <!-- ───────────────────────────────────────────────
         SEARCH VIEW
    ─────────────────────────────────────────────────── -->
    <record id="ni_device_usage_log_view_search" model="ir.ui.view">
        <field name="name">ni.device.usage.log.view.search</field>
        <field name="model">ni.device.usage.log</field>
        <field name="arch" type="xml">
            <search string="ค้นหาประวัติการใช้งาน">
                <field name="patient_id" string="ผู้ป่วย" />
                <field name="user_id" string="ผู้บันทึก" />
                <field name="device_id" string="อุปกรณ์" />
                <field name="card_pid" string="เลขบัตร" />
                <field name="card_name" string="ชื่อ (บัตร)" />
                <filter
                    name="filter_today"
                    string="วันนี้"
                    domain="[('create_date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S')),
                                 ('create_date','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)).strftime('%Y-%m-%d %H:%M:%S'))]"
                />
                <filter
                    name="filter_this_month"
                    string="เดือนนี้"
                    domain="[('create_date','&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('create_date','&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"
                />
                <filter name="filter_has_patient" string="มีผู้ป่วย" domain="[('patient_id','!=',False)]" />
                <filter name="filter_has_card" string="มีบัตร" domain="[('card_pid','!=',False)]" />
                <separator />
                <filter name="group_month" string="เดือน" context="{'group_by': 'create_date:month'}" />
                <filter name="group_patient" string="ผู้ป่วย" context="{'group_by': 'patient_id'}" />
                <filter name="group_device" string="อุปกรณ์" context="{'group_by': 'device_id'}" />
                <filter name="group_user" string="ผู้บันทึก" context="{'group_by': 'user_id'}" />
            </search>
        </field>
    </record>
    <!-- ───────────────────────────────────────────────
         TREE VIEW
         • ตัด vitalsign flat fields ออก — ไม่มีใน model แล้ว
         • เพิ่ม card_name, card_pid, sheet_id
    ─────────────────────────────────────────────────── -->
    <record id="ni_device_usage_log_view_tree" model="ir.ui.view">
        <field name="name">ni.device.usage.log.view.tree</field>
        <field name="model">ni.device.usage.log</field>
        <field name="arch" type="xml">
            <tree
                string="ประวัติการใช้งานอุปกรณ์"
                default_order="create_date desc"
                decoration-muted="patient_id == False and card_pid == False"
                sample="1"
            >
                <field name="create_date" string="วันที่/เวลา" widget="datetime" />
                <field name="device_id" string="อุปกรณ์" optional="show" />
                <field name="card_name" string="ชื่อ (บัตร)" optional="show" />
                <field name="card_pid" string="เลขบัตร" optional="show" />
                <field name="patient_id" widget="many2one_avatar" optional="show" />
                <field name="user_id" string="ผู้บันทึก" widget="many2one_avatar" optional="show" />
                <field name="sheet_id" string="Sheet" optional="hide" />
            </tree>
        </field>
    </record>
    <!-- ───────────────────────────────────────────────
         KANBAN VIEW
         • group_limit="4"  → 4 เดือนล่าสุด เดือนที่เหลือหุบ
         • limit="10"        → 10 cards / group มี load more
         • vitalsign_summary → loop render จาก observation_ids
         • card_image แทน image_1920
    ─────────────────────────────────────────────────── -->
    <record id="ni_device_usage_log_view_kanban" model="ir.ui.view">
        <field name="name">ni.device.usage.log.view.kanban</field>
        <field name="model">ni.device.usage.log</field>
        <field name="arch" type="xml">
            <kanban
                string="ประวัติการใช้งานอุปกรณ์"
                default_group_by="create_date:month"
                default_order="create_date desc"
                limit="10"
                group_limit="4"
                class="o_kanban_small_column"
                quick_add="false"
                sample="1"
            >
                <field name="id" />
                <field name="create_date" />
                <field name="patient_id" />
                <field name="user_id" />
                <field name="device_id" />
                <field name="card_pid" />
                <field name="card_name" />
                <field name="card_image" />
                <field name="vitalsign_summary" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record p-0">
                            <div class="p-3">
                                <!-- ── Header ── -->
                                <t t-if="record.card_pid.raw_value">
                                    <!-- มีบัตร: รูป + ชื่อจากบัตร -->
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div
                                            class="rounded-circle flex-shrink-0 d-flex align-items-center justify-content-center bg-light position-relative overflow-hidden"
                                            style="width:40px;height:40px;border:1px solid #dee2e6;"
                                        >
                                            <img
                                                t-att-src="kanban_image('ni.device.usage.log', 'card_image', record.id.raw_value)"
                                                class="rounded-circle"
                                                style="width:40px;height:40px;object-fit:cover;"
                                                onerror="this.style.display='none';this.parentElement.querySelector('.fa-user').style.display='inline-block';"
                                                onload="this.parentElement.querySelector('.fa-user').style.display='none';"
                                            />
                                            <i class="fa fa-user text-muted position-absolute" style="display:none;" />
                                        </div>
                                        <div class="overflow-hidden">
                                            <strong class="d-block text-truncate" t-esc="record.card_name.value" />
                                            <div class="text-muted small">
                                                <i class="fa fa-clock-o me-1" />
                                                <t t-esc="record.create_date.value" />
                                            </div>
                                        </div>
                                    </div>
                                    <!-- เลขบัตร -->
                                    <div class="mb-2 px-2 py-1 rounded" style="background:#f8f9fa;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">
                                                <i class="fa fa-id-card-o me-1 opacity-75" />
                                                เลขบัตร
                                            </span>
                                            <span class="small font-monospace" t-esc="record.card_pid.value" />
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <!-- ไม่มีบัตร: ชื่อ patient ชิดซ้าย -->
                                    <div class="mb-2">
                                        <t t-if="record.patient_id.raw_value">
                                            <strong class="d-block text-truncate" t-esc="record.patient_id.value" />
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted fst-italic d-block">ไม่ระบุผู้ป่วย</span>
                                        </t>
                                        <div class="text-muted small">
                                            <i class="fa fa-clock-o me-1" />
                                            <t t-esc="record.create_date.value" />
                                        </div>
                                    </div>
                                </t>
                                <!-- ── ค่าตรวจวัด: loop จาก vitalsign_summary ── -->
                                <t t-set="vitals" t-value="record.vitalsign_summary.raw_value or []" />
                                <t t-foreach="vitals" t-as="vs">
                                    <div class="d-flex justify-content-between mb-1">
                                        <div>
                                            <t t-if="vs.i">
                                                <i
                                                    t-att-class="'fa ' + vs.i"
                                                    t-att-style="'color:' + (vs.color or '#6c757d')"
                                                    class="me-2"
                                                />
                                            </t>
                                            <span t-esc="vs.l" />
                                        </div>
                                        <div>
                                            <strong t-esc="vs.v" />
                                            <span t-esc="vs.u" />
                                        </div>
                                    </div>
                                </t>
                                <!-- ── Footer: ผู้บันทึก ── -->
                                <div class="d-flex align-items-center gap-1 mt-2 pt-1 border-top">
                                    <img
                                        t-att-src="kanban_image('res.users', 'avatar_128', record.user_id.raw_value)"
                                        class="rounded-circle"
                                        style="width:18px;height:18px;object-fit:cover;"
                                    />
                                    <small class="text-muted" t-esc="record.user_id.value" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_device_usage_log_view_form" model="ir.ui.view">
        <field name="name">ni.device.usage.log.view.form</field>
        <field name="model">ni.device.usage.log</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- ปุ่ม drill down ไปหา sheet เพื่อแก้ไขค่า -->
                        <button
                            name="action_view_sheet"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            attrs="{'invisible': [('sheet_id', '=', False)]}"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Observation Sheet</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="device_id" readonly="1" />
                            <field name="sheet_id" readonly="1" />
                            <field name="patient_id" readonly="1" />
                            <field name="user_id" widget="many2one_avatar" readonly="1" />
                            <field name="create_date" string="วันที่บันทึก" />
                        </group>
                    </group>
                    <notebook>
                        <!-- ── ผลการตรวจวัด (แก้ไขได้) ── -->
                        <page
                            name="observations"
                            string="ผลการตรวจวัด"
                            icon="fa-stethoscope"
                            attrs="{'invisible': [('id', '=', False)]}"
                        >
                            <field
                                name="observation_ids"
                                context="{'default_usage_log_id':id,'default_device_id':device_id, 'default_patient_id': patient_id}"
                                widget="ob_section_and_note_one2many"
                            >
                                <tree editable="bottom">
                                    <field name="code" invisible="1" />
                                    <field name="patient_id" invisible="1" />
                                    <field name="display_type" invisible="1" />
                                    <field name="display_class" invisible="1" />
                                    <field name="value_type" invisible="1" />
                                    <field name="sequence" widget="handle" />
                                    <field name="type_id" />
                                    <field name="title" widget="ob_section_and_note_text" optional="show" nolabel="1" />
                                    <field name="value_char" />
                                    <field name="value_int" nolabel="1" />
                                    <field name="value_float" nolabel="1" />
                                    <field name="value_code_id" nolabel="1" />
                                    <field
                                        name="value_code_ids"
                                        nolabel="1"
                                        widget="many2many_tags"
                                        options="{'color_field': 'color'}"
                                    />
                                    <field
                                        name="unit_id"
                                        optional="show"
                                        decoration-muted="1"
                                        attrs="{'invisible': [('value_type', 'not in', ['int', 'float'])]}"
                                    />
                                    <field
                                        name="interpretation_id"
                                        widget="badge"
                                        decoration-danger="display_class == 'danger'"
                                        decoration-info="display_class == 'info'"
                                        decoration-muted="display_class == 'muted'"
                                        decoration-primary="display_class == 'primary'"
                                        decoration-success="display_class == 'success'"
                                        decoration-warning="display_class == 'warning'"
                                        optional="show"
                                    />
                                    <field name="value" />
                                    <control>
                                        <create string="Add Observation" context="{}" />
                                    </control>
                                </tree>
                            </field>
                        </page>
                        <!-- ── ข้อมูลบัตร ── -->
                        <page name="smartcard" string="ข้อมูลบัตร" icon="fa-id-card-o">
                            <field
                                name="card_image"
                                class="oe_avatar mt-4"
                                options="{&quot;preview_image&quot;:&quot;card_image&quot;}"
                                widget="image"
                            />
                            <group>
                                <field name="card_pid" string="เลขบัตรประชาชน" readonly="1" />
                                <field name="card_name" string="ชื่อ-นามสกุล" readonly="1" />
                            </group>
                        </page>
                        <!-- ── Raw data / Debug ── -->
                        <page name="raw_data" string="Raw Data" groups="base.group_no_one">
                            <field name="card_data" />
                        </page>
                        <page name="debug" string="Debug" groups="base.group_no_one">
                            <group>
                                <field name="vitalsign_summary" widget="text" />
                                <field name="device_id" />
                                <field name="patient_id" />
                                <field name="sheet_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
