<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ni_device_usage_log_action" model="ir.actions.act_window">
        <field name="name">ประวัติการใช้งานอุปกรณ์ทั้งหมด</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device.usage.log</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ไม่มีประวัติการใช้งานอุปกรณ์</p>
        </field>
    </record>
    <record id="ni_device_usage_log_view_form" model="ir.ui.view">
        <field name="name">ni.device.usage.log.view.form</field>
        <field name="model">ni.device.usage.log</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="user_id" widget="many2one_avatar" readonly="1" />
                            <field name="create_date" />
                            <field name="patient_id" readonly="1" />
                            <field name="device_id" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="vitalsign" string="Vital-sign">
                            <div class="text-center d-none d-lg-block">
                                <label for="pain_score_enum" />
                                <div class="mt-2">
                                    <field name="pain_score_enum" widget="radio" options="{'horizontal': True}" />
                                </div>
                                <div>
                                    <field name="pain_area" placeholder="บริเวณที่เจ็บปวด" class="w-75" />
                                </div>
                            </div>
                            <group class="my-4">
                                <group>
                                    <label for="body_temp" />
                                    <div class="o_row">
                                        <field class="narrow_field" name="body_temp" />
                                        <span class="text-muted me-4">°C</span>
                                    </div>
                                    <label for="respiratory_rate" />
                                    <div class="o_row">
                                        <field class="narrow_field" name="respiratory_rate" />
                                        <span class="text-muted me-4">/min</span>
                                    </div>
                                    <label for="bp_s" string="Blood Pressure" />
                                    <div class="o_row">
                                        <field class="narrow_field" name="bp_s" />
                                        <span class="mx-1">/</span>
                                        <field class="narrow_field" name="bp_d" />
                                        <span class="text-muted me-4">mmHg</span>
                                    </div>
                                    <label for="heart_rate" />
                                    <div class="o_row">
                                        <field class="narrow_field" name="heart_rate" />
                                        <span class="text-muted me-4">/min</span>
                                    </div>
                                    <label for="oxygen_sat" />
                                    <div class="o_row">
                                        <field class="narrow_field" name="oxygen_sat" />
                                        <span class="text-muted me-4">%</span>
                                    </div>
                                </group>
                                <group>
                                    <label for="body_weight" />
                                    <div class="o_row">
                                        <field class="narrow_field" name="body_weight" />
                                        <span class="text-muted me-4">kg</span>
                                    </div>
                                    <label for="body_height" />
                                    <div class="o_row">
                                        <field class="narrow_field" name="body_height" />
                                        <span class="text-muted me-4">cm</span>
                                        <label for="bmi" />
                                        <field class="narrow_field mx-1" name="bmi" />
                                        <span class="text-muted me-4">kg/m²</span>
                                    </div>
                                    <label for="waist" />
                                    <div class="o_row">
                                        <field class="narrow_field" name="waist" />
                                        <span class="text-muted me-4">in</span>
                                    </div>
                                    <label for="hip" />
                                    <div class="o_row">
                                        <field class="narrow_field" name="hip" />
                                        <span class="text-muted me-4">in</span>
                                        <label for="whr" />
                                        <field class="narrow_field mx-1" name="whr" />
                                    </div>
                                    <span class="o_form_label o_td_label" name="glucose_type">
                                        <field name="glucose_type" class="fw-bold" />
                                    </span>
                                    <div class="o_row">
                                        <field
                                            class="narrow_field"
                                            name="fbs"
                                            attrs="{'invisible': [('glucose_type', '!=', 'fbs')]}"
                                        />
                                        <field
                                            class="narrow_field"
                                            name="dtx"
                                            attrs="{'invisible': [('glucose_type', '!=', 'dtx')]}"
                                        />
                                        <span class="text-muted me-4">mg/dl</span>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
