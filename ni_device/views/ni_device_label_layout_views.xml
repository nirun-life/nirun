<odoo>
    <record id="view_device_label_layout_form" model="ir.ui.view">
        <field name="name">ni.device.label.layout.form</field>
        <field name="model">ni.device.label.layout</field>
        <field name="arch" type="xml">
            <form string="Print Labels">
                <sheet>
                    <group>
                        <field name="device_id" invisible="1" />
                        <field name="quantity" />
                    </group>
                </sheet>
                <footer>
                    <button string="Print Label" type="object" name="action_print" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
