<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ───────────────────────────────────────────────
         ACTION  (เปิดจาก Menu หลัก — group by device)
    ─────────────────────────────────────────────────── -->
    <record id="ni_device_usage_action" model="ir.actions.act_window">
        <field name="name">All Device Usage</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ni.device.usage</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_device': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ไม่มีประวัติการใช้งานอุปกรณ์</p>
        </field>
    </record>
    <!-- ACTION เปิดจากหน้า Device — group by month, filter device นั้น -->
    <record id="ni_device_usage_action_by_device" model="ir.actions.act_window">
        <field name="name">Device Usage</field>
        <field name="res_model">ni.device.usage</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('device_id', '=', active_id)]</field>
        <field name="context">
            {
                'search_default_group_month': 1,
                'default_device_id': active_id
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีการบันทึกการใช้งาน</p>
            <p>เริ่มบันทึกผลการตรวจวัดจากอุปกรณ์นี้</p>
        </field>
    </record>
    <!-- ACTION เปิดจากหน้า Patient — group by month, filter patient นั้น -->
    <record id="ni_device_usage_action_by_patient" model="ir.actions.act_window">
        <field name="name">ประวัติการใช้งานอุปกรณ์</field>
        <field name="res_model">ni.device.usage</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('patient_id', '=', active_id)]</field>
        <field name="context">
            {
                'search_default_group_month': 1,
                'default_patient_id': active_id
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีการบันทึกการใช้งาน</p>
        </field>
    </record>
    <!-- ───────────────────────────────────────────────
         SEARCH VIEW
    ─────────────────────────────────────────────────── -->
    <record id="ni_device_usage_view_search" model="ir.ui.view">
        <field name="name">ni.device.usage.view.search</field>
        <field name="model">ni.device.usage</field>
        <field name="arch" type="xml">
            <search string="ค้นหาประวัติการใช้งาน">
                <field name="patient_id" string="ผู้ป่วย" />
                <field name="user_id" string="ผู้บันทึก" />
                <field name="device_id" string="อุปกรณ์" />
                <filter
                    name="filter_today"
                    string="วันนี้"
                    domain="[('occurrence','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S')),
                                 ('occurrence','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)).strftime('%Y-%m-%d %H:%M:%S'))]"
                />
                <filter
                    name="filter_this_month"
                    string="เดือนนี้"
                    domain="[('occurrence','&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('occurrence','&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"
                />
                <filter name="filter_has_patient" string="มีผู้ป่วย" domain="[('patient_id','!=',False)]" />
                <separator />
                <filter name="group_month" string="เดือน" context="{'group_by': 'occurrence:month'}" />
                <filter name="group_patient" string="ผู้ป่วย" context="{'group_by': 'patient_id'}" />
                <filter name="group_device" string="อุปกรณ์" context="{'group_by': 'device_id'}" />
                <filter name="group_user" string="ผู้บันทึก" context="{'group_by': 'user_id'}" />
            </search>
        </field>
    </record>
    <record id="ni_device_usage_view_tree" model="ir.ui.view">
        <field name="name">ni.device.usage.view.tree</field>
        <field name="model">ni.device.usage</field>
        <field name="arch" type="xml">
            <tree
                string="ประวัติการใช้งานอุปกรณ์"
                default_order="occurrence desc"
                decoration-muted="patient_id == False"
                sample="1"
            >
                <field name="occurrence" string="วันที่/เวลา" widget="datetime" />
                <field name="device_id" string="อุปกรณ์" optional="show" />
                <field name="patient_id" widget="many2one_avatar" optional="show" />
                <field name="user_id" string="ผู้บันทึก" widget="many2one_avatar" optional="show" />
            </tree>
        </field>
    </record>
    <record id="ni_device_usage_view_kanban" model="ir.ui.view">
        <field name="name">ni.device.usage.view.kanban</field>
        <field name="model">ni.device.usage</field>
        <field name="arch" type="xml">
            <kanban
                string="ประวัติการใช้งานอุปกรณ์"
                default_group_by="occurrence:month"
                default_order="occurrence desc"
                limit="16"
                class="o_kanban_small_column"
                quick_add="false"
                sample="1"
            >
                <field name="id" />
                <field name="occurrence" />
                <field name="patient_id" />
                <field name="user_id" />
                <field name="device_id" />
                <field name="res_model" />
                <field name="res_id" />
                <field name="res_name" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record p-0">
                            <a type="object" name="action_open_source" class="d-block text-reset text-decoration-none">
                                <div class="p-3">
                                    <!-- ── Header ── -->
                                    <div class="mb-2">
                                        <t t-if="!context.default_patient_id">
                                            <t t-if="record.patient_id.raw_value">
                                                <strong class="d-block text-truncate" t-esc="record.patient_id.value" />
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted fst-italic d-block">ไม่ระบุผู้ป่วย</span>
                                            </t>
                                        </t>
                                        <t t-if="!context.default_device_id">
                                            <t t-if="record.device_id.raw_value">
                                                <div class="text-truncate">
                                                    <t t-esc="record.device_id.value" />
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted fst-italic d-block">ไม่ระบุอุปกรณ์</span>
                                            </t>
                                        </t>
                                        <div class="text-muted small">
                                            <i class="fa fa-clock-o me-1" />
                                            <t t-esc="record.occurrence.value" />
                                        </div>
                                    </div>
                                    <t t-if="record.res_name.raw_value">
                                        <div
                                            t-att-class="
                                                'small text-truncate ' +
                                                (record.res_model.raw_value == 'ni.observation.sheet' and 'text-primary' or '') +
                                                (record.res_model.raw_value == 'ni.patient.smartcard' and ' text-info' or '')
                                            "
                                        >
                                            <i class="fa fa-link me-1" />
                                            <t t-esc="record.res_name.value" />
                                        </div>
                                    </t>
                                    <!-- ── Footer: ผู้บันทึก ── -->
                                    <div class="d-flex align-items-center gap-1 mt-2 pt-1 border-top">
                                        <img
                                            t-att-src="kanban_image('res.users', 'avatar_128', record.user_id.raw_value)"
                                            class="rounded-circle"
                                            style="width:18px;height:18px;object-fit:cover;"
                                        />
                                        <small class="text-muted" t-esc="record.user_id.value" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_device_usage_view_form" model="ir.ui.view">
        <field name="name">ni.device.usage.view.form</field>
        <field name="model">ni.device.usage</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_source"
                        string="ดูข้อมูลฉบับเต็ม"
                        icon="fa-search"
                        type="object"
                        class="btn btn-primary"
                    />
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>Device Usage Log</h2>
                    </div>
                    <!-- meta -->
                    <group>
                        <group>
                            <field name="device_id" readonly="1" />
                            <field name="patient_id" widget="many2one_avatar" readonly="1" />
                            <field name="res_model" readonly="1" />
                            <field name="res_name" />
                        </group>
                        <group>
                            <field
                                name="state"
                                widget="badge"
                                decoration-info="state == 'in-progress'"
                                decoration-warning="state == 'suspended'"
                                decoration-danger="state == 'abort'"
                                decoration-success="state == 'completed'"
                                readonly="1"
                            />
                            <field name="user_id" widget="many2one_avatar" readonly="1" />
                            <field name="occurrence" readonly="1" />
                        </group>
                    </group>
                    <!-- ปุ่มใหญ่ -->
                    <group string="Developer">
                        <field name="res_model" />
                        <field name="res_id" />
                    </group>
                    <button
                        name="action_fetch_from_source"
                        type="object"
                        string="อัพเดทข้อมูลจากต้นทาง"
                        class="btn btn-outline-danger"
                    />
                </sheet>
            </form>
        </field>
    </record>
</odoo>
