<odoo noupdate="1">
    <data>
        <record id="seq_ni_device" model="ir.sequence">
            <field name="name">Device</field>
            <field name="code">ni.device</field>
            <field name="prefix">DV-</field>
            <field name="padding">6</field>
            <field name="suffix">/%(year)s</field>
            <field name="company_id" eval="False" />
        </record>
        <record id="seq_ni_device_request" model="ir.sequence">
            <field name="name">Device Request</field>
            <field name="code">ni.device.request</field>
            <field name="prefix">DRX-%(year)s%(month)s</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False" />
        </record>
        <record id="seq_ni_device_holder" model="ir.sequence">
            <field name="name">Device Holder</field>
            <field name="code">ni.device.holder</field>
            <field name="prefix">DHD-%(year)s%(month)s</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False" />
        </record>
        <record id="seq_ni_device_repair" model="ir.sequence">
            <field name="name">Device Repair History</field>
            <field name="code">ni.device.repair</field>
            <field name="prefix">DRP-%(year)s%(month)s</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False" />
        </record>
        <record id="seq_ni_device_usage" model="ir.sequence">
            <field name="name">Device Usage</field>
            <field name="code">ni.device.usage</field>
            <field name="prefix">DU-%(year)s%(month)s</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False" />
        </record>
    </data>
</odoo>
