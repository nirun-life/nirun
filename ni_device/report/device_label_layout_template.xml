<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_device_label" model="ir.actions.report">
        <field name="name">Device Labels</field>
        <field name="model">ni.device</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ni_device.report_device_label</field>
        <field name="report_file">ni_device.report_device_label</field>
        <field name="print_report_name">'Device Label - %s' % (object.name)</field>
    </record>
    <template id="report_device_label">
        <t t-call="web.external_layout">
            <main>
                <t t-foreach="docs" t-as="o">
                    <div
                        style="
                    width:50mm;
                    height:30mm;
                    border:1px solid #000;
                    padding:4px;
                    box-sizing:border-box;
                "
                    >
                        <!-- ชื่ออุปกรณ์ -->
                        <div
                            style="
                        font-weight:bold;
                        font-size:10px;
                        line-height:1.4;
                    "
                        >
                            <t t-esc="o.name" />
                        </div>
                        <!-- Model + SN -->
                        <div
                            style="
                        font-size:8px;
                        line-height:1.4;
                        color:#555;
                    "
                        >
                            <t t-if="o.model_number">
                                Model:
                                <t t-esc="o.model_number" />
                            </t>
                            <t t-if="o.serial_number">
                                <br />
                                SN:
                                <t t-esc="o.serial_number" />
                            </t>
                            <t t-if="o.received_date">
                                <br />
                                Date:
                                <t t-esc="o.received_date" />
                            </t>
                        </div>
                        <!-- Barcode -->
                        <t t-if="o.barcode">
                            <div style="text-align:center; margin-top:18px;">
                                <img
                                    t-att-src="'/report/barcode/Code128/%s' % o.barcode"
                                    style="width:100%; height:28px;"
                                />
                                <div
                                    style="
                                font-size:8px;
                                margin-top:1.4px;
                                font-family:'DejaVu Sans Mono';
                            "
                                >
                                    <t t-esc="o.barcode" />
                                </div>
                            </div>
                        </t>
                    </div>
                    <div style="page-break-after: always;" />
                </t>
            </main>
        </t>
    </template>
</odoo>
