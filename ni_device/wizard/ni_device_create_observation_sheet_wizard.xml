<odoo>
    <record id="view_device_create_observation_sheet_wizard" model="ir.ui.view">
        <field name="name">ni.device.create.observation.sheet.form</field>
        <field name="model">ni.device.create.observation.sheet</field>
        <field name="arch" type="xml">
            <form string="Create Observation Sheet">
                <group>
                    <field name="device_id" />
                    <field name="patient_id" />
                </group>
                <footer>
                    <button name="action_confirm" string="Create" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
