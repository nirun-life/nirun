<odoo>
    <record id="view_device_report_lost_wizard" model="ir.ui.view">
        <field name="name">ni.device.report.lost.wizard.form</field>
        <field name="model">ni.device.report.lost.wizard</field>
        <field name="arch" type="xml">
            <form string="Device Status">
                <group>
                    <field name="action_type" />
                    <field name="device_id" />
                    <field name="note" attrs="{'required':[('action_type','=','lost')]}" />
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
