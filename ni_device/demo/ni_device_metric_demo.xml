<odoo>
    <data noupdate="1">
        <!-- Device Metrics -->
        <record id="metric_temperature" model="ni.device.metric">
            <field name="code">temperature</field>
            <field name="name">Body Temperature</field>
        </record>
        <record id="metric_bp_systolic" model="ni.device.metric">
            <field name="code">blood-pressure-systolic</field>
            <field name="name">Systolic Blood Pressure</field>
        </record>
        <record id="metric_bp_diastolic" model="ni.device.metric">
            <field name="code">blood-pressure-diastolic</field>
            <field name="name">Diastolic Blood Pressure</field>
        </record>
        <record id="metric_spo2" model="ni.device.metric">
            <field name="code">oxygen-saturation</field>
            <field name="name">Oxygen Saturation (SpO2)</field>
        </record>
        <record id="metric_heart_rate" model="ni.device.metric">
            <field name="code">heart-rate</field>
            <field name="name">Heart Rate</field>
        </record>
        <record id="metric_weight" model="ni.device.metric">
            <field name="code">weight</field>
            <field name="name">Body Weight</field>
        </record>
        <record id="metric_respiratory_rate" model="ni.device.metric">
            <field name="code">respiratory-rate</field>
            <field name="name">Respiratory Rate</field>
        </record>
    </data>
</odoo>
