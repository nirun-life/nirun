<odoo>
    <record id="careplan_template_company_rule" model="ir.rule">
        <field name="name">Careplan Template:  multi-company Sharable</field>
        <field name="model_id" ref="model_ni_careplan_template" />
        <field name="global" eval="True" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="careplan_template_manager_write_rule" model="ir.rule">
        <field name="name">Careplan Template: manager can only manage their own company's template</field>
        <field name="model_id" ref="model_ni_careplan_template" />
        <field name="domain_force">
            ['&amp;', ('company_id', '!=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="groups" eval="[(4, ref('ni_patient.group_manager'))]" />
    </record>
    <record id="careplan_template_admin_write_rule" model="ir.rule">
        <field name="name">Careplan Template: admin can manage shared template</field>
        <field name="model_id" ref="model_ni_careplan_template" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="groups" eval="[(4, ref('ni_patient.group_admin'))]" />
    </record>
    <record id="careplan_template_service_manager_write_rule" model="ir.rule">
