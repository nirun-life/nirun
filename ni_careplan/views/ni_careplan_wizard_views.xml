<odoo>
    <record id="ni_careplan_wizard_action" model="ir.actions.act_window">
        <field name="name">New Care Plan</field>
        <field name="res_model">ni.careplan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="ni_careplan_wizard_view_form" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.view.form</field>
        <field name="model">ni.careplan.wizard</field>
        <field name="arch" type="xml">
            <form string="New Care Plan">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="1,2,3,4,5" readonly="1" />
                </header>
                <field name="state" invisible="1" />
                <group>
                    <group>
                        <label for="patient_id" />
                        <div class="o_row">
                            <field name="patient_id" readonly="context.get('default_patient_id')" />
                        </div>
                        <label for="patient_gender" attrs="{'invisible': [('patient_id', '=', False)]}" />
                        <div class="o_row" attrs="{'invisible': [('patient_id', '=', False)]}">
                            <field name="patient_gender" />
                            <label for="patient_age" />
                            <field name="patient_age" />
                        </div>
                    </group>
                    <group>
                        <label for="encounter_id" attrs="{'invisible': [('encounter_id', '=', False)]}" />
                        <div class="o_row">
                            <field
                                name="encounter_id"
                                readonly="1"
                                attrs="{'invisible': [('encounter_id', '=', False)]}"
                            />
                        </div>
                    </group>
                </group>
                <div attrs="{'invisible': [('state', '!=', '1')]}">
                    <group string="Diagnosis &amp; Template">
                        <field name="category_id" options="{'no_create': True}" />
                        <field name="template_id" options="{'no_create': True}" />
                    </group>
                    <label for="condition_ids" />
                    <field name="condition_ids" mode="kanban" options="{'no_create': True}" />
                </div>
                <div attrs="{'invisible': [('state', '!=', '2')]}">
                    <separator string="Evident" />
                    <p class="text-muted">
                        Select patient observations to link as supporting evidence. Rows without recorded
                        data cannot be selected.
                    </p>
                    <field name="obs_line_ids" nolabel="1" />
                </div>
                <div attrs="{'invisible': [('state', '!=', '3')]}">
                    <separator string="Goals" />
                    <field name="goal_line_ids" nolabel="1" />
                </div>
                <div attrs="{'invisible': [('state', '!=', '4')]}">
                    <separator string="Intervention" />
                    <notebook class="no_controller">
                        <page name="service" string="Service">
                            <field name="service_line_ids" nolabel="1" />
                        </page>
                        <page name="medication" string="Medication">
                            <field name="medication_line_ids" nolabel="1" />
                        </page>
                    </notebook>
                </div>
                <div attrs="{'invisible': [('state', '!=', '5')]}">
                    <separator string="Confirm" />
                    <group>
                        <label for="period_start" string="Period" />
                        <div class="o_row">
                            <field name="period_start" />
                            <i class="fa fa-long-arrow-right mx-2 mt-2" />
                            <field name="period_end" />
                        </div>
                    </group>
                </div>
                <footer>
                    <button
                        name="action_prev"
                        type="object"
                        string="Back"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '=', '1')]}"
                    />
                    <button
                        name="action_next_step1_to_2"
                        type="object"
                        string="Next"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', '1')]}"
                    />
                    <button
                        name="action_next_step2_to_3"
                        type="object"
                        string="Next"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', '2')]}"
                    />
                    <button
                        name="action_next_step3_to_4"
                        type="object"
                        string="Next"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', '3')]}"
                    />
                    <button
                        name="action_next_step4_to_5"
                        type="object"
                        string="Next"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', '4')]}"
                    />
                    <button
                        name="action_save_draft"
                        type="object"
                        string="Save as draft"
                        class="btn btn-secondary"
                        attrs="{'invisible': [('state', '!=', '5')]}"
                    />
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm &amp; Create"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', '5')]}"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="ni_careplan_wizard_obs_line_view_tree" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.obs.line.view.tree</field>
        <field name="model">ni.careplan.wizard.obs.line</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not selected">
                <field name="patient_id" invisible="1" />
                <field
                    name="selected"
                    widget="boolean_toggle"
                    nolabel="1"
                    attrs="{'readonly': [('observation_id', '=', False)]}"
                />
                <field name="observation_type_id" string="Observation Type" />
                <field name="observation_id" string="Observation" options="{'no_create': True}" />
                <field name="occurrence" optional="show" />
            </tree>
        </field>
    </record>
    <record id="ni_careplan_wizard_obs_line_view_kanban" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.obs.line.view.kanban</field>
        <field name="model">ni.careplan.wizard.obs.line</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="observation_type_id" />
                <field name="observation_id" />
                <field name="occurrence" />
                <field name="selected" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card p-2">
                            <div class="fw-bold">
                                <t t-esc="record.observation_type_id.value" />
                            </div>
                            <div t-if="record.occurrence.raw_value" class="text-muted small mt-1">
                                <i class="fa fa-calendar-o me-1" />
                                <t t-esc="record.occurrence.value" />
                            </div>
                            <div t-else="" class="text-muted small mt-1">No data recorded</div>
                            <div class="mt-2">
                                <field
                                    name="selected"
                                    widget="boolean_toggle"
                                    attrs="{'readonly': [('observation_id', '=', False)]}"
                                />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_careplan_wizard_goal_line_view_tree" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.goal.line.view.tree</field>
        <field name="model">ni.careplan.wizard.goal.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-muted="not selected">
                <field name="selected" widget="boolean_toggle" nolabel="1" />
                <field name="goal_code_id" string="Goal" optional="show" />
                <field name="name" string="Goal Name" />
                <field name="observation_type_id" string="Measure" optional="show" />
                <field name="target_min" string="Min" attrs="{'invisible': [('observation_type_id', '=', False)]}" />
                <field name="target_max" string="Max" attrs="{'invisible': [('observation_type_id', '=', False)]}" />
            </tree>
        </field>
    </record>
    <record id="ni_careplan_wizard_service_line_view_tree" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.service.line.view.tree</field>
        <field name="model">ni.careplan.wizard.service.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-muted="not selected">
                <field name="selected" widget="boolean_toggle" nolabel="1" />
                <field name="name" string="Service Name" />
                <field name="service_ids" widget="many2many_tags" optional="show" />
                <field name="timing_tmpl_id" optional="show" />
            </tree>
        </field>
    </record>
    <record id="ni_careplan_wizard_medication_line_view_tree" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.medication.line.view.tree</field>
        <field name="model">ni.careplan.wizard.medication.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-muted="not selected">
                <field name="selected" widget="boolean_toggle" nolabel="1" />
                <field name="medication_id" />
                <field name="quantity" />
                <field name="note" />
            </tree>
        </field>
    </record>
    <record id="ni_careplan_wizard_obs_line_view_form" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.obs.line.view.form</field>
        <field name="model">ni.careplan.wizard.obs.line</field>
        <field name="arch" type="xml">
            <form string="Observation">
                <field name="wizard_id" invisible="1" />
                <field name="patient_id" invisible="1" />
                <sheet>
                    <group>
                        <field name="observation_type_id" options="{'no_create': True}" />
                        <field
                            name="observation_id"
                            options="{'no_create': True}"
                            domain="[('patient_id', '=', patient_id), ('type_id', '=', observation_type_id)]"
                        />
                        <field name="occurrence" />
                        <field name="selected" attrs="{'readonly': [('observation_id', '=', False)]}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_careplan_wizard_goal_line_view_kanban" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.goal.line.view.kanban</field>
        <field name="model">ni.careplan.wizard.goal.line</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="goal_code_id" />
                <field name="name" />
                <field name="observation_type_id" />
                <field name="target_min" />
                <field name="target_max" />
                <field name="selected" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="fw-bold">
                                <t t-esc="record.name.value or record.goal_code_id.value" />
                            </div>
                            <div t-if="record.observation_type_id.raw_value" class="text-muted small mt-1">
                                <t t-esc="record.observation_type_id.value" />
                                :
                                <t t-esc="record.target_min.value" />
                                –
                                <t t-esc="record.target_max.value" />
                            </div>
                            <div class="mt-2">
                                <field name="selected" widget="boolean_toggle" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_careplan_wizard_service_line_view_kanban" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.service.line.view.kanban</field>
        <field name="model">ni.careplan.wizard.service.line</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="service_ids" />
                <field name="timing_tmpl_id" />
                <field name="selected" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="fw-bold">
                                <t t-esc="record.name.value" />
                            </div>
                            <div class="mt-1">
                                <field name="service_ids" widget="many2many_tags" />
                            </div>
                            <div t-if="record.timing_tmpl_id.raw_value" class="text-muted small mt-1">
                                <i class="fa fa-clock-o me-1" />
                                <t t-esc="record.timing_tmpl_id.value" />
                            </div>
                            <div class="mt-2">
                                <field name="selected" widget="boolean_toggle" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_careplan_wizard_medication_line_view_kanban" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.medication.line.view.kanban</field>
        <field name="model">ni.careplan.wizard.medication.line</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="medication_id" />
                <field name="quantity" />
                <field name="note" />
                <field name="selected" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="fw-bold">
                                <t t-esc="record.medication_id.value" />
                            </div>
                            <div class="text-muted small mt-1">
                                Qty:
                                <t t-esc="record.quantity.value" />
                                <t t-if="record.note.raw_value">
                                    —
                                    <t t-esc="record.note.value" />
                                </t>
                            </div>
                            <div class="mt-2">
                                <field name="selected" widget="boolean_toggle" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_careplan_wizard_goal_line_view_form" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.goal.line.view.form</field>
        <field name="model">ni.careplan.wizard.goal.line</field>
        <field name="arch" type="xml">
            <form string="Goal">
                <field name="wizard_id" invisible="1" />
                <sheet>
                    <group>
                        <field name="goal_code_id" options="{'no_create': True}" />
                        <field name="name" attrs="{'required': [('goal_code_id', '=', False)]}" />
                        <field name="observation_type_id" options="{'no_create': True}" />
                        <field name="target_min" attrs="{'invisible': [('observation_type_id', '=', False)]}" />
                        <field name="target_max" attrs="{'invisible': [('observation_type_id', '=', False)]}" />
                        <field name="selected" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_careplan_wizard_service_line_view_form" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.service.line.view.form</field>
        <field name="model">ni.careplan.wizard.service.line</field>
        <field name="arch" type="xml">
            <form string="Service Request">
                <field name="wizard_id" invisible="1" />
                <sheet>
                    <div class="oe_title">
                        <div class="d-flex">
                            <field name="category_id" options="{'no_open': True}" placeholder="Category" />
                            <field
                                name="service_ids"
                                class="ms-1 flex-fill"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                                placeholder="Services..."
                            />
                        </div>
                        <div>
                            <field name="name" placeholder="Service name" />
                        </div>
                    </div>
                    <group class="mt-3">
                        <field name="timing_tmpl_id" options="{'no_create': True}" />
                        <field name="selected" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_careplan_wizard_medication_line_view_form" model="ir.ui.view">
        <field name="name">ni.careplan.wizard.medication.line.view.form</field>
        <field name="model">ni.careplan.wizard.medication.line</field>
        <field name="arch" type="xml">
            <form string="Medication">
                <field name="wizard_id" invisible="1" />
                <sheet>
                    <group>
                        <field name="medication_id" options="{'no_create': True}" />
                        <field name="quantity" />
                        <field name="note" />
                        <field name="selected" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
