<odoo>
    <record id="ni_careplan_template_action" model="ir.actions.act_window">
        <field name="name">Careplan Template</field>
        <field name="res_model">ni.careplan.template</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="ni_careplan_template_view_search" model="ir.ui.view">
        <field name="name">ni.careplan.template.view.search</field>
        <field name="model">ni.careplan.template</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    filter_domain="['|', '|',('name', 'ilike', self), ('code', 'ilike', self), ('abbr', 'ilike', self)]"
                />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
                <separator />
                <filter name="shared" string="Shared" domain="[('company_id', '=', False)]" />
                <filter
                    name="private"
                    string="Private"
                    domain="[('company_id', '!=', False)]"
                    groups="base.group_multi_company"
                />
                <group name="group_by" string="Group By">
                    <filter name="group_category_id" context="{'group_by': 'category_id'}" />
                    <filter name="system" string="System" context="{'group_by': 'system_id'}" />
                    <filter
                        name="group_company_id"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="ni_careplan_template_view_tree" model="ir.ui.view">
        <field name="name">ni.careplan.template.view.tree</field>
        <field name="model">ni.careplan.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" optional="show" />
                <field
                    name="condition_code_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                />
                <field
                    name="goal_code_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                />
                <field name="service_request_ids" widget="many2many_tags" optional="show" />
                <field name="system_id" optional="hide" />
                <field name="color" optional="hide" widget="color_picker" />
                <field name="active" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="ni_careplan_template_view_form" model="ir.ui.view">
        <field name="name">ni.careplan.template.view.form</field>
        <field name="model">ni.careplan.template</field>
        <field name="arch" type="xml">
            <form>
                <field name="id" invisible="True" />
                <field name="active" invisible="True" />
                <sheet>
                    <widget
                        name="web_ribbon"
                        attrs="{'invisible': [('active', '=', True)]}"
                        bg_color="bg-danger"
                        title="Archived"
                    />
                    <label for="name" class="oe_edit_only" />
                    <field name="name" />
                    <label for="definition" class="oe_edit_only" />
                    <field name="definition" placeholder="Definition..." />
                    <group>
                        <field name="shared_category_ids" invisible="1" />
                        <field name="company_id" />
                        <field name="category_id" />
                    </group>
                    <group>
                        <group>
                            <field name="abbr" string="abbr." />
                        </group>
                        <group>
                            <field name="code" />
                        </group>
                    </group>
                    <separator name="condition" string="Condition" />
                    <field name="condition_code_ids" />
                    <separator name="goal" string="Goal" />
                    <field name="goal_code_ids" />
                    <separator name="observation" string="Observation Types" />
                    <field name="observation_type_ids" />
                    <separator name="service" string="Service" />
                    <field name="service_request_ids" />
                    <separator name="medication" string="Medications" />
                    <field name="medication_request_ids" />
                    <notebook groups="base.group_no_one">
                        <page string="Extra Info" groups="base.group_no_one">
                            <group name="configuration" string="Configuration">
                                <group>
                                    <field name="system_id" />
                                </group>
                            </group>
                            <group>
                                <group name="display" string="Display">
                                    <field name="color" widget="color_picker" />
                                    <field name="sequence" />
                                </group>
                                <group name="metadata" string="Metadata">
                                    <field name="create_date" />
                                    <field name="create_uid" widget="many2one_avatar_user" />
                                    <field name="write_date" />
                                    <field name="write_uid" widget="many2one_avatar_user" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_careplan_template_service_request_view_tree" model="ir.ui.view">
        <field name="name">ni.careplan.template.service.request.view.tree</field>
        <field name="model">ni.careplan.template.service.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="company_id" invisible="1" />
                <field name="service_ids" invisible="1" />
                <field name="name" />
                <field name="timing_tmpl_id" />
            </tree>
        </field>
    </record>
    <record id="ni_careplan_template_service_request_view_form" model="ir.ui.view">
        <field name="name">ni.careplan.template.service.request.view.form</field>
        <field name="model">ni.careplan.template.service.request</field>
        <field name="arch" type="xml">
            <form>
                <field name="name" invisible="1" />
                <field name="template_id" invisible="1" />
                <sheet>
                    <div class="oe_title">
                        <div class="d-flex">
                            <label for="name" class="flex-fill" />
                        </div>
                        <div class="d-flex">
                            <field name="category_id" options="{'no_open': True}" placeholder="Category" />
                            <field
                                name="service_ids"
                                class="ms-1 flex-fill"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                                placeholder="Services..."
                                attrs="{'required': [('name', '=', False)]}"
                            />
                        </div>
                        <div>
                            <field name="name" placeholder="Specify service name" />
                        </div>
                    </div>
                    <group class="mt-3">
                        <label for="timing_tmpl_id" />
                        <div class="o_row">
                            <field
                                name="timing_tmpl_id"
                                options="{'no_create':True, 'no_create_edit':True}"
                                placeholder="choose from..."
                            />
                        </div>
                        <field name="company_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_careplan_template_medication_request_view_tree" model="ir.ui.view">
        <field name="name">ni.careplan.template.medication.request.view.tree</field>
        <field name="model">ni.careplan.template.medication.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="quantity" />
                <field name="dosage_display" string="Dosage" />
            </tree>
        </field>
    </record>
    <record id="ni_careplan_template_medication_request_view_form" model="ir.ui.view">
        <field name="name">ni.careplan.template.medication.request.view.form</field>
        <field name="model">ni.careplan.template.medication.request</field>
        <field name="arch" type="xml">
            <form>
                <field name="company_id" invisible="1" />
                <field name="template_id" invisible="1" />
                <field name="medication_dosage_ids" invisible="1" />
                <sheet>
                    <label for="medication_id" class="oe_edit_only" />
                    <div>
                        <field
                            name="medication_id"
                            class="w-100 oe_edit_only"
                            options="{'no_create': True}"
                            placeholder="Medication..."
                        />
                    </div>
                    <field name="name" placeholder="Medication name" />
                    <group class="mt-4">
                        <field name="quantity" />
                        <field name="dosage_tmpl_id" string="Dosage Preset" options="{'no_create': True}" />
                        <field name="dosage_display" string="Dosage" readonly="1" />
                    </group>
                    <label for="note" class="oe_edit_only" />
                    <field name="note" />
                </sheet>
            </form>
        </field>
    </record>
</odoo>
