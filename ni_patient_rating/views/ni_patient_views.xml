<odoo>
    <record id="rating_rating_action_ni_patient" model="ir.actions.act_window">
        <field name="name">Ratings</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">kanban,pivot,graph</field>
        <field name="domain">
            [('parent_res_model', '=', 'ni.patient'), ('parent_res_id', '=', active_id), ('consumed', '=', True)]
        </field>
    </record>
    <record id="ni_patient_view_form_inherit" model="ir.ui.view">
        <field name="name">ni.patient.view.form.inherit</field>
        <field name="model">ni.patient</field>
        <field name="inherit_id" ref="ni_patient.ni_patient_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="before">
                <field name="rating_count" invisible="1" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="%(rating_rating_action_ni_patient)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-smile-o"
                    attrs="{'invisible': [('rating_count', '=', 0)]}"
                >
                    <field name="rating_avg" string="Rating" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
