<odoo>
    <record id="ni_encounter_diagnosis_view_form" model="ir.ui.view">
        <field name="name">ni.encounter.diagnosis.view.form</field>
        <field name="model">ni.encounter.diagnosis</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <field name="encounter_id" invisible="1" />
                    <field name="patient_id" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="sequence" invisible="1" />
                    <field name="role_decoration" invisible="1" />
                    <field name="system_ids" invisible="1" />
                    <div class="mb24">
                        <label for="name" />
                        <field
                            name="system_id"
                            widget="radio"
                            options="{'horizontal': True}"
                            class="float-end oe_edit_only"
                        />
                        <div>
                            <field
                                name="code_id"
                                class="w-100 oe_edit_only"
                                placeholder="Search for condition by name or code..."
                                options="{'no_open': True, 'always_reload': True}"
                                context="{'show_code': True, 'default_system_id': system_id}"
                            />
                        </div>
                        <div>
                            <field name="name" class="w-100" placeholder="Condition name use for display" />
                        </div>
                        <p
                            class="text-muted small"
                            attrs="{'invisible': ['|', ('code_id', '!=', False), ('name', '!=', False)]}"
                        >
                            Specify condition name here if not found on selectable choice
                            above
                        </p>
                    </div>
                    <group>
                        <group>
                            <field
                                name="role_id"
                                widget="radio"
                                options="{'no_open': True}"
                                attrs="{'required': [('is_diagnosis', '=', True)], 'invisible': [('is_diagnosis', '=', False)]}"
                            />
                            <field name="severity" widget="radio" options="{'horizontal': True}" />
                        </group>
                        <group>
                            <field name="category_ids" widget="many2many_checkboxes" invisible="1" />
                            <field name="is_diagnosis" invisible="1" />
                            <field name="is_problem" invisible="1" />
                        </group>
                    </group>
                    <field name="note" placeholder="Additional note..." />
                    <notebook>
                        <page
                            name="observation"
                            string="Observation"
                            icon="fa-stethoscope"
                            badge="observation_count"
                            attrs="{'invisible': [('code_id', '=', False)]}"
                        >
                            <field name="observation_ids" />
                            <field name="observation_count" invisible="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_encounter_diagnosis_view_tree" model="ir.ui.view">
        <field name="name">ni.encounter.diagnosis.view.tree</field>
        <field name="model">ni.encounter.diagnosis</field>
        <field name="arch" type="xml">
            <tree decoration-muted="is_problem and not is_diagnosis">
                <field name="company_id" invisible="1" />
                <field name="encounter_id" invisible="1" />
                <field name="patient_id" invisible="1" />
                <field name="role_decoration" invisible="1" />
                <field name="is_problem" invisible="1" />
                <field name="is_problem_editable" invisible="1" />
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field
                    name="severity"
                    optional="hide"
                    decoration-danger="severity == 'severe'"
                    decoration-warning="severity == 'moderate'"
                    widget="badge"
                />
                <field
                    name="role_id"
                    widget="badge"
                    decoration-primary="role_decoration == 'primary'"
                    decoration-success="role_decoration == 'success'"
                    decoration-info="role_decoration == 'info'"
                    decoration-warning="role_decoration == 'warning'"
                    decoration-danger="role_decoration == 'danger'"
                    decoration-muted="role_decoration == 'muted'"
                />
                <field name="is_diagnosis" optional="hide" />
                <button
                    name="action_toggle_is_diagnosis"
                    type="object"
                    class="btn-info o_btn_text_normal"
                    icon="fa-stethoscope"
                    title="Diagnosis (click to unmark)"
                    string="Marked as Diagnosis"
                    attrs="{'invisible': [('is_diagnosis', '=', False)]}"
                />
                <button
                    name="action_toggle_is_diagnosis"
                    type="object"
                    class="btn-outline-info"
                    icon="fa-stethoscope"
                    title="Not a Diagnosis (click to mark)"
                    string="Mark as Diagnosis"
                    attrs="{'invisible': [('is_diagnosis', '=', True)]}"
                />
                <button
                    name="action_toggle_is_problem"
                    type="object"
                    class="btn-primary o_btn_text_normal"
                    icon="fa-list-ul "
                    title="Problem-List Item (click to unmark)"
                    string="Marked as Problem-List"
                    attrs="{'invisible': ['|', ('is_problem', '=', False), ('is_problem_editable', '=', False)]}"
                />
                <button
                    name="action_toggle_is_problem"
                    type="object"
                    class="btn-outline-primary"
                    icon="fa-list-ul"
                    title="Not on Problem-List (click to mark)"
                    string="Mark as Problem-List"
                    attrs="{'invisible': ['|', ('is_problem', '=', True), ('is_problem_editable', '=', False)]}"
                />
                <button
                    name="action_toggle_is_problem"
                    type="object"
                    class="btn-primary o_btn_text_normal opacity-50"
                    icon="fa-list-ul opacity-50"
                    title="Problem-List Item (set in a prior encounter, locked)"
                    string="Marked as Problem-List"
                    attrs="{'invisible': ['|', ('is_problem', '=', False), ('is_problem_editable', '=', True)]}"
                />
                <field name="create_uid" optional="hide" />
                <field name="create_date" optional="hide" />
                <control>
                    <create string="Add Diagnosis" context="{'default_is_diagnosis': True, 'default_sequence': 0}" />
                    <create
                        string="Add Problem-List"
                        context="{'default_is_problem': True, 'default_is_diagnosis': False, 'default_sequence': 99}"
                    />
                </control>
            </tree>
        </field>
    </record>
    <record id="ni_encounter_diagnosis_view_kanban" model="ir.ui.view">
        <field name="name">ni.encounter.diagnosis.view.kanban</field>
        <field name="model">ni.encounter.diagnosis</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="code" />
                <field name="role_id" />
                <field name="severity" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title d">
                                        <field name="name" />
                                    </strong>
                                </div>
                                <div class="me-1 small text-body">
                                    <field name="code" />
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="role_id" />
                                </div>
                                <div class="oe_kanban_bottom_right mr4">
                                    <field
                                        name="severity"
                                        widget="label_selection"
                                        options="{'classes': {'mild': 'default', 'moderate': 'warning', 'severe':'danger'}}"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
