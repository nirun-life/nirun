<odoo>
    <record id="ni_medication_suggest_line_action" model="ir.actions.act_window">
        <field name="name">Medication Suggestion Line</field>
        <field name="res_model">ni.medication.suggest.line</field>
        <field name="view_mode">tree,form,calendar,pivot,graph,activity</field>
    </record>
    <record id="ni_medication_suggest_line_view_search" model="ir.ui.view">
        <field name="name">ni.medication.suggest.line.view.search</field>
        <field name="model">ni.medication.suggest.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="medication_id" />
            </search>
        </field>
    </record>
    <record id="ni_medication_suggest_line_view_tree" model="ir.ui.view">
        <field name="name">ni.medication.suggest.line.view.tree</field>
        <field name="model">ni.medication.suggest.line</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="category_id" optional="hide" />
                <field name="medication_id" />
                <field name="dosage_id" optional="show" />
                <field name="quantity" />
            </tree>
        </field>
    </record>
    <record id="ni_medication_suggestion_line_view_form" model="ir.ui.view">
        <field name="name">ni.medication.suggest.line.view.form</field>
        <field name="model">ni.medication.suggest.line</field>
        <field name="arch" type="xml">
            <form>
                <field name="id" invisible="True" />
                <field name="suggest_id" invisible="1" />
                <sheet>
                    <field
                        name="medication_image_1920"
                        class="oe_avatar"
                        options="{'preview_image': 'medication_image_128'}"
                        widget="image"
                    />
                    <div class="oe_title">
                        <div class="d-flex">
                            <label for="medication_id" class="flex-fill" />
                        </div>
                        <h4>
                            <field
                                name="medication_id"
                                class="w-100"
                                options="{'no_open': True}"
                                placeholder="e.g. Paracetamol 500mg"
                                domain="[('reason_ids', '=?', reason_id)]"
                            />
                        </h4>
                    </div>
                    <group>
                        <group>
                            <field name="reason_id" />
                            <field name="reason_ids" invisible="1" />
                            <label for="quantity" />
                            <div>
                                <field name="quantity" class="narrow_field" />
                                <field name="medication_dose_unit_id" class="oe_inline" options="{'no_open': True}" />
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page name="dosage" string="Dosage">
                            <div name="Dosage Template" attrs="{'invisible': [('medication_id', '=', False)]}">
                                <separator string="Dosage Template" />
                                <field name="medication_dosage_ids" invisible="1" />
                                <field name="medication_dosage_count" invisible="1" />
                                <field name="medication_dose_unit_id" invisible="1" />
                                <p
                                    class="text-muted"
                                    attrs="{'invisible': ['|',('medication_id', '=', False), ('medication_dosage_count', '>', 0)]}"
                                >
                                    There is no template for this medication
                                </p>
                                <field
                                    name="dosage_tmpl_id"
                                    context="{'show_text': True, 'show_additional':True}"
                                    options="{'no_create':True}"
                                    widget="radio"
                                />
                            </div>
                            <group name="Dosage">
                                <group string="Dosage">
                                    <field name="dosage_id" invisible="1" />
                                    <field name="dosage_display" placeholder="Summary of medication usage..." />
                                    <label for="dose" />
                                    <div class="o_row">
                                        <field name="dose" />
                                        <field
                                            name="dose_unit_id"
                                            attrs="{'required': [('dose', '!=', 0 )]}"
                                            placeholder="ex. tab, ml"
                                        />
                                    </div>
                                    <!--                                    <field-->
                                    <!--                                        name="timing_id"-->
                                    <!--                                        domain="[('id', '=', False)]"-->
                                    <!--                                        options="{'no_quick_create':True}"-->
                                    <!--                                        placeholder="Summary of medication usage..."-->
                                    <!--                                        groups="base.group_no_one"-->
                                    <!--                                    />-->
                                    <!--                                    <field name="dosage_when" groups="base.group_no_one" />-->
                                    <field name="timing_type" widget="radio" options="{'horizontal':True}" />
                                    <field
                                        name="meal_timing"
                                        widget="radio"
                                        options="{'horizontal':True}"
                                        attrs="{'invisible': [('timing_type', '!=', 'meal')]}"
                                    />
                                    <field
                                        name="period_ids"
                                        widget="many2many_checkboxes"
                                        options="{'horizontal':True}"
                                        attrs="{'invisible': [('timing_type', 'not in', ['meal', 'period'])]}"
                                        domain="[('code', 'in', timing_type == 'meal' and ['M', 'D', 'V'] or ['MORN', 'AFT', 'EVE', 'HS','WAKE'])]"
                                    />
                                    <field
                                        name="meal_offset"
                                        attrs="{'invisible': ['|', ('timing_type', '!=', 'meal'), ('meal_timing', '=', 'C')]}"
                                    />
                                    <label
                                        for="timing_frequency"
                                        attrs="{'invisible': [('timing_type', '!=', 'custom')]}"
                                    />
                                    <div class="o_row" attrs="{'invisible': [('timing_type', '!=', 'custom')]}">
                                        <field name="timing_frequency" class="oe_inline" />
                                        <span>-</span>
                                        <field name="timing_frequency_max" class="oe_inline" />
                                        <span>Times</span>
                                    </div>
                                    <label
                                        string="Duration"
                                        for="timing_duration"
                                        attrs="{'invisible': [('timing_type', '!=', 'custom')]}"
                                    />
                                    <div class="o_row" attrs="{'invisible': [('timing_type', '!=', 'custom')]}">
                                        <field name="timing_duration" class="oe_inline" />
                                        <span>-</span>
                                        <field name="timing_duration_max" class="oe_inline" />
                                        <field
                                            name="timing_duration_unit"
                                            nolabel="True"
                                            placeholder="Select Duration Unit"
                                            decoration-muted="timing_duration_unit == False"
                                        />
                                    </div>
                                    <label
                                        string="Repeat Every"
                                        for="timing_period"
                                        attrs="{'invisible': [('timing_type', '!=', 'custom')]}"
                                    />
                                    <div class="o_row" attrs="{'invisible': [('timing_type', '!=', 'custom')]}">
                                        <field name="timing_period" class="oe_inline" />
                                        <span>-</span>
                                        <field name="timing_period_max" class="oe_inline" />
                                        <field name="timing_period_unit" string="Unit" />
                                    </div>
                                    <field
                                        name="timing_tod"
                                        context="{'default_timing_id': id}"
                                        attrs="{'invisible': [('timing_type', '!=', 'custom')]}"
                                        mode="kanban"
                                    />
                                    />
                                    <field name="as_need" />
                                    <field
                                        name="additional_ids"
                                        widget="many2many_tags"
                                        options="{'color_field': 'color'}"
                                    />
                                </group>
                                <group string="Administration Method">
                                    <!--                                       attrs="{'invisible': [('dosage_tmpl_id', '=', False), ('custom_checkbox_dosage', '=', False)]}">-->
                                    <field name="route_id" placeholder="ex. IV, po" />
                                    <field name="method_id" placeholder="ex. Inj" />
                                    <field name="site_id" placeholder="ex. OD, OS" />
                                </group>
                            </group>
                            <field name="text" placeholder="Describe more additional dosage here..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_medication_suggestion_line_view_kanban" model="ir.ui.view">
        <field name="name">ni.medication.suggest.line.view.kanban</field>
        <field name="model">ni.medication.suggest.line</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="medication_id" />
                <field name="dosage_id" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title d">
                                        <field name="medication_id" />
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <div class="small">
                                        <field name="dosage_id" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
