<odoo>
    <record id="ni_medication_dosage_action" model="ir.actions.act_window">
        <field name="name">Medication Forms</field>
        <field name="res_model">ni.medication.dosage</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <record id="ni_medication_dosage_view_search" model="ir.ui.view">
        <field name="name">ni.medication.dosage.view.search</field>
        <field name="model">ni.medication.dosage</field>
        <field name="arch" type="xml">
            <search>
                <field name="timing_id" />
            </search>
        </field>
    </record>
    <record id="ni_medication_dosage_view_kanban" model="ir.ui.view">
        <field name="name">ni.medication.dosage.view.kanban</field>
        <field name="model">ni.medication.dosage</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="sequence" widget="handle" />
                <field name="color" widget="color_picker" />
                <field name="timing_id" />
                <field name="timing_tmpl_id" />
                <field name="additional_ids" />
                <field name="site_id" />
                <field name="method_id" />
                <field name="text" />
                <field name="route_id" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''} oe_kanban_global_click"
                        >
                            <div class="o_dropdown_kanban dropdown" t-if="widget.editable">
                                <a
                                    aria-label="Dropdown menu"
                                    class="dropdown-toggle o-no-caret btn"
                                    data-display="static"
                                    data-toggle="dropdown"
                                    href="#"
                                    role="button"
                                    title="Dropdown menu"
                                >
                                    <span class="fa fa-ellipsis-v" />
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable">
                                        <a class="dropdown-item" role="menuitem" type="edit">Edit</a>
                                    </t>
                                    <ul class="oe_kanban_colorpicker" data-field="color" />
                                </div>
                            </div>
                            <div t-attf-class="oe_kanban_record">
                                <div>
                                    <strong class="o_kanban_record_title">
                                        <span>
                                            <field name="timing_id" />
                                            <field name="timing_tmpl_id" />
                                        </span>
                                    </strong>
                                </div>
                                <div>
                                    <small class="o_kanban_record_subtitle">
                                        <field name="text" />
                                    </small>
                                </div>
                                <div class="my-2">
                                    <field
                                        name="additional_ids"
                                        options="{'color_field': 'color'}"
                                        widget="many2many_tags"
                                    />
                                </div>
                            </div>
                            <div class="oe_clear" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_medication_dosage_view_tree" model="ir.ui.view">
        <field name="name">ni.medication.dosage.view.tree</field>
        <field name="model">ni.medication.dosage</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="sequence" widget="handle" />
                <field name="timing_tmpl_id" class="oe_edit_only" />
                <field name="timing_id" />
                <field
                    name="additional_ids"
                    optional="show"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
                <field name="dose" />
                <field name="dose_unit_id" attrs="{'required': [('dose', '!=', 0 )]}" />
                <field name="text" optional="hide" />
                <field name="as_need" optional="hide" />
                <field name="site_id" optional="hide" />
                <field name="method_id" optional="hide" />
                <field name="route_id" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="ni_medication_dosage_view_form" model="ir.ui.view">
        <field name="name">ni.medication.dosage.view.form</field>
        <field name="model">ni.medication.dosage</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group string="Dosage">
                        <field
                            name="display_name"
                            string="Dosage Summary"
                            placeholder="Summary of medication usage..."
                        />
                        <label for="dose" />
                        <div class="o_row">
                            <field name="dose" />
                            <field
                                name="dose_unit_id"
                                attrs="{'required': [('dose', '!=', 0 )]}"
                                placeholder="ex. tab, ml"
                            />
                        </div>
                        <field name="timing_type" widget="radio" options="{'horizontal':True}" />
                        <field
                            name="meal_timing"
                            widget="radio"
                            options="{'horizontal':True}"
                            attrs="{'invisible': [('timing_type', '!=', 'meal')]}"
                        />
                        <field
                            name="period_ids"
                            widget="many2many_checkboxes"
                            options="{'horizontal':True}"
                            attrs="{'invisible': [('timing_type', 'not in', ['meal', 'period'])]}"
                            domain="[('code', 'in', timing_type == 'meal' and ['M', 'D', 'V'] or ['MORN', 'AFT', 'EVE', 'HS','WAKE'])]"
                        />
                        <field
                            name="meal_offset"
                            attrs="{'invisible': ['|', ('timing_type', '!=', 'meal'), ('meal_timing', '=', 'C')]}"
                        />
                        <label for="timing_frequency" attrs="{'invisible': [('timing_type', '!=', 'custom')]}" />
                        <div class="o_row" attrs="{'invisible': [('timing_type', '!=', 'custom')]}">
                            <field name="timing_frequency" class="oe_inline" />
                            <span>-</span>
                            <field name="timing_frequency_max" class="oe_inline" />
                            <span>Times</span>
                        </div>
                        <label
                            string="Duration"
                            for="timing_duration"
                            attrs="{'invisible': [('timing_type', '!=', 'custom')]}"
                        />
                        <div class="o_row" attrs="{'invisible': [('timing_type', '!=', 'custom')]}">
                            <field name="timing_duration" class="oe_inline" />
                            <span>-</span>
                            <field name="timing_duration_max" class="oe_inline" />
                            <field
                                name="timing_duration_unit"
                                nolabel="True"
                                placeholder="Select Duration Unit"
                                decoration-muted="timing_duration_unit == False"
                            />
                        </div>
                        <label
                            string="Repeat Every"
                            for="timing_period"
                            attrs="{'invisible': [('timing_type', '!=', 'custom')]}"
                        />
                        <div class="o_row" attrs="{'invisible': [('timing_type', '!=', 'custom')]}">
                            <field name="timing_period" class="oe_inline" />
                            <span>-</span>
                            <field name="timing_period_max" class="oe_inline" />
                            <field name="timing_period_unit" string="Unit" />
                        </div>
                        <field
                            name="timing_tod"
                            context="{'default_timing_id': id}"
                            attrs="{'invisible': [('timing_type', '!=', 'custom')]}"
                            mode="kanban"
                        />
                        />
                        <field name="as_need" />
                        <field name="additional_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                    </group>
                    <group string="Administration Method">
                        <field name="route_id" placeholder="ex. IV, po" />
                        <field name="method_id" placeholder="ex. Inj" />
                        <field name="site_id" placeholder="ex. OD, OS" />
                    </group>
                </group>
                <field name="text" placeholder="Describe more additional dosage here..." />
            </form>
        </field>
    </record>
</odoo>
