<odoo>
    <record id="ni_encounter_diet_action" model="ir.actions.act_window">
        <field name="name">Diet</field>
        <field name="res_model">ni.encounter.diet</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="ni_encounter_diet_view_search" model="ir.ui.view">
        <field name="name">ni.encounter.diet.view.search</field>
        <field name="model">ni.encounter.diet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>
    <record id="ni_encounter_diet_view_tree" model="ir.ui.view">
        <field name="name">ni.encounter.diet.view.list</field>
        <field name="model">ni.encounter.diet</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" optional="show" />
                <field name="color" optional="hide" widget="color_picker" />
                <field name="active" optional="hide" />
            </list>
        </field>
    </record>
    <record id="ni_encounter_diet_view_form" model="ir.ui.view">
        <field name="name">ni.encounter.diet.view.form</field>
        <field name="model">ni.encounter.diet</field>
        <field name="arch" type="xml">
            <form>
                <field name="id" invisible="True" />
                <field name="active" invisible="True" />
                <sheet>
                    <widget
                        name="web_ribbon"
                        bg_color="bg-danger"
                        title="Archived"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="code" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Definition">
                            <field name="definition" />
                        </page>
                        <page string="Extra Info" groups="base.group_no_one">
                            <group>
                                <group>
                                    <field name="color" widget="color_picker" />
                                    <field name="sequence" />
                                </group>
                                <group>
                                    <field name="create_date" />
                                    <field name="create_uid" />
                                    <field name="write_date" />
                                    <field name="write_uid" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
