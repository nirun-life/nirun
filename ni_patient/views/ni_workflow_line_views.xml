<odoo>
    <record id="ni_workflow_line_action" model="ir.actions.act_window">
        <field name="name">Timeline</field>
        <field name="res_model">ni.workflow.line</field>
        <field name="view_mode">kanban,tree</field>
        <field name="context">{'search_default_group_by_occurrence': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">No Timeline</p>
            <p>You may try to remove some filter</p>
        </field>
    </record>
    <record id="ni_workflow_line_view_search" model="ir.ui.view">
        <field name="name">ni.workflow.line.view.search</field>
        <field name="model">ni.workflow.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="patient_id" />
                <field name="encounter_id" />
                <separator />
                <filter name="occurrence" string="Date" date="occurrence" />
                <separator />
                <filter
                    name="ongoing"
                    string="Ongoing"
                    domain="[('state', 'in', ['preparation', 'draft', 'in-progress', 'active', 'on-hold', 'suspended'])]"
                />
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]" />
                <filter
                    name="cancelled"
                    string="Cancelled"
                    domain="[('state', 'in', ['not-done', 'abort', 'revoked'])]"
                />
                <separator />
                <filter name="event" string="Event" domain="[('type', '=', 'event')]" />
                <filter name="request" string="Request" domain="[('type', '=', 'request')]" />
                <group name="Group by">
                    <filter name="group_by_type" string="Type" context="{'group_by': 'type'}" />
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}" />
                    <separator />
                    <filter name="group_by_patient" string="Patient" context="{'group_by': 'patient_id'}" />
                    <filter name="group_by_encounter" string="Encounter" context="{'group_by': 'encounter_id'}" />
                    <separator />
                    <filter name="group_by_occurrence" string="Date" context="{'group_by': 'occurrence'}" />
                </group>
                <searchpanel>
                    <field name="company_id" icon="fa-building" enable_counters="1" groups="base.group_multi_company" />
                    <field name="type" icon="fa-tag" enable_counters="1" />
                    <field name="state" icon="fa-circle" enable_counters="1" />
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="ni_workflow_line_view_kanban" model="ir.ui.view">
        <field name="name">ni.workflow.line.view.kanban</field>
        <field name="model">ni.workflow.line</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" records_draggable="0" quick_create="0" group_create="0">
                <field name="type" />
                <field name="state" />
                <field name="occurrence" />
                <field name="patient_id" />
                <field name="encounter_id" />
                <field name="name" />
                <field name="summary" />
                <field name="res_model" />
                <field name="res_id" />
                <field name="create_uid" />
                <progressbar
                    field="state"
                    colors='{"completed": "success", "in-progress": "info", "active": "info", "not-done": "danger", "abort": "danger", "revoked": "danger"}'
                />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                    <span class="o_kanban_record_subtitle small">
                                        <field class='text-danger' name="res_model" groups="base.group_no_one" />
                                    </span>
                                    <span class="o_kanban_record_subtitle text-muted small">
                                        <i class="fa fa-clock-o me-1" />
                                        <field name="occurrence" widget="datetime" />
                                    </span>
                                </div>
                                <div>
                                    <span
                                        t-attf-class="badge rounded-pill {{ record.type.raw_value == 'event' ? 'text-bg-primary' : 'text-bg-info' }}"
                                    >
                                        <field name="type" />
                                    </span>
                                </div>
                            </div>
                            <div class="oe_kanban_details mt-2">
                                <span
                                    t-if="record.summary.raw_value"
                                    class="text-muted small"
                                    t-esc="record.summary.raw_value"
                                />
                                <div t-if="!context['default_patient_id']" class="mt-1 small">
                                    <field name="patient_id" />
                                    <field
                                        class="ms-4"
                                        name="encounter_id"
                                        invisible="context.get('default_encounter_id')"
                                    />
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <span
                                        t-attf-class="badge {{ record.state.raw_value == 'completed' ? 'text-bg-success' : record.state.raw_value in ['not-done','abort','revoked'] ? 'text-bg-secondary' : record.state.raw_value in ['suspended','on-hold'] ? 'text-bg-warning' : record.state.raw_value in ['in-progress','active'] ? 'text-bg-info' : 'text-bg-light' }}"
                                    >
                                        <field name="state" />
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="create_uid" widget="many2one_avatar_user" />
                                    <button
                                        name="action_resource"
                                        type="object"
                                        class="btn btn-sm btn-link p-0 ms-1"
                                        icon="fa-external-link"
                                        title="Open"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ni_workflow_line_view_tree" model="ir.ui.view">
        <field name="name">ni.workflow.line.view.tree</field>
        <field name="model">ni.workflow.line</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field
                    name="company_id"
                    invisible="context.get('default_patient_id')"
                    groups="base.group_multi_company"
                    optional="show"
                />
                <field name="occurrence" />
                <field
                    name="patient_id"
                    invisible="context.get('default_patient_id')"
                    widget="many2one_avatar"
                    optional="show"
                />
                <field name="encounter_id" invisible="context.get('default_encounter_id')" optional="show" />
                <field
                    name="type"
                    widget="badge"
                    decoration-info="type == 'request'"
                    decoration-primary="type == 'event'"
                />
                <field name="name" optional="show" />
                <field name="summary" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'completed'"
                    decoration-muted="state in ('not-done', 'abort', 'revoked')"
                    decoration-warning="state in ('suspended', 'on-hold')"
                    decoration-info="state in ('in-progress', 'active')"
                />
                <field name="create_uid" widget="many2one_avatar_user" optional="hide" />
                <field name="create_date" optional="hide" />
                <button name="action_resource" class="text-primary" type="object" icon="fa-external-link" />
            </tree>
        </field>
    </record>
</odoo>
