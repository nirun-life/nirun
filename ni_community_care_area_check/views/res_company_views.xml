<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_attendance_area" model="ir.ui.view">
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="การตรวจสอบพื้นที่เช็คอิน" name="attendance_area_check">
                    <group string="บริการ Reverse Geocoding">
                        <field name="attendance_geocode_service" widget="radio" />
                        <field
                            name="attendance_longdo_api_key"
                            attrs="{'invisible': [('attendance_geocode_service', '!=', 'longdo')],
                                    'required': [('attendance_geocode_service', '=', 'longdo')]}"
                            placeholder="ใส่ Longdo API Key ที่นี่"
                        />
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
