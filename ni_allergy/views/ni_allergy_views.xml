<odoo>
    <record id="ni_allergy_action" model="ir.actions.act_window">
        <field name="name">Allergy / Intolerance</field>
        <field name="res_model">ni.allergy</field>
        <field name="view_mode">list,form,graph,pivot</field>
    </record>
    <record id="ni_allergy_view_search" model="ir.ui.view">
        <field name="name">ni.allergy.view.search</field>
        <field name="model">ni.allergy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field
                    name="patient_id"
                    invisible="context.get('default_patient_id')"
                />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    domain="[('state', '=', 'active')]"
                />
                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('state', '=', 'inactive')]"
                />
                <filter
                    name="resolved"
                    string="Resolved"
                    domain="[('state', '=', 'resolved')]"
                />
                <separator />
                <filter
                    name="criticality_high"
                    string="High"
                    domain="[('criticality', '=', 'high')]"
                />
                <filter
                    name="criticality_low"
                    string="Low"
                    domain="[('criticality', '=', 'low')]"
                />
                <filter
                    name="criticality_unable_to_assess"
                    string="Unable to Access"
                    domain="[('criticality', '=', 'unable-to-assess')]"
                />
                <group>
                    <filter
                        name="group_by_patient"
                        string="Patient"
                        context="{'group_by': 'patient_id'}"
                    />
                    <filter
                        name="group_by_code"
                        string="Allergy / Intolerance"
                        context="{'group_by': 'code_id'}"
                    />
                </group>
                <searchpanel>
                    <field name="category" enable_counters="1" />
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="ni_allergy_view_tree" model="ir.ui.view">
        <field name="name">ni.allergy.view.list</field>
        <field name="model">ni.allergy</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ['inactive','resolved']">
                <field name="company_id" column_invisible="1" />
                <field name="patient_id" column_invisible="1" />
                <field name="encounter_id" column_invisible="1" />
                <field name="sequence" widget="handle" />
                <field name="type" optional="hide" />
                <field name="category" optional="hide" />
                <field name="name" />
                <field
                    name="criticality"
                    optional="show"
                    widget="badge"
                    decoration-info="criticality == 'low'"
                    decoration-danger="criticality == 'high'"
                />
                <field
                    name="state"
                    optional="hide"
                    widget="badge"
                    decoration-info="state=='active'"
                    decoration-success="state=='resolved'"
                />
                <field name="note" optional="show" />
                <button
                    icon="fa-check"
                    name="action_resolve"
                    type="object"
                    string="Resolve"
                    class="btn-secondary"
                    invisible="state not in ('active', 'inactive')"
                />
                <control>
                    <create
                        string="Add Allergy"
                        context="{'default_state': 'active', 'default_type': 'allergy'}"
                    />
                    <create
                        string="Add Intolerance"
                        context="{'default_state': 'active', 'default_type': 'intolerance'}"
                    />
                </control>
            </list>
        </field>
    </record>
    <record id="ni_allergy_view_form" model="ir.ui.view">
        <field name="name">ni.allergy.view.form</field>
        <field name="model">ni.allergy</field>
        <field name="arch" type="xml">
            <form>
                <field name="id" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="patient_id" invisible="1" />
                <field name="encounter_id" invisible="1" />
                <field name="sequence" invisible="1" />
                <header class="oe_read_only" invisible="context.get('no_header')">
                    <button
                        name="action_active"
                        string="Active"
                        invisible="state != 'resolved'"
                        type="object"
                    />
                    <button
                        name="action_resolve"
                        string="Resolve"
                        invisible="state != 'active'"
                        type="object"
                    />
                    <field
                        name="state"
                        statusbar_visible="active,resolved"
                        widget="statusbar"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        bg_color="bg-success"
                        title="Inactive"
                        invisible="state != 'inactive'"
                    />
                    <widget
                        name="web_ribbon"
                        bg_color="bg-success"
                        title="Resolved"
                        invisible="state != 'resolved'"
                    />
                    <group>
                        <field
                            name="category"
                            widget="radio"
                            options="{'horizontal': True}"
                        />
                        <label for="name" />
                        <div>
                            <field
                                name="code_id"
                                placeholder="Search Substance/Product..."
                                class="w-100"
                                options="{'no_open': True}"
                                domain="[('category', '=', category)]"
                                context="{'default_category': category}"
                            />
                            <field
                                name="name"
                                string="Substance"
                                placeholder="Type Substance/Product name"
                            />
                        </div>
                    </group>
                    <group>
                        <group>
                            <field
                                name="criticality"
                                widget="radio"
                                options="{'horizontal': True}"
                            />
                        </group>
                        <group>
                            <field
                                name="type"
                                widget="radio"
                                options="{'horizontal': True}"
                                invisible="category not in ['food', 'medication']"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page name="note" string="Note" icon="fa-pencil-square-o">
                            <field name="note" placeholder="Additional note..." />
                        </page>
                        <page
                            name="reaction"
                            string="Reaction Event"
                            icon="fa-life-ring"
                            badge="reaction_count"
                        >
                            <group invisible="not reaction_ids">
                                <field name="last_occurrence" />
                            </group>
                            <field name="reaction_count" invisible="1" />
                            <field
                                name="reaction_ids"
                                context="{'default_allergy_id': id}"
                                mode="list"
                            >
                                <list editable="top">
                                    <field name="onset" width="1" />
                                    <field
                                        name="description"
                                        placeholder="Description of the event as a whole"
                                    />
                                    <field name="severity" optional="show" />
                                    <field name="note" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page string="Extra Info" groups="base.group_no_one">
                            <group>
                                <group>
                                    <field name="create_date" />
                                    <field name="create_uid" />
                                    <field name="write_date" />
                                    <field name="write_uid" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_allergy_view_kanban" model="ir.ui.view">
        <field name="name">ni.allergy.view.kanban</field>
        <field name="model">ni.allergy</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <span class="small">
                                <field t-if="record.type.value" name="type" />
                                <t t-else="">Allergy</t>
                            </span>
                            <field
                                name="category"
                                widget="badge"
                                decoration-info="category=='biologic'"
                                decoration-danger="category=='medication'"
                                decoration-warning="category=='food'"
                                decoration-success="category=='environment'"
                            />
                        </div>
                        <field class="h4" name="name" />
                        <div>
                            <span class="small text-muted me-2">Criticality :</span>
                            <field
                                t-if="record.criticality.value"
                                name="criticality"
                                widget="badge"
                                decoration-info="criticality=='low'"
                                decoration-danger="criticality=='high'"
                            />
                            <span t-else="" class="text-muted">N/A</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="condition_view_pivot" model="ir.ui.view">
        <field name="name">condition.view.pivot</field>
        <field name="model">ni.allergy</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="category" type="row" />
            </pivot>
        </field>
    </record>
    <record id="condition_view_graph" model="ir.ui.view">
        <field name="name">condition.view.graph</field>
        <field name="model">ni.allergy</field>
        <field name="arch" type="xml">
            <graph>
                <field name="category" type="col" />
            </graph>
        </field>
    </record>
</odoo>
