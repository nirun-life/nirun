<kanban>
    <field name="color" />
    <field name="name" />
    <field name="code" />
    <field name="abbr" />
    <templates>
        <t t-name="kanban-box">
            <div t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                <div class="oe_kanban_content">
                    <strong class="o_kanban_record_title">
                        <field name="name" />
                    </strong>
                    <div class="mt-1">
                        <t t-if="record.code.value">
                            <field class="oe_inline me-2" name="code" widget="badge" decoration-primary="1" />
                        </t>
                        <t t-if="record.abbr.value">
                            <span class="text-muted">
                                <t t-esc="record.abbr.value" />
                            </span>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </templates>
</kanban>
