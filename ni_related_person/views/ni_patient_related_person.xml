<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ni_patient_related_person_view_search" model="ir.ui.view">
        <field name="name">ni.patient.related.person.view.search</field>
        <field name="model">ni.patient.related.person</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>
    <record id="ni_patient_related_person_view_tree" model="ir.ui.view">
        <field name="name">ni.patient.related.person.view.list</field>
        <field name="model">ni.patient.related.person</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="display_age" optional="show" />
                <field name="phone" widget="phone" optional="show" />
                <field name="mobile" widget="phone" optional="show" />
                <field name="email" widget="email" optional="show" />
                <field
                    name="relationship_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="ni_patient_related_person_view_form" model="ir.ui.view">
        <field name="name">ni.patient.related.person.view.form</field>
        <field name="model">ni.patient.related.person</field>
        <field name="arch" type="xml">
            <form string="">
                <field name="patient_id" invisible="1" />
                <sheet>
                    <field
                        name="image_1920"
                        class="oe_avatar"
                        options="{&quot;preview_image&quot;:&quot;image_128&quot;}"
                        widget="image"
                    />
                    <field
                        name="input"
                        widget="radio"
                        options="{'horizontal': True}"
                        invisible="id"
                    />
                    <div class="oe_title mb24">
                        <label for="name" />
                        <h1>
                            <div class="row gx-2" invisible="input != 'new'">
                                <div class="col-12 col-lg-3">
                                    <field
                                        name="title_id"
                                        class="h2 h-100"
                                        placeholder="Title"
                                        options="{'no_create': True, 'no_open':True}"
                                    />
                                </div>
                                <div class="col-12 col-lg-9">
                                    <field
                                        name="name"
                                        placeholder="Name"
                                        invisible="input != 'new'"
                                        required="input == 'new'"
                                    />
                                </div>
                            </div>
                            <field
                                name="partner_id"
                                class="w-100"
                                placeholder="Search person in database..."
                                options="{'no_create': True, 'no_open':True}"
                                invisible="input != 'search'"
                                required="input == 'search'"
                            />
                        </h1>
                        <div class="mt-2" invisible="not id">
                            <label for="partner_id" class="me-4" />
                            <field
                                name="partner_id"
                                readonly="1"
                                groups="base.group_no_one"
                                required="input == 'search'"
                            />
                        </div>
                        <div class="mt-2">
                            <label for="gender" class="me-4" />
                            <field
                                name="gender"
                                widget="radio"
                                options="{'horizontal': True}"
                            />
                        </div>
                    </div>
                    <group>
                        <field
                            name="relationship_ids"
                            widget="many2many_tags"
                            options="{'color_field': 'color'}"
                        />
                    </group>
                    <group class="mt-2">
                        <group>
                            <field name="vat" string="Identification No" />
                            <field name="religion_id" />
                            <field name="birthdate" />
                            <field name="age" />
                        </group>
                        <group>
                            <field name="phone" />
                            <field name="mobile" />
                            <field name="email" />
                        </group>
                    </group>
                    <group string="Address">
                        <label name="address_name" for="street" string="Address" />
                        <div class="o_address_format">
                            <field
                                name="street"
                                class="o_address_street"
                                placeholder="Street..."
                            />
                            <field
                                name="street2"
                                class="o_address_street"
                                placeholder="Street 2..."
                            />
                            <field
                                name="city"
                                class="o_address_city"
                                placeholder="City"
                            />
                            <field
                                name="state_id"
                                class="o_address_state"
                                context="{'country_id': country_id, 'zip': zip}"
                                options="{&quot;no_open&quot;: True}"
                                placeholder="State"
                            />
                            <field name="zip" class="o_address_zip" placeholder="ZIP" />
                            <field
                                name="country_id"
                                class="o_address_country"
                                options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                                placeholder="Country"
                            />
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_patient_related_person_view_kanban" model="ir.ui.view">
        <field name="name">ni.patient.related.person.view.kanban</field>
        <field name="model">ni.patient.related.person</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="image_128" />
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field
                                name="image_1024"
                                class="o_kanban_image_fill w-100"
                                widget="image"
                                options="{'img_class': 'object-fit-cover', 'preview_image': 'image_128', 'zoom': true, 'zoom_delay': 1000}"
                            />
                        </aside>
                        <main class="ps-2 ps-md-0">
                            <field name="name" class="fw-bolder" />
                            <field name="vat" class="small text-muted" />
                            <field
                                name="relationship_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                            />
                            <div t-if="record.phone.raw_value" class="mt-2">
                                <i
                                    class="fa fa-phone me-2"
                                    aria-hidden="true"
                                    title="phone"
                                />
                                <field name="phone" />
                            </div>
                            <div t-if="record.mobile.raw_value">
                                <i
                                    class="fa fa-mobile me-2"
                                    aria-hidden="true"
                                    title="mobile"
                                />
                                <field name="mobile" />
                            </div>
                            <div t-if="record.email.raw_value" class="text-truncate">
                                <i
                                    class="fa fa-envelope me-2"
                                    aria-hidden="true"
                                    title="email"
                                />
                                <field name="email" widget="email" />
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
