<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- เพิ่ม filter พนักงานในพื้นที่รับผิดชอบ -->
    <record id="hr_holidays_filter_inherit_area" model="ir.ui.view">
        <field name="name">hr.holidays.filter.inherit.area</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter" />
        <field name="arch" type="xml">
            <filter name="department" position="after">
                <filter
                    string="พนักงานในพื้นที่รับผิดชอบ"
                    name="my_area_employees"
                    domain="[('employee_id.my_user_city_match','=',True)]"
                    groups="ni_patient.group_manager"
                />
            </filter>
        </field>
    </record>
    <record id="hr_leave_allocation_filter_inherit_area" model="ir.ui.view">
        <field name="name">hr.holidays.filter_allocations.inherit.area</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_leave_allocation_filter" />
        <field name="arch" type="xml">
            <filter name="my_team_leaves" position="after">
                <filter
                    string="พนักงานในพื้นที่รับผิดชอบ"
                    name="my_area_employees"
                    domain="[('employee_id.my_user_city_match','=',True)]"
                    groups="ni_patient.group_manager"
                />
            </filter>
        </field>
    </record>
    <record id="hr_leave_report_calendar_view_search_inherit_area" model="ir.ui.view">
        <field name="name">hr.leave.report.calendar.view.search.inherit.area</field>
        <field name="model">hr.leave.report.calendar</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_report_calendar_view_search" />
        <field name="arch" type="xml">
            <filter name="department" position="after">
                <filter
                    string="พนักงานในพื้นที่รับผิดชอบ"
                    name="my_area_employees"
                    domain="[('employee_id.my_user_city_match','=',True)]"
                    groups="ni_patient.group_manager"
                />
            </filter>
        </field>
    </record>
    <record id="view_hr_holidays_filter_report_inherit_area" model="ir.ui.view">
        <field name="name">hr.holidays.filter.inherit.area</field>
        <field name="model">hr.leave.report</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter_report" />
        <field name="arch" type="xml">
            <filter name="department" position="after">
                <filter
                    string="พนักงานในพื้นที่รับผิดชอบ"
                    name="my_area_employees"
                    domain="[('employee_id.my_user_city_match','=',True)]"
                    groups="ni_patient.group_manager"
                />
            </filter>
        </field>
    </record>
    <!-- ปรับ action ให้มี filter พนักงานในพื้นที่รับผิดชอบ -->
    <record id="hr_holidays.action_hr_holidays_dashboard" model="ir.actions.act_window">
        <field name="context" eval="{'hide_employee_name': 1, 'search_default_my_area_employees': 1}" />
    </record>
    <record id="hr_holidays.hr_leave_action_action_approve_department" model="ir.actions.act_window">
        <field
            name="context"
            eval="{'search_default_approve': 1, 'search_default_my_area_employees': 1, 'search_default_active_employee': 1, 'search_default_active_time_off': 1, 'hide_employee_name': 1, 'holiday_status_name_get': False}"
        />
    </record>
    <record id="hr_holidays.hr_leave_allocation_action_approve_department" model="ir.actions.act_window">
        <field
            name="context"
            eval="{'search_default_my_area_employees': 1,'search_default_approve': 2, 'search_default_active_employee': 3}"
        />
    </record>
    <record id="hr_holidays.action_hr_available_holidays_report" model="ir.actions.act_window">
        <field
            name="context"
            eval="{'search_default_year': 1, 'search_default_active_employee': 2, 'search_default_group_employee': 1, 'search_default_group_type': 1, 'search_default_my_area_employees': 1}"
        />
    </record>
</odoo>
