<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <!-- menu action -->
    <record id="action_hr_leave_all" model="ir.actions.act_window">
        <field name="name">การลาทั้งหมด</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('employee_id.my_area', '=', True), ('active_employee', '=', True)]</field>
        <field name="context" eval="{'hide_employee_name': 1, 'holiday_status_name_get': False}" />
    </record>
    <record id="action_hr_leave_waiting_approve" model="ir.actions.act_window">
        <field name="name">การลาที่รออนุมัติ</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('employee_id.my_area', '=', True), ('active_employee', '=', True)]</field>
        <field
            name="context"
            eval="{
            'hide_employee_name': 1,
            'holiday_status_name_get': False,
            'search_default_state_confirm': 1
        }"
        />
    </record>
    <record id="action_hr_leave_approved" model="ir.actions.act_window">
        <field name="name">การลาที่อนุมัติแล้ว</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('employee_id.my_area', '=', True), ('active_employee', '=', True)]</field>
        <field
            name="context"
            eval="{
            'hide_employee_name': 1,
            'holiday_status_name_get': False,
            'search_default_state_validate': 1
        }"
        />
    </record>
    <!-- custom ui -->
    <record id="hr_leave_view_form_manager_hide_stats" model="ir.ui.view">
        <field name="name">hr.leave.view.form.manager.hide.stats</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager" />
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='hr_leave_stats']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="hr_leave_view_form_inherit_remaining" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.remaining</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="requires_allocation" invisible="1" />
                <field
                    name="virtual_remaining_leaves"
                    string="วันลาคงเหลือ"
                    readonly="1"
                    attrs="{'invisible': ['|',('holiday_status_id','=',False),('requires_allocation', '=', 'no')]}"
                />
            </xpath>
        </field>
    </record>
    <!-- search filter by state -->
    <record id="hr_holidays_filter_inherit_area" model="ir.ui.view">
        <field name="name">hr.holidays.filter.inherit.area</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter" />
        <field name="arch" type="xml">
            <filter name="department" position="after">
                <filter name="state_confirm" string="รออนุมัติ" domain="[('state','in',['confirm','validate1'])]" />
                <filter name="state_validate" string="อนุมัติแล้ว" domain="[('state','=','validate')]" />
            </filter>
        </field>
    </record>
    <!-- domain ผู้บริบาลในพื้นที่รับผิดชอบ -->
    <record id="hr_holidays.action_hr_holidays_dashboard" model="ir.actions.act_window">
        <field name="context" eval="{'hide_employee_name': 1}" />
        <field name="domain">[('employee_id.my_area', '=', True)]</field>
    </record>
    <record id="hr_holidays.hr_leave_action_action_approve_department" model="ir.actions.act_window">
        <field name="context" eval="{'hide_employee_name': 1, 'holiday_status_name_get': False}" />
        <field name="domain">[('employee_id.my_area', '=', True), ('active_employee', '=', True)]</field>
    </record>
    <record id="hr_holidays.hr_leave_allocation_action_approve_department" model="ir.actions.act_window">
        <field name="context" eval="{}" />
        <field name="domain">[('employee_id.my_area', '=', True), ('active_employee', '=', True)]</field>
    </record>
    <record id="hr_holidays.action_hr_available_holidays_report" model="ir.actions.act_window">
        <field
            name="context"
            eval="{'search_default_year': 1, 'search_default_group_employee': 1, 'search_default_group_type': 1}"
        />
        <field name="domain">[('employee_id.my_area', '=', True), ('active_employee', '=', True)]</field>
    </record>
</odoo>
