<odoo>
    <record id="ni_service_event_approval_view_form_inherit_attendance" model="ir.ui.view">
        <field name="name">ni.service.event.approval.form.inherit.attendance</field>
        <field name="model">ni.service.event.approval</field>
        <field name="inherit_id" ref="ni_community_care.ni_service_event_approval_view_form" />
        <!-- ชี้ไปยัง form view ต้นทาง -->
        <field name="arch" type="xml">
            <xpath expr="//page[@name='patient_ids']" position="before">
                <page name="attendance_days" string="การเข้างาน" icon="fa-list-alt" badge="attendance_days_count">
                    <group>
                        <group>
                            <field name="attendance_days" string="จำนวนวันที่เข้างาน" readonly="1" />
                            <field
                                name="attendance_hours_total"
                                string="จำนวนชั่วโมงทั้งหมด"
                                widget="float_time"
                                readonly="1"
                            />
                            <field
                                name="attendance_hours_avg"
                                string="ชั่วโมงเฉลี่ยต่อวัน"
                                widget="float_time"
                                readonly="1"
                            />
                        </group>
                        <div class="text-end">
                            <button
                                name="action_view_attendance"
                                string="ดูรายละเอียดการเข้างาน"
                                type="object"
                                class="btn-outline-primary"
                                icon="fa-search"
                            />
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
