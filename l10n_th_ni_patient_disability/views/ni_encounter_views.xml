<odoo>
    <!-- Encounter search: add disability filter -->
    <record id="ni_encounter_view_search_disability" model="ir.ui.view">
        <field name="name">ni.encounter.view.search.disability</field>
        <field name="model">ni.encounter</field>
        <field name="inherit_id" ref="ni_patient.ni_encounter_view_search" />
        <field name="arch" type="xml">
            <filter name="routine" position="before">
                <filter
                    name="patient_has_disability"
                    string="Patient has Disability"
                    domain="[('patient_id.has_disability', '=', True)]"
                />
                <separator />
            </filter>
        </field>
    </record>
</odoo>
