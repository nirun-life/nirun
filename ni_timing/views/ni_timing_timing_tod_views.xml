<odoo>
    <record id="ni_timing_timing_tod_view_form" model="ir.ui.view">
        <field name="name">ni.timing.timing.tod.view.form</field>
        <field name="model">ni.timing.timing.tod</field>
        <field name="arch" type="xml">
            <form string="">
                <field name="name" invisible="1" />
                <sheet>
                    <group>
                        <group>
                            <field name="all_day" />
                            <field
                                name="start_time"
                                attrs="{'invisible': [('all_day', '=', True)]}"
                                widget="float_time"
                            />
                            <field
                                name="end_time"
                                attrs="{'invisible': [('all_day', '=', True)]}"
                                widget="float_time"
                            />
                            <field name="tz" attrs="{'invisible': [('all_day', '=', True)]}" />
                        </group>
                        <group>
                            <field name="code_id" placeholder="Choose form..." />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ni_timing_timing_tod_view_tree" model="ir.ui.view">
        <field name="name">ni.timing.timing.tod.view.tree</field>
        <field name="model">ni.timing.timing.tod</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="time" />
                <field name="all_day" width="1" optional="hide" />
                <field
                    name="start_time"
                    width="2"
                    widget="float_time"
                    optional="hide"
                    attrs="{'invisible': [('all_day', '=', True)]}"
                />
                <field
                    name="end_time"
                    width="2"
                    widget="float_time"
                    optional="hide"
                    attrs="{'invisible': [('all_day', '=', True)]}"
                />
                <field name="tz" width="2" optional="hide" attrs="{'invisible': [('all_day', '=', True)]}" />
            </tree>
        </field>
    </record>
    <record id="ni_timing_timing_tod_view_kanban" model="ir.ui.view">
        <field name="name">ni.timing.timing.tod.view.kanban</field>
        <field name="model">ni.timing.timing.tod</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="color" widget="color_picker" />
                <field name="all_day" invisible="1" />
                <field name="start_time" invisible="1" />
                <field name="end_time" invisible="1" />
                <field name="tz" invisible="1" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''} oe_kanban_global_click"
                        >
                            <!-- Dropdown เมนูสำหรับ Edit -->
                            <div class="o_dropdown_kanban dropdown" t-if="widget.editable">
                                <a
                                    class="dropdown-toggle o-no-caret btn"
                                    data-toggle="dropdown"
                                    href="#"
                                    role="button"
                                    aria-label="Dropdown menu"
                                    title="Dropdown menu"
                                >
                                    <span class="fa fa-ellipsis-v" />
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable">
                                        <a class="dropdown-item" role="menuitem" type="edit">Edit</a>
                                    </t>
                                    <ul class="oe_kanban_colorpicker" data-field="color" />
                                </div>
                            </div>
                            <!-- แสดงข้อมูลหลัก -->
                            <div class="o_kanban_content">
                                <strong>
                                    <field name="name" />
                                </strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
